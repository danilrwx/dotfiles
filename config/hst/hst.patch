+/* All drawing coordinates are buffer pixels; Wayland damage is logical. */
+static void
+damage(int x, int y, int width, int height)
+{
+    wl_surface_damage(wl.surface, x / wl.scale, y / wl.scale,
+        (x + width + wl.scale - 1) / wl.scale - x / wl.scale,
+        (y + height + wl.scale - 1) / wl.scale - y / wl.scale);
+}
+
+static void
+surfscale(void *data, struct wl_surface *surface, int32_t scale)
+{
+    if (scale < 1 || scale == wl.scale)
+        return;
+
+    int width = win.w / wl.scale * scale;
+    int height = win.h / wl.scale * scale;
+    double size = usedfontsize / wl.scale * scale;
+    double defaultsize = defaultfontsize / wl.scale * scale;
+    borderpx = borderpx / wl.scale * scale;
+    wl.scale = scale;
+    wl_surface_set_buffer_scale(surface, scale);
+    wlunloadfonts();
+    wlloadfonts(usedfont, size);
+    defaultfontsize = defaultsize;
+    cresize(width, height);
+    wl.needdraw = true;
+}
+
+static void
+surftransform(void *data, struct wl_surface *surface, uint32_t transform)
+{
+    /* Normal buffer orientation is valid regardless of the preference. */
+}
