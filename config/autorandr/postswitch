#!/bin/sh
# autorandr's hook after each switch (the profiles here, docked and laptop; its udev rule runs it on a plug
# or an unplug, bspwmrc at the start): bspwm's desktops 6-10 on the second monitor while there is one, all
# back on the laptop's otherwise, with their windows; then the theme again for the root and polybar on the
# new layout. Linked to ~/.config/autorandr by install.
prim=$(xrandr --query | awk '/ connected primary/ { print $1 }')
ext=$(xrandr --listactivemonitors | awk 'NR > 1 { print $4 }' | grep -vx "$prim" | head -1)
if [ -n "$ext" ]; then
	for d in 6 7 8 9 10; do bspc desktop "$d" -m "$ext" 2> /dev/null; done
else
	for m in $(bspc query -M --names | grep -vx "$prim"); do
		for d in $(bspc query -D -m "$m"); do bspc desktop "$d" -m "$prim"; done
		bspc monitor "$m" -r
	done
fi
# the desktop bspwm makes for a new monitor, "Desktop", gone
for d in $(bspc query -D --names | grep -vx '[0-9]*'); do bspc desktop "$d" -r; done
"$HOME/dotfiles/bin/theme" "$(basename "$(readlink "${XDG_STATE_HOME:-$HOME/.local/state}/theme/theme.toml")" .toml)"
