# sway, the Wayland session next to i3 (tuigreet offers both), config/i3/config carried over: the same keys and
# rules, with what sway sets itself, the panel's 2x, the keyboard, the touchpad, idle and lock. bin/wl-autostart
# starts the daemons. Linked to ~/.config/sway by install.

set $mod Mod4

set $left  h
set $down  j
set $up    k
set $right l

# base ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
set $bg       #000000
set $fg       #ffffff
set $accent   #00cd00
set $darkgray #888888

# alacritty (config/alacritty)
set $term alacritty
# dmenu-like launcher (rofi) in the bar's colour, PATH fixed up for ~/.local/bin (bin/wm-menu)
set $menu $HOME/dotfiles/bin/wm-menu
set $lock swaylock -f -c 000000

font pango:Iosevka 11

# the panel at 2x, black under everything (bin/theme sets a wallpaper over it)
output * scale 2
output * bg #000000 solid_color

# us and ru, Ctrl+Space between them (Caps as Ctrl is etc/udev/hwdb.d, below the keymap)
input type:keyboard {
  xkb_layout us,ru
  xkb_options grp:ctrl_space_toggle
}
# the touchpad as /etc/X11/xorg.conf.d/30-touchpad.conf has it under i3: no tap, natural scrolling, a click by
# the fingers down, off while typing; X's ScrollPixelDistance 50 is libinput's 15 at 0.3
input type:touchpad {
  tap disabled
  natural_scroll enabled
  click_method clickfinger
  dwt enabled
  pointer_accel -0.25
  scroll_factor 0.3
}

# autostart ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# once per session: notifications, polkit, idle/lock, the bar
exec $HOME/dotfiles/bin/wl-autostart

default_border pixel 1
smart_borders  on

# keys ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# levels as a dunst progress card, mute and the HONOR Fn keys as a card (bin/wm-fnkeys)
set $fn $HOME/dotfiles/bin/wm-fnkeys
bindsym XF86AudioRaiseVolume      exec $fn vol-up
bindsym XF86AudioLowerVolume      exec $fn vol-down
bindsym XF86AudioMute             exec $fn vol-mute

bindsym $mod+XF86AudioRaiseVolume exec $fn mic-up
bindsym $mod+XF86AudioLowerVolume exec $fn mic-down
bindsym $mod+Shift+m              exec $fn mic
bindsym XF86AudioMicMute          exec $fn mic

bindsym XF86MonBrightnessDown     exec $fn bright-down
bindsym XF86MonBrightnessUp       exec $fn bright-up

# HONOR Fn keys (patch/hotkeys of the HONOR fork maps them)
bindsym XF86TouchpadOn            exec $fn touchpad-on
bindsym XF86TouchpadOff           exec $fn touchpad-off
bindsym XF86TouchpadToggle        exec $fn touchpad-toggle
bindsym XF86Launch1               exec $fn profile
bindsym XF86CameraAccessToggle    exec $fn camera
bindsym Print                     exec $HOME/dotfiles/bin/screenshot-select

bindsym XF86AudioPlay             exec playerctl play-pause
bindsym XF86AudioNext             exec playerctl next
bindsym XF86AudioPrev             exec playerctl previous

bindsym $mod+Shift+s exec $HOME/dotfiles/bin/screenshot-select
bindsym $mod+d       exec $menu
bindsym $mod+Shift+x exec $lock
# Wi-Fi, Bluetooth, sound output and input, power profile: a menu pick (bin/wm-ctl)
bindsym $mod+x       exec $HOME/dotfiles/bin/wm-ctl

bindsym Control+Mod1+s exec $HOME/dotfiles/bin/sys-notify
bindsym Control+Mod1+c exec $HOME/dotfiles/bin/cal-notify
bindsym $mod+n         exec dunstctl close
bindsym $mod+Shift+n   exec dunstctl close-all

floating_modifier $mod

bindsym $mod+Return exec $term

bindsym $mod+Shift+q kill

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+v split v
bindsym $mod+c split h

# the bar, shown and hidden
bindsym $mod+b bar mode toggle

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle

bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent

set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+Tab workspace back_and_forth

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway? This ends the session.' -B 'Yes, exit sway' 'swaymsg exit'

mode "resize" {
  bindsym $left  resize shrink width  5 px or 5 ppt
  bindsym $down  resize grow   height 5 px or 5 ppt
  bindsym $up    resize shrink height 5 px or 5 ppt
  bindsym $right resize grow   width  5 px or 5 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# window rules ────────────────────────────────────────────
# class for what runs under Xwayland, app_id for the native ones
for_window [class="steam"]                  floating enable
for_window [class="steam" title="^Steam$"]  floating disable
for_window [class="(?i).*telegram.*"]       floating enable, border none
for_window [app_id="(?i).*telegram.*"]      floating enable, border none
for_window [title="^SSH Askpass$"]          floating enable
for_window [app_id="wm-ctl"]                floating enable, resize set 60 ppt 70 ppt, move position center


client.focused                 $bg        $bg       $fg            $accent      $accent
client.focused_inactive        $bg        $bg       $darkgray      $bg          $bg
client.unfocused               $bg        $bg       $darkgray      $bg          $bg
client.urgent                  $accent    $bg       $accent        $accent      $accent


# a stand-in until the Quickshell bar: the workspaces and the tray (StatusNotifierItem, Discord's menu)
bar {
  position top
  font pango:Iosevka 11
  tray_padding 5
  status_command while date +'%d/%m/%Y %H:%M'; do sleep 30; done
  colors {
    background $bg
    statusline $darkgray
    focused_workspace  $bg $bg $fg
    inactive_workspace $bg $bg $darkgray
    active_workspace   $bg $bg $darkgray
    urgent_workspace   $bg $bg $accent
  }
}
