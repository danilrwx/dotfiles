# sway, ported from the old i3 config (git 7ab1a94^:config/i3/config).
# Runs next to GNOME: the sway package drops a session into GDM's gear.

set $mod Mod4

set $left  h
set $down  j
set $up    k
set $right l

# base ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
set $bg       #000000
set $fg       #ffffff
set $accent   #00cd00
set $darkgray #7f849c

# foot: one server process (bin/sway-autostart), every window a footclient
set $term footclient
# dmenu-like launcher with the old dmenu colours, PATH fixed up for snaps and ~/.local/bin (bin/sway-menu)
set $menu $HOME/dotfiles/bin/sway-menu
set $lock swaylock -f -c 000000

font pango:Iosevka NF 12

# input ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────
input type:keyboard {
  xkb_layout  us,ru
  # Caps Lock is remapped to Ctrl below the keymap, in config/hwdb (udev hwdb)
  xkb_options grp:ctrl_space_toggle,grp_led:scroll
}

input type:touchpad {
  tap            enabled
  natural_scroll enabled
  click_method   clickfinger
  dwt            enabled
  pointer_accel  -0.25
  # as the per-axis factors of wayland-scroll-factor under GNOME (~/.config/wayland-scroll-factor/config),
  # whose LD_PRELOAD loads in gnome-shell only; sway has one factor for both axes
  scroll_factor  0.15
}

# autostart ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# once per session: env for portals, notifications, polkit, tray applets, idle/lock
exec        $HOME/dotfiles/bin/sway-autostart
# plain black background, no wallpaper
output * bg #000000 solid_color

default_border pixel 1
smart_borders  on

# keys ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# levels as a wob bar, mute and the HONOR Fn keys as a mako card (bin/sway-fnkeys; wob in bin/sway-autostart)
set $fn $HOME/dotfiles/bin/sway-fnkeys
bindsym --locked XF86AudioRaiseVolume      exec $fn vol-up
bindsym --locked XF86AudioLowerVolume      exec $fn vol-down
bindsym --locked XF86AudioMute             exec $fn vol-mute

bindsym --locked $mod+XF86AudioRaiseVolume exec $fn mic-up
bindsym --locked $mod+XF86AudioLowerVolume exec $fn mic-down
bindsym          $mod+Shift+m              exec $fn mic
bindsym --locked XF86AudioMicMute          exec $fn mic

bindsym --locked XF86MonBrightnessDown     exec $fn bright-down
bindsym --locked XF86MonBrightnessUp       exec $fn bright-up

# HONOR Fn keys (patch/hotkeys of the HONOR fork maps them)
bindsym --locked XF86TouchpadOn            exec $fn touchpad-on
bindsym --locked XF86TouchpadOff           exec $fn touchpad-off
bindsym --locked XF86TouchpadToggle        exec $fn touchpad-toggle
bindsym --locked XF86Launch1               exec $fn profile
bindsym --locked XF86CameraAccessToggle    exec $fn camera
bindsym          Print                     exec $HOME/dotfiles/bin/screenshot-select

bindsym --locked XF86AudioPlay             exec playerctl play-pause
bindsym --locked XF86AudioNext             exec playerctl next
bindsym --locked XF86AudioPrev             exec playerctl previous

bindsym $mod+Shift+s exec $HOME/dotfiles/bin/screenshot-select
bindsym $mod+d       exec $menu
bindsym $mod+Shift+x exec $lock
# Wi-Fi, Bluetooth, sound: a wmenu pick, then impala, bluetui or pavucontrol (bin/sway-ctl)
bindsym $mod+x       exec $HOME/dotfiles/bin/sway-ctl

bindsym Control+Mod1+s exec $HOME/dotfiles/bin/sys-notify
bindsym Control+Mod1+c exec $HOME/dotfiles/bin/cal-notify
bindsym $mod+n         exec makoctl dismiss
bindsym $mod+Shift+n   exec makoctl dismiss --all

floating_modifier $mod

bindsym $mod+Return exec $term

bindsym $mod+Shift+q kill

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+v split v
bindsym $mod+c split h

bindsym $mod+b bar mode toggle

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle

bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent

set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+Tab workspace back_and_forth

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

mode "resize" {
  bindsym $left  resize shrink width  5 px or 5 ppt
  bindsym $down  resize grow   height 5 px or 5 ppt
  bindsym $up    resize shrink height 5 px or 5 ppt
  bindsym $right resize grow   width  5 px or 5 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# window rules: app_id for Wayland apps, class for the Xwayland ones (Steam) ────────────────────────────────────────────
for_window [app_id="firefox" title="^(Open|Save|Print|Choose).*"]     floating enable
for_window [class="steam"]                                             floating enable
for_window [class="steam" title="^Steam$"]                             floating disable
for_window [app_id="org.pulseaudio.pavucontrol"]                       floating enable, border normal
for_window [app_id="(?i).*telegram.*"]                                 floating enable, border none
for_window [title="^SSH Askpass$"]                                     floating enable
for_window [app_id="sway-ctl"]                                         floating enable, resize set 900 600


client.focused                 $bg        $bg       $fg            $accent      $accent
client.focused_inactive        $bg        $bg       $darkgray      $bg          $bg
client.unfocused               $bg        $bg       $darkgray      $bg          $bg
client.urgent                  $accent    $bg       $accent        $accent      $accent

bar {
  status_command $HOME/dotfiles/bin/swaybar-status
  tray_padding 5
  position top
  colors {
     background $bg
     statusline $fg
     #class               border  backgr. text
     focused_workspace    $bg     $bg     $fg
     inactive_workspace   $bg     $bg     $darkgray
     active_workspace     $bg     $bg     $darkgray
     urgent_workspace     $bg     $bg     $accent
  }
}

# distro snippets (Debian/Ubuntu ship the systemd/dbus env import here)
include /etc/sway/config.d/*
