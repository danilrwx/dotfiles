# Notification frame matches the 4px window borders in both themes.
[global]
    font = Terminus 12
    format = "<b>%s</b>\n%b"
    width = (300, 420)
    height = (0, 650)
    origin = top-right
    offset = (6, 30)
    padding = 8
    horizontal_padding = 8
    frame_width = 4
    frame_color = "#addf9c"
    separator_height = 2
    separator_color = frame
    background = "#000000ff"
    foreground = "#ffffff"
    notification_limit = 5
    sort = update
    idle_threshold = 120
    follow = mouse
    progress_bar = true
    progress_bar_frame_width = 1
    highlight = "#addf9c"
    mouse_left_click = close_current

[status]
    appname = x-status
    alignment = left
    format = "%b"

[clock]
    appname = x-clock
    alignment = center
    format = "<span size='x-large' weight='bold'>%s</span>\n%b"

[calendar]
    appname = x-calendar
    alignment = center
    format = "%b"

[urgency_low]
    timeout = 5
    background = "#000000ff"
    foreground = "#ffffff"
    frame_color = "#6b6b6b"

[urgency_normal]
    timeout = 20
    background = "#000000ff"
    foreground = "#ffffff"
    frame_color = "#addf9c"

[urgency_critical]
    timeout = 0
    background = "#000000ff"
    foreground = "#ffffff"
    frame_color = "#f09a9b"
