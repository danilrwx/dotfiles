# dunst under sway (over D-Bus, at the first notification): cards as the borders look, the theme's ground
# and text, a 1px frame green as a focused window's (grey for low urgency, red for critical), top right; those
# colours from dunstrc.d/theme.conf (bin/theme), these the fallback.
# bin/x-fnkeys sends volume/brightness with a value hint, drawn as the progress bar. Linked to ~/.config/dunst
# by install --desktop.
[global]
    font = Iosevka 11
    format = "<b>%s</b>\n%b"
    width = 300
    origin = top-right
    offset = (6, 30)
    padding = 8
    horizontal_padding = 8
    frame_width = 1
    frame_color = "#00cd00"
    separator_height = 2
    separator_color = frame
    background = "#000000"
    foreground = "#ffffff"
    notification_limit = 5
    sort = update
    idle_threshold = 120
    follow = mouse
    progress_bar = true
    progress_bar_frame_width = 1
    highlight = "#00cd00"
    mouse_left_click = close_current

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 20

[urgency_critical]
    timeout = 0
