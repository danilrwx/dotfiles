#!/bin/sh
set -eu

# Skip serial-only and legacy VGA consoles. Raster drivers report a width.
[ -n "$(wsconsctl -n display.width 2>/dev/null)" ] || exit 0
metrics=$(wsconsctl -n display.fontwidth display.fontheight)
set -- $metrics
size=${1:-}x${2:-}
case $size in
  8x16|12x24|16x32|32x64) ;;
  *) printf 'No Iosevka bitmap for console cells %s.\n' "$size" >&2; exit 1 ;;
esac

name=Iosevka-Console-$size
if ! wsfontload -l | awk -v name="$name" '$2 == name { found = 1 } END { exit !found }'; then
  font_tmp=$(mktemp /var/run/iosevka.XXXXXXXX)
  trap 'rm -f "$font_tmp"' 0
  gzip -dc "/usr/local/share/dotfiles/console/iosevka-$size.wsfont.gz" > "$font_tmp"
  wsfontload -e iso -w "$1" -h "$2" -N "$name" "$font_tmp"
fi
wsconsctl "display.font=$name"
