#!/bin/sh
set -eu

# Skip serial-only and legacy VGA consoles. Raster drivers report a width.
[ -n "$(wsconsctl -n display.width 2>/dev/null)" ] || exit 0
loaded_fonts=$(wsfontload -l)
font_tmp=$(mktemp -d /var/run/iosevka.XXXXXXXX)
trap 'rm -rf "$font_tmp"' 0

# The raster console accepts only its current cell dimensions.
for size in 8x16 12x24 16x32 32x64; do
  name=Iosevka-${size}
  if ! printf '%s\n' "$loaded_fonts" | awk -v name="$name" '$2 == name { found = 1 } END { exit !found }'; then
    gzip -dc "/usr/local/share/dotfiles/console/iosevka-$size.wsfont.gz" > "$font_tmp/font"
    wsfontload -e iso -w "${size%x*}" -h "${size#*x}" -N "$name" "$font_tmp/font" 2>/dev/null || continue
  fi
  result=$(wsconsctl "display.font=$name" 2>&1)
  case $result in
    display.font*) exit 0 ;;
    *) printf '%s\n' "$result" >&2; exit 1 ;;
  esac
done

printf '%s\n' 'No Iosevka bitmap matches the current wscons font dimensions.' >&2
exit 1
