<?xml version="1.0" encoding="UTF-8"?>
<!-- Openbox, the third X11 session next to i3 and dwm: the keys of dwm, no titlebars, a 2px border green
     on the focused window, nine desktops, bin/ob-bar on top (config/openbox/autostart). Openbox is
     stacking, so W-h and W-l halve the screen in place of a tiling layout. Linked to ~/.config/openbox by
     install; openbox reloads it on its reconfigure option. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement><policy>Smart</policy><center>yes</center></placement>
  <theme>
    <!-- config/openbox-theme, linked to ~/.local/share/themes/dots -->
    <name>dots</name>
    <titleLayout></titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow"><name>Iosevka</name><size>11</size></font>
    <font place="InactiveWindow"><name>Iosevka</name><size>11</size></font>
    <font place="MenuHeader"><name>Iosevka</name><size>11</size></font>
    <font place="MenuItem"><name>Iosevka</name><size>11</size></font>
    <font place="ActiveOnScreenDisplay"><name>Iosevka</name><size>11</size></font>
    <font place="InactiveOnScreenDisplay"><name>Iosevka</name><size>11</size></font>
  </theme>
  <desktops>
    <number>9</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
      <name>5</name>
      <name>6</name>
      <name>7</name>
      <name>8</name>
      <name>9</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>
  <!-- the 40px of bin/ob-bar -->
  <margins><top>40</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <!-- launch, close, quit (as dwm: ~/w/dwm config.def.h) -->
    <keybind key="W-p"><action name="Execute"><command>~/dotfiles/bin/wm-menu</command></action></keybind>
    <keybind key="W-S-Return"><action name="Execute"><command>st</command></action></keybind>
    <keybind key="W-S-c"><action name="Close"/></keybind>
    <keybind key="W-S-q"><action name="Exit"><prompt>no</prompt></action></keybind>
    <keybind key="W-x"><action name="Execute"><command>~/dotfiles/bin/wm-ctl</command></action></keybind>
    <keybind key="W-S-x"><action name="Execute"><command>i3lock -c 000000</command></action></keybind>
    <keybind key="W-S-s"><action name="Execute"><command>~/dotfiles/bin/screenshot-select</command></action></keybind>
    <keybind key="Print"><action name="Execute"><command>~/dotfiles/bin/screenshot-select</command></action></keybind>
    <keybind key="C-A-s"><action name="Execute"><command>~/dotfiles/bin/sys-notify</command></action></keybind>
    <keybind key="C-A-c"><action name="Execute"><command>~/dotfiles/bin/cal-notify</command></action></keybind>
    <keybind key="W-n"><action name="Execute"><command>dunstctl close</command></action></keybind>
    <keybind key="W-S-n"><action name="Execute"><command>dunstctl close-all</command></action></keybind>
    <!-- windows: focus round the desktop, halves of the screen in place of tiling, maximized, fullscreen -->
    <keybind key="W-j"><action name="NextWindow"><dialog>none</dialog><bar>no</bar><raise>yes</raise></action></keybind>
    <keybind key="W-k"><action name="PreviousWindow"><dialog>none</dialog><bar>no</bar><raise>yes</raise></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"><dialog>none</dialog><bar>no</bar><raise>yes</raise></action></keybind>
    <keybind key="W-h"><action name="Unmaximize"/><action name="MoveResizeTo"><x>0</x><y>0</y><width>50%</width><height>100%</height></action></keybind>
    <keybind key="W-l"><action name="Unmaximize"/><action name="MoveResizeTo"><x>-0</x><y>0</y><width>50%</width><height>100%</height></action></keybind>
    <keybind key="W-m"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-S-f"><action name="ToggleFullscreen"/></keybind>
    <keybind key="W-Tab"><action name="GoToDesktop"><to>last</to></action></keybind>
    <!-- desktops: W-N to go, W-S-N to send the window there -->
    <keybind key="W-1"><action name="GoToDesktop"><to>1</to></action></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop"><to>1</to><follow>no</follow></action></keybind>
    <keybind key="W-2"><action name="GoToDesktop"><to>2</to></action></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop"><to>2</to><follow>no</follow></action></keybind>
    <keybind key="W-3"><action name="GoToDesktop"><to>3</to></action></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop"><to>3</to><follow>no</follow></action></keybind>
    <keybind key="W-4"><action name="GoToDesktop"><to>4</to></action></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop"><to>4</to><follow>no</follow></action></keybind>
    <keybind key="W-5"><action name="GoToDesktop"><to>5</to></action></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop"><to>5</to><follow>no</follow></action></keybind>
    <keybind key="W-6"><action name="GoToDesktop"><to>6</to></action></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop"><to>6</to><follow>no</follow></action></keybind>
    <keybind key="W-7"><action name="GoToDesktop"><to>7</to></action></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop"><to>7</to><follow>no</follow></action></keybind>
    <keybind key="W-8"><action name="GoToDesktop"><to>8</to></action></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop"><to>8</to><follow>no</follow></action></keybind>
    <keybind key="W-9"><action name="GoToDesktop"><to>9</to></action></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop"><to>9</to><follow>no</follow></action></keybind>
    <!-- media and HONOR Fn keys (bin/wm-fnkeys), as under i3 and dwm -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys vol-up</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys vol-down</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys vol-mute</command></action></keybind>
    <keybind key="W-XF86AudioRaiseVolume"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys mic-up</command></action></keybind>
    <keybind key="W-XF86AudioLowerVolume"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys mic-down</command></action></keybind>
    <keybind key="W-S-m"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys mic</command></action></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys mic</command></action></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys bright-up</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys bright-down</command></action></keybind>
    <keybind key="XF86TouchpadOn"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys touchpad-on</command></action></keybind>
    <keybind key="XF86TouchpadOff"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys touchpad-off</command></action></keybind>
    <keybind key="XF86TouchpadToggle"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys touchpad-toggle</command></action></keybind>
    <keybind key="XF86Launch1"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys profile</command></action></keybind>
    <keybind key="0x1008124d"><action name="Execute"><command>~/dotfiles/bin/wm-fnkeys camera</command></action></keybind>
    <keybind key="XF86AudioPlay"><action name="Execute"><command>playerctl play-pause</command></action></keybind>
    <keybind key="XF86AudioNext"><action name="Execute"><command>playerctl next</command></action></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute"><command>playerctl previous</command></action></keybind>
  </keyboard>
  <mouse>
    <dragThreshold>1</dragThreshold>
    <doubleClickTime>500</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>
    <!-- Super+drag moves, Super+right-drag resizes, a click focuses; the root's right click is the menu -->
    <context name="Frame">
      <mousebind button="W-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="W-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="W-Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="W-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    </context>
  </mouse>
  <menu><file>menu.xml</file><hideDelay>200</hideDelay><middle>no</middle><submenuShowDelay>100</submenuShowDelay></menu>
  <applications>
    <!-- no titlebar anywhere, the border alone, as in dwm -->
    <application class="*"><decor>no</decor></application>
    <application class="wm-ctl"><position force="yes"><x>center</x><y>center</y></position><size><width>1800</width><height>1200</height></size></application>
  </applications>
</openbox_config>
