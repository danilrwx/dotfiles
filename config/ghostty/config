keybind = alt+left=unbind
keybind = alt+right=unbind

font-family = Iosevka NF
maximize = true

window-padding-x = 8
window-padding-y = 5


theme = base

# tmux (set-clipboard external) passes its copies on as OSC 52 writes too;
# take them without a prompt. Reads keep the default "ask".
clipboard-write = allow
# No "Copied to clipboard" toast on every copy: tmux hands each selection over
# via OSC 52, so it fired constantly.
app-notifications = no-clipboard-copy

# Per-OS bits (font size, macOS option key): `install` links `os` to os-macos
# or os-linux, and `?` makes the include optional so a bare checkout still loads.
config-file = ?os

# ssh from ghostty: install its terminfo on the remote on first connect and pass
# TERM/COLORTERM, else servers without xterm-ghostty break less/vim/tmux
shell-integration-features = ssh-terminfo,ssh-env
