// Level 1/2 without Control, the Latin pair at 3/4 with it. Control stays unconsumed (preserve), so
// toolkits still see Ctrl+c rather than a bare c.
default partial xkb_types "basic" {
    type "CTRL_LATIN" {
        modifiers = Shift + Lock + Control;
        map[None] = Level1;
        map[Shift] = Level2;
        map[Lock] = Level2;
        map[Shift+Lock] = Level1;
        map[Control] = Level3;
        preserve[Control] = Control;
        map[Shift+Control] = Level4;
        preserve[Shift+Control] = Control;
        map[Lock+Control] = Level3;
        preserve[Lock+Control] = Control;
        map[Shift+Lock+Control] = Level4;
        preserve[Shift+Lock+Control] = Control;
        level_name[Level1] = "Base";
        level_name[Level2] = "Shift";
        level_name[Level3] = "Control";
        level_name[Level4] = "Shift Control";
    };
};
