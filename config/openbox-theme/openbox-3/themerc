# Openbox theme "dots" (config/openbox/rc.xml): the dwm look. No titlebars (decor off in rc.xml), so the
# 2px border is all a window shows: green while focused, black otherwise; the root menu black on white text
# as dmenu. Linked to ~/.local/share/themes/dots by install.
border.width: 2
padding.width: 4
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

window.active.border.color: #00cd00
window.inactive.border.color: #000000
window.active.client.color: #000000
window.inactive.client.color: #000000
window.active.title.bg: flat solid
window.active.title.bg.color: #000000
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #000000
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #888888
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #ffffff
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #888888

menu.border.width: 2
menu.border.color: #888888
menu.title.bg: flat solid
menu.title.bg.color: #000000
menu.title.text.color: #888888
menu.items.bg: flat solid
menu.items.bg.color: #000000
menu.items.text.color: #ffffff
menu.items.disabled.text.color: #444444
menu.items.active.bg: flat solid
menu.items.active.bg.color: #ffffff
menu.items.active.text.color: #000000
menu.separator.color: #444444

osd.border.width: 2
osd.border.color: #888888
osd.bg: flat solid
osd.bg.color: #000000
osd.label.text.color: #ffffff
osd.hilight.bg: flat solid
osd.hilight.bg.color: #ffffff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #444444
