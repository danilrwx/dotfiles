// OpenVPN through openvpn-client@NAME.service, switched by bin/openvpn-ctl: a click brings the first profile up
// or the one up down; its menu the profiles (private/config/openvpn), "connecting" while one comes up, and Off.
// In the bar while one is up.
widget "openvpn" name="OpenVPN" icon="network-vpn-symbolic" sizes="4x1 2x1 1x1 8x1" {
    poll "st" every="3s" exec="$HOME/dotfiles/bin/openvpn-ctl status --json"
    toggle icon="network-vpn-symbolic" title="OpenVPN" on="{st.on}" sub="{st.profile}{st.on && !st.ready && ', connecting' || ''}" {
        click exec="if [ {st.on} = true ]; then $HOME/dotfiles/bin/openvpn-ctl off; else $HOME/dotfiles/bin/openvpn-ctl on {st.profiles.0}; fi"
        menu {
            for "p" in="{st.profiles}" {
                row text="{p}" note="{p == st.profile && !st.ready && 'connecting' || ''}" on="{p == st.profile}" {
                    click exec="$HOME/dotfiles/bin/openvpn-ctl on {p}"
                }
            }
            separator
            row text="Off" on="{!st.on}" { click exec="$HOME/dotfiles/bin/openvpn-ctl off" }
        }
    }
    badge icon="network-vpn-symbolic" show="active" active="{st.on}"
}
