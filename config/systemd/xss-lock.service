# The lock at idle (xset s in bin/x-session) and before sleep, loginctl lock-session too: i3lock on the
# colour theme's ground. Part of the X session (x-session.target); linked to ~/.config/systemd/user and
# enabled by install.
[Unit]
Description=Screen lock
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xss-lock --session=${XDG_SESSION_ID} --transfer-sleep-lock -- /bin/sh -c 'bg=$$(xrdb -get theme.bg | tr -d "#"); exec i3lock -n -c "$${bg:-000000}"'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
