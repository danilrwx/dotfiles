# bin/x-night every minute while the X session is up (x-session.target). Linked to ~/.config/systemd/user and
# enabled by install.
[Unit]
Description=Night light every minute
PartOf=graphical-session.target

[Timer]
OnActiveSec=0
OnUnitActiveSec=60
AccuracySec=5

[Install]
WantedBy=graphical-session.target
