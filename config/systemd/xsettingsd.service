# XSETTINGS at 2x and the GTK theme: the state's file bin/theme writes (config/xsettingsd's with
# Net/ThemeName), the repo's before any theme; bin/theme HUPs it. Part of the X session (x-session.target);
# linked to ~/.config/systemd/user and enabled by install.
[Unit]
Description=XSETTINGS
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/bin/sh -c 'xs=$${XDG_STATE_HOME:-$$HOME/.local/state}/theme/xsettingsd.conf; [ -f "$$xs" ] || xs=$$HOME/dotfiles/config/xsettingsd/xsettingsd.conf; exec xsettingsd -c "$$xs"'
Restart=on-failure
RestartSec=1
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=graphical-session.target
