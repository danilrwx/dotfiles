# The StatusNotifierItem icons (Electron's trays) in polybar's XEmbed tray; without it they quit on close.
# Part of the X session (x-session.target); linked to ~/.config/systemd/user and enabled by install.
[Unit]
Description=StatusNotifierItem to XEmbed tray
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/snixembed
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
