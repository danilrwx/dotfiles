# The polkit agent, LXDE's lxpolkit (some 20 MB where polkit-gnome's took 70): the password prompts of
# virt-manager, udisks, fwupd and the rest. Part of the X session (x-session.target); linked to
# ~/.config/systemd/user and enabled by install.
[Unit]
Description=polkit agent
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/lxpolkit
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
