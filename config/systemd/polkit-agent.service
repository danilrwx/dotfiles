# The polkit agent: virt-manager's, udisks' and the rest's password prompts. Part of the X session
# (x-session.target); linked to ~/.config/systemd/user and enabled by install.
[Unit]
Description=polkit agent
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
