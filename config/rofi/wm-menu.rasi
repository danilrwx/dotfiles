/* bin/wm-menu's rofi: a dmenu-like line in the bar (config/eww), in its empty span and see-through, so the
 * bar's own ground shows under it and its workspaces and status stay in sight; bin/wm-menu sets the height
 * (the bar's). ponytail: from 240px, past a handful of workspaces, half the screen wide, clear of the status
 * with VLESS on; measure the bar's free span in bin/wm-menu should either outgrow it */
* {
    background-color: transparent;
    text-color:       #ffffff;
    font:             "Iosevka 11";
}
window {
    anchor:           north west;
    location:         north west;
    x-offset:         240px;
    width:            50%;
    background-color: transparent;
    children:         [ horibox ];
}
horibox {
    orientation:      horizontal;
    children:         [ prompt, entry, listview ];
}
prompt {
    vertical-align:   0.5;
    padding:          0 0.5em;
}
entry {
    expand:           false;
    width:            10em;
    vertical-align:   0.5;
    placeholder:      "";
}
listview {
    layout:           horizontal;
    lines:            100;
    spacing:          0;
}
/* the highlight as tall as the bar, as dmenu's: Iosevka 11 at 192 dpi is 37px, the bar 50
 * ponytail: tied to that font and bar; derive it in bin/wm-menu if either changes */
element {
    padding:          6px 0.5em 7px;
}
element selected {
    background-color: #ffffff;
    text-color:       #000000;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}
