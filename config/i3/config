# i3, the session (tuigreet starts it through startx). bin/x-autostart sets the keyboard and the daemons,
# the touchpad is /etc/X11/xorg.conf.d/30-touchpad.conf from install.

set $mod Mod4

set $left  h
set $down  j
set $up    k
set $right l

# base ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# the theme's colours from the X resources bin/theme sets (its `dark` is the fallback below); $barbg is $bg
# with the alpha the bar is see-through by over a wallpaper
set_from_resource $bg       theme.bg     #000000
set_from_resource $fg       theme.fg     #ffffff
set_from_resource $accent   theme.accent #00cd00
set_from_resource $darkgray theme.gray   #888888
set_from_resource $barbg    theme.barbg  #000000

# st, my own build (github.com/danilrwx/st)
set $term st
# dmenu-like launcher with the old dmenu colours, PATH fixed up for ~/.local/bin (bin/wm-menu)
set $menu $HOME/dotfiles/bin/wm-menu
set $lock i3lock -c 000000

font pango:Iosevka 11

# autostart ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# once per session: keyboard, Xresources, background, notifications, polkit, idle/lock
exec --no-startup-id $HOME/dotfiles/bin/x-autostart

default_border pixel 1
smart_borders  on

# keys ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# levels as a dunst progress card, mute and the HONOR Fn keys as a card (bin/wm-fnkeys)
set $fn $HOME/dotfiles/bin/wm-fnkeys
bindsym XF86AudioRaiseVolume      exec --no-startup-id $fn vol-up
bindsym XF86AudioLowerVolume      exec --no-startup-id $fn vol-down
bindsym XF86AudioMute             exec --no-startup-id $fn vol-mute

bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id $fn mic-up
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id $fn mic-down
bindsym $mod+Shift+m              exec --no-startup-id $fn mic
bindsym XF86AudioMicMute          exec --no-startup-id $fn mic

bindsym XF86MonBrightnessDown     exec --no-startup-id $fn bright-down
bindsym XF86MonBrightnessUp       exec --no-startup-id $fn bright-up

# HONOR Fn keys (patch/hotkeys of the HONOR fork maps them)
bindsym XF86TouchpadOn            exec --no-startup-id $fn touchpad-on
bindsym XF86TouchpadOff           exec --no-startup-id $fn touchpad-off
bindsym XF86TouchpadToggle        exec --no-startup-id $fn touchpad-toggle
bindsym XF86Launch1               exec --no-startup-id $fn profile
bindsym XF86CameraAccessToggle    exec --no-startup-id $fn camera
bindsym Print                     exec --no-startup-id $HOME/dotfiles/bin/screenshot-select

bindsym XF86AudioPlay             exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext             exec --no-startup-id playerctl next
bindsym XF86AudioPrev             exec --no-startup-id playerctl previous

bindsym $mod+Shift+s exec --no-startup-id $HOME/dotfiles/bin/screenshot-select
bindsym $mod+d       exec --no-startup-id $menu
bindsym $mod+Shift+x exec --no-startup-id $lock
# Wi-Fi, Bluetooth, sound output and input, power profile: a dmenu pick (bin/wm-ctl)
bindsym $mod+x       exec --no-startup-id $HOME/dotfiles/bin/wm-ctl

bindsym Control+Mod1+s exec --no-startup-id $HOME/dotfiles/bin/sys-notify
bindsym Control+Mod1+c exec --no-startup-id $HOME/dotfiles/bin/cal-notify
bindsym $mod+n         exec --no-startup-id dunstctl close
bindsym $mod+Shift+n   exec --no-startup-id dunstctl close-all

floating_modifier $mod

bindsym $mod+Return exec $term

bindsym $mod+Shift+q kill

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+v split v
bindsym $mod+c split h

bindsym $mod+b bar mode toggle

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle

bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent

set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+Tab workspace back_and_forth

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Exit i3? This ends the X session.' -B 'Yes, exit i3' 'i3-msg exit'

mode "resize" {
  bindsym $left  resize shrink width  5 px or 5 ppt
  bindsym $down  resize grow   height 5 px or 5 ppt
  bindsym $up    resize shrink height 5 px or 5 ppt
  bindsym $right resize grow   width  5 px or 5 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# window rules ────────────────────────────────────────────
for_window [class="steam"]                  floating enable
for_window [class="steam" title="^Steam$"]  floating disable
for_window [class="(?i).*telegram.*"]       floating enable, border none
for_window [title="^SSH Askpass$"]          floating enable
for_window [class="wm-ctl"]                 floating enable, resize set 60 ppt 70 ppt, move position center


client.focused                 $bg        $bg       $fg            $accent      $accent
client.focused_inactive        $bg        $bg       $darkgray      $bg          $bg
client.unfocused               $bg        $bg       $darkgray      $bg          $bg
client.urgent                  $accent    $bg       $accent        $accent      $accent

bar {
  # Nerd Font icons a size below the text (bin/wm-status), 24px clear of the panel's rounded corners at
  # either end (12 logical px, i3 doubles them at Xft.dpi 192); the tray takes no padding
  status_command $HOME/dotfiles/bin/wm-status
  # RGBA colours, for $barbg's alpha under xcompmgr (bin/theme)
  i3bar_command i3bar --transparency
  padding 0 12px
  tray_padding 5
  position top
  colors {
     background $barbg
     statusline $darkgray
     #class               border  backgr. text
     focused_workspace    $barbg     $barbg     $fg
     inactive_workspace   $barbg     $barbg     $darkgray
     active_workspace     $barbg     $barbg     $darkgray
     urgent_workspace     $barbg     $barbg     $accent
  }
}

