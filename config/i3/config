# i3, the session (install --desktop, bin/x-session starts it through startx): my old i3 config's keys,
# colours and bar. Linked to ~/.config/i3 by install.

set $mod Mod4

set $left  h
set $down  j
set $up    k
set $right l

# base ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# the colour theme's (bin/theme merges them into the X resources), these the fallback
set_from_resource $bg       theme.bg    #000000
set_from_resource $fg       theme.fg    #ffffff
set_from_resource $accent   theme.green #00cd00
set_from_resource $darkgray theme.grey  #888888

# alacritty (config/alacritty)
set $term alacritty
# dmenu over the bar, its apps by name (bin/x-run), the bar's font and colours
set $menu x-run
set $lock loginctl lock-session

font pango:Iosevka 11

default_border pixel 1
smart_borders  on

# keys ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# levels as a dunst progress card, mute and the HONOR Fn keys as a card (bin/x-fnkeys)
set $fn x-fnkeys
bindsym XF86AudioRaiseVolume      exec --no-startup-id $fn vol-up
bindsym XF86AudioLowerVolume      exec --no-startup-id $fn vol-down
bindsym XF86AudioMute             exec --no-startup-id $fn vol-mute

bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id $fn mic-up
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id $fn mic-down
bindsym $mod+Shift+m              exec --no-startup-id $fn mic
bindsym XF86AudioMicMute          exec --no-startup-id $fn mic

bindsym XF86MonBrightnessDown     exec --no-startup-id $fn bright-down
bindsym XF86MonBrightnessUp       exec --no-startup-id $fn bright-up

# HONOR Fn keys (patch/hotkeys of the HONOR fork maps them)
bindsym XF86TouchpadOn            exec --no-startup-id $fn touchpad-on
bindsym XF86TouchpadOff           exec --no-startup-id $fn touchpad-off
bindsym XF86TouchpadToggle        exec --no-startup-id $fn touchpad-toggle
bindsym XF86Launch1               exec --no-startup-id $fn profile
bindsym XF86CameraAccessToggle    exec --no-startup-id $fn camera

bindsym XF86AudioPlay             exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext             exec --no-startup-id playerctl next
bindsym XF86AudioPrev             exec --no-startup-id playerctl previous

# a region to the clipboard
bindsym Print        exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'
bindsym $mod+Shift+s exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'
bindsym $mod+d       exec --no-startup-id $menu
bindsym $mod+Shift+x exec --no-startup-id $lock
# Wi-Fi, Bluetooth, drives, sound output and input, headset, vless, openvpn, power profile: a dmenu pick (bin/x-ctl)
bindsym $mod+x       exec --no-startup-id x-ctl

bindsym $mod+n       exec --no-startup-id dunstctl close
bindsym $mod+Shift+n exec --no-startup-id dunstctl close-all

floating_modifier $mod

bindsym $mod+Return exec $term

bindsym $mod+Shift+q kill

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

bindsym $mod+v split v
bindsym $mod+c split h

bindsym $mod+b bar mode toggle

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle

bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent

bindsym $mod+Tab workspace back_and_forth

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Exit i3? This ends the X session.' -B 'Yes, exit i3' 'i3-msg exit'

mode "resize" {
  bindsym $left  resize shrink width  5 px or 5 ppt
  bindsym $down  resize grow   height 5 px or 5 ppt
  bindsym $up    resize shrink height 5 px or 5 ppt
  bindsym $right resize grow   width  5 px or 5 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# window rules ──────────────────────────────────────────────────────────────────────────────────────────────────────────
for_window [class="steam"]                  floating enable
for_window [class="steam" title="^Steam$"]  floating disable
for_window [class="(?i).*telegram.*"]       floating enable, border none
for_window [title="^SSH Askpass$"]          floating enable
for_window [class="x-ctl"]                  floating enable, resize set 60 ppt 70 ppt, move position center

client.focused                 $bg        $bg       $fg            $accent      $accent
client.focused_inactive        $bg        $bg       $darkgray      $bg          $bg
client.unfocused               $bg        $bg       $darkgray      $bg          $bg
client.urgent                  $accent    $bg       $accent        $accent      $accent

bar {
  # plain words (bin/x-status)
  status_command x-status
  # as tall as bin/x-run's dmenu (Iosevka 11 at 192 dpi: the font's 38px and 2), where i3bar's own is 50; a padding
  # line would win over it, so none, and no room left from the panel's rounded corners
  # ponytail: tied to that font; measure dmenu again (xwininfo -root -children) if either changes
  height 40
  tray_padding 5
  position top
  colors {
     background $bg
     statusline $darkgray
     #class               border  backgr. text
     focused_workspace    $bg     $bg     $fg
     inactive_workspace   $bg     $bg     $darkgray
     active_workspace     $bg     $bg     $darkgray
     urgent_workspace     $bg     $bg     $accent
  }
}
