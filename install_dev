#!/bin/sh
# ./install_dev [--android] [--skip-go]
#   --android    also install Android SDK and Studio
#   --skip-go    retain installed Go tools; still update the Go compiler

ANDROID=0
SKIP_GO=0

for arg do
  case $arg in
    --android) ANDROID=1 ;;
    --skip-go) SKIP_GO=1 ;;
    -h|--help) sed -n '2,4s/^# //p' "$0"; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

cd "$HOME/dotfiles" || exit 1

. ./lib/install.sh
# shellcheck source=/dev/null
. /etc/os-release
[ "$ID" = ubuntu ] || { log 'Ubuntu only'; exit 1; }
RTK_VERSION=v1.0.1

DEV_PKGS="openvpn openvpn-systemd-resolved libvirt-daemon-system libvirt-clients qemu-system-x86 tigervnc-viewer
  build-essential clangd nodejs npm clang clang-format bison flex meson ninja-build valac valgrind bear tokei shellcheck scdoc pkg-config universal-ctags
  gobject-introspection python3-pil systemd-dev glslang-tools git-filter-repo evtest"

DOCKER_PKGS="docker.io docker-compose-v2 docker-buildx"

ANDROID_PKGS="openjdk-21-jdk-headless android-sdk-platform-tools-common libxrender1 libxtst6 libxi6
  libpulse0 libglu1-mesa scrcpy"

install_rtk() {
  rtk_ver=$RTK_VERSION

  case "$(uname -m)" in
    x86_64|amd64) rtk_target=x86_64-unknown-linux-musl ;;
    aarch64|arm64) rtk_target=aarch64-unknown-linux-gnu ;;
    *) log "RTK unsupported on architecture $(uname -m)"; return 1 ;;
  esac

  # Check that RTK runs as well as reporting the pinned version.
  rtk_ok() {
    "$1" --version 2>/dev/null | awk -v ver="${rtk_ver#v}" '$0 == "rtk " ver { found=1 } END { exit !found }' \
      && "$1" gain >/dev/null 2>&1
  }
  rtk_ok "$HOME/.local/bin/rtk" && return

  rtk_asset="rtk-$rtk_target.tar.gz"
  mkdir -p "$HOME/.local/bin"
  rtk_tmp=$(mktemp -d)

  log "Installing RTK $rtk_ver"

  if curl -fsSL -o "$rtk_tmp/checksums.txt" "https://github.com/rtk-ai/rtk/releases/download/$rtk_ver/checksums.txt" \
    && fetch "https://github.com/rtk-ai/rtk/releases/download/$rtk_ver/$rtk_asset" "$rtk_tmp/$rtk_asset" \
      "$(awk -v asset="$rtk_asset" '$2 == asset {print $1}' "$rtk_tmp/checksums.txt")" \
    && unpack "$rtk_tmp/$rtk_asset" "$rtk_tmp/x" && [ -x "$rtk_tmp/x/rtk" ] \
    && install -m 755 "$rtk_tmp/x/rtk" "$HOME/.local/bin/rtk.new" && rtk_ok "$HOME/.local/bin/rtk.new" \
    && mv -f "$HOME/.local/bin/rtk.new" "$HOME/.local/bin/rtk"; then
    log "Installed RTK $rtk_ver"
  else
    rm -f "$HOME/.local/bin/rtk.new"

    log "RTK download, checksum or verification failed; installation left unchanged"
  fi

  rm -rf "$rtk_tmp"
  return 0
}

android() {
  # Use the SDK's adb instead of scrcpy's recommended distro adb.
  sudo apt install -y --no-install-recommends $ANDROID_PKGS

  getent group kvm > /dev/null && join_group kvm
  android_sdk
  android_studio
}

android_sdk() {
  sdk_dir=$HOME/Android/Sdk
  sdkmanager=$HOME/Android/Sdk/cmdline-tools/latest/bin/sdkmanager

  if [ ! -x "$sdkmanager" ]; then
    log "Installing the Android command-line tools"
    sdk_tmp=$(mktemp -d)

    if curl -fsSL -o "$sdk_tmp/repository.xml" https://dl.google.com/android/repository/repository2-3.xml; then
      # The Linux archive URL and SHA1 come from Google's package index.
      sdk_block=$(sed -n '/<remotePackage path="cmdline-tools;latest">/,/<\/remotePackage>/p' "$sdk_tmp/repository.xml")
      sdk_sha=$(printf '%s\n' "$sdk_block" | sed -n 's|.*<checksum type="sha1">\([0-9a-f]*\)<.*|\1|p' | head -1)
      sdk_url=$(printf '%s\n' "$sdk_block" | sed -n 's|.*<url>\(commandlinetools-linux-[^<]*\)<.*|\1|p' | head -1)

      if [ -n "$sdk_url" ] && [ -n "$sdk_sha" ] \
        && fetch "https://dl.google.com/android/repository/$sdk_url" "$sdk_tmp/$sdk_url" "sha1:$sdk_sha" \
        && unpack "$sdk_tmp/$sdk_url" "$sdk_tmp/x" && [ -x "$sdk_tmp/x/cmdline-tools/bin/sdkmanager" ] \
        && mkdir -p "$sdk_dir/cmdline-tools" && swap_tree "$sdk_tmp/x/cmdline-tools" "$sdk_dir/cmdline-tools/latest"; then
        log "Installed the command-line tools from $sdk_url"
      else
        log "The command-line tools download/checksum failed; no Android SDK this run. Continue installation."
        rm -rf "$sdk_tmp"
        return 1
      fi
    else
      log "dl.google.com is unreachable; no Android SDK this run. Continue installation."
      rm -rf "$sdk_tmp"
      return 1
    fi

    rm -rf "$sdk_tmp"
  fi

  log "Accepting the SDK licences"
  yes | "$sdkmanager" --licenses > /dev/null 2>&1 || log "sdkmanager --licenses reported an error. Continue installation."

  # Select numeric stable releases; sdkmanager accepts both / and ; separators.
  set -- platform-tools emulator
  sdk_list=$("$sdkmanager" --list 2>/dev/null)
  sdk_api=$(printf '%s\n' "$sdk_list" \
    | sed -n 's|^ *platforms[/;]android-\([0-9][0-9.]*\)[[:space:]].*|\1|p' | sort -V | tail -1)
  sdk_bt=$(printf '%s\n' "$sdk_list" \
    | sed -n 's|^ *build-tools[/;]\([0-9][0-9.]*\)[[:space:]].*|\1|p' | sort -V | tail -1)
  [ -z "$sdk_api" ] || set -- "$@" "platforms/android-$sdk_api"
  [ -z "$sdk_bt" ] || set -- "$@" "build-tools/$sdk_bt"

  log "Installing the SDK packages: $*"
  "$sdkmanager" --install "$@" || log "sdkmanager failed on $*. Continue installation."
}

android_studio() {
  studio_dir=/opt/android-studio

  put /usr/share/applications/android-studio.desktop

  studio_tmp=$(mktemp -d)

  if ! curl -fsSL -o "$studio_tmp/page" https://developer.android.com/studio; then
    log "developer.android.com is unreachable; Android Studio left as it is. Continue installation."
    rm -rf "$studio_tmp"
    return 1
  fi

  studio_url=$(tr '\n' ' ' < "$studio_tmp/page" \
    | grep -oE 'https://[^" ]*ide-zips/[^" ]*/android-studio-[a-z0-9]+-linux\.tar\.gz' | head -1)
  studio_ver=$(printf '%s' "$studio_url" | sed -n 's|.*/ide-zips/\([^/]*\)/.*|\1|p')
  # Read the checksum beside the Linux download button, not the dialog link.
  studio_sha=$(tr '\n' ' ' < "$studio_tmp/page" | grep -oE '>android-studio-[a-z0-9]+-linux\.tar\.gz</button>.{0,200}' \
    | grep -oE '\b[0-9a-f]{64}\b' | head -1)
  studio_have=$(cat "$studio_dir/.install-version" 2>/dev/null)
  [ -n "$studio_have" ] || studio_have=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$studio_dir/product-info.json" 2>/dev/null | head -1)

  if [ -z "$studio_url" ] || [ -z "$studio_ver" ] || [ -z "$studio_sha" ]; then
    log "The download list could not be read off the Studio page; Android Studio left as it is."
    rm -rf "$studio_tmp"
    return 1
  fi

  if [ "$studio_have" = "$studio_ver" ]; then
    rm -rf "$studio_tmp"
    return 0
  fi

  log "Installing Android Studio $studio_ver"

  if fetch "$studio_url" "$studio_tmp/studio.tar.gz" "$studio_sha" && unpack "$studio_tmp/studio.tar.gz" "$studio_tmp/x" \
    && [ -x "$studio_tmp/x/android-studio/bin/studio.sh" ] && swap_tree "$studio_tmp/x/android-studio" "$studio_dir"; then
    printf '%s\n' "$studio_ver" | sudo tee "$studio_dir/.install-version" > /dev/null

    log "Installed Android Studio $studio_ver"
  else
    log "Android Studio $studio_ver not installed; $studio_dir left as it was. Continue installation."
  fi

  rm -rf "$studio_tmp"
}

install_go() {
  case "$(uname -m)" in
    x86_64|amd64)  go_arch=amd64 ;;
    aarch64|arm64) go_arch=arm64 ;;
    *) log "Go: unsupported architecture $(uname -m)"; return 1 ;;
  esac

  go_tmp=$(mktemp -d)

  if ! curl -fsSL -o "$go_tmp/json" 'https://go.dev/dl/?mode=json'; then
    log "go.dev is unreachable; /usr/local/go left as it is. Continue installation."
    rm -rf "$go_tmp"
    return 1
  fi

  go_ver=$(jq -r '.[0].version' "$go_tmp/json")
  go_file=$(jq -r --arg a "$go_arch" \
    '.[0].files[] | select(.os == "linux" and .arch == $a and .kind == "archive") | .filename' "$go_tmp/json")
  go_sha=$(jq -r --arg f "$go_file" '.[0].files[] | select(.filename == $f) | .sha256' "$go_tmp/json")

  if [ -z "$go_ver" ] || [ -z "$go_file" ] || [ -z "$go_sha" ]; then
    log "go.dev's release list has no $go_arch archive; /usr/local/go left as it is. Continue installation."
    rm -rf "$go_tmp"
    return 1
  fi

  if [ "$(head -1 /usr/local/go/VERSION 2>/dev/null)" = "$go_ver" ]; then
    rm -rf "$go_tmp"
    return 0
  fi

  log "Installing Go $go_ver"

  if ! fetch "https://go.dev/dl/$go_file" "$go_tmp/$go_file" "$go_sha" \
    || ! unpack "$go_tmp/$go_file" "$go_tmp/x" \
    || [ "$("$go_tmp/x/go/bin/go" version 2>/dev/null | awk '{print $3}')" != "$go_ver" ] \
    || ! swap_tree "$go_tmp/x/go" /usr/local/go; then
    log "Go $go_ver download, checksum or verification failed; /usr/local/go left as it was. Continue installation."
    rm -rf "$go_tmp"
    return 1
  fi

  log "Installed Go $go_ver"
  rm -rf "$go_tmp"
}

dev_tools() {
  # Verify kubectl before replacing the installed binary.
  if ! command -v kubectl > /dev/null 2>&1; then
    log "Installing kubectl"
    kubectl_arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
    kubectl_url="https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${kubectl_arch}/kubectl"
    kubectl_tmp=$(mktemp)

    if ! kubectl_sha=$(curl -fsSL "$kubectl_url.sha256"); then
      log "kubectl's .sha256 is unreachable; nothing installed. Continue installation."
    elif fetch "$kubectl_url" "$kubectl_tmp" "$kubectl_sha" && sudo install -m 755 "$kubectl_tmp" /usr/local/bin/kubectl; then :
    else
      log "kubectl download or checksum failed; nothing installed. Continue installation."
    fi

    rm -f "$kubectl_tmp"
  fi

  # Replace distro Go only after the downloaded compiler is installed.
  export PATH="$HOME/go/bin:$HOME/.local/bin:/usr/local/go/bin:$PATH"

  if install_go; then
    # Package names contain no whitespace or glob characters.
    # shellcheck disable=SC2046
    set -- $(dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'golang*' 2>/dev/null |
      awk '$1 == "installed" && $2 ~ /^golang(-[0-9][0-9.]*)?-(go|src)$/ {print $2}')

    if [ "$#" -gt 0 ]; then
      log "Removing the archive's Go: $*"

      sudo apt purge -y "$@"
    fi
  fi

  if [ "$SKIP_GO" = 1 ]; then
    log "Skipping go tools"
  elif ! command -v go > /dev/null; then
    log "No Go compiler; skipping the go tools"
  else
    log "Installing go tools"

    for module in \
      github.com/cli/cli/v2/cmd/gh@latest \
      gitlab.com/gitlab-org/cli/cmd/glab@latest \
      helm.sh/helm/v3/cmd/helm@latest \
      github.com/derailed/k9s@latest \
      github.com/mikefarah/yq/v4@latest \
      github.com/google/go-containerregistry/cmd/crane@latest \
      github.com/go-task/task/v3/cmd/task@latest \
      github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest \
      golang.org/x/tools/gopls@latest \
      golang.org/x/tools/cmd/goimports@latest \
      mvdan.cc/gofumpt@latest \
      github.com/go-delve/delve/cmd/dlv@latest \
      github.com/matryer/moq@latest \
      github.com/onsi/ginkgo/v2/ginkgo@v2.14.0 \
      github.com/mrjosh/helm-ls@latest \
      github.com/getsops/sops/v3/cmd/sops@latest
    do
      go install "$module" || log "go install $module failed. Continue installation."
    done

    # shortcut: godef cannot read Go 1.27 exports; drop the override after an upstream fix.
    (
      cd dev/godef || exit 1
      GOWORK=off go build -mod=readonly -o "$HOME/go/bin/godef" github.com/rogpeppe/godef
    ) || log "godef build failed. Continue installation."
  fi

  log "Generating bash completions"   # sourced by .bashrc
  mkdir -p "$HOME/.local/share/completions"
  fzf --bash              > "$HOME/.local/share/completions/fzf.bash"     2>/dev/null || true
  kubectl completion bash > "$HOME/.local/share/completions/kubectl.bash" 2>/dev/null || true

  command -v vpnctl > /dev/null 2>&1 &&
    vpnctl completion bash > "$HOME/.local/share/completions/vpnctl.bash" 2>/dev/null || true

  # d8 defaults to /opt, which isn't on PATH.
  if ! command -v d8 > /dev/null 2>&1; then
    log "Installing d8"
    INSTALL_DIR=/usr/local/bin UNATTENDED=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/deckhouse/deckhouse-cli/main/tools/install.sh)"
  fi
}

docker_setup() {
  if installed docker-ce; then
    log "Docker Inc's docker-ce is installed: ./debloat moves it to the archive's docker.io"
  elif ! installed docker.io; then
    log "Installing docker"
    pkg $DOCKER_PKGS

    sudo systemctl enable --now docker.socket
  fi

  join_group docker
}

openvpn_profiles() {
  put /etc/polkit-1/rules.d/50-openvpn-client.rules 644 dev/etc/polkit-1/rules.d/50-openvpn-client.rules

  for vpn_ovpn in private/config/openvpn/*.ovpn; do
    [ -f "$vpn_ovpn" ] || continue
    vpn_name=$(basename "$vpn_ovpn" .ovpn)
    vpn_conf=$(mktemp)
    grep -vE '^[[:space:]]*(auth-user-pass|askpass)([[:space:]]|$)' "$vpn_ovpn" > "$vpn_conf"

    if [ -f "private/config/openvpn/$vpn_name.auth" ]; then
      sudo install -D -m 600 "private/config/openvpn/$vpn_name.auth" "/etc/openvpn/client/$vpn_name.auth"
      echo "auth-user-pass /etc/openvpn/client/$vpn_name.auth" >> "$vpn_conf"
    fi

    if [ -f "private/config/openvpn/$vpn_name.pass" ]; then
      sudo install -D -m 600 "private/config/openvpn/$vpn_name.pass" "/etc/openvpn/client/$vpn_name.pass"
      echo "askpass /etc/openvpn/client/$vpn_name.pass" >> "$vpn_conf"
    fi

    cat >> "$vpn_conf" <<'EOT'

# install: the server's DNS to systemd-resolved, for the names behind the tunnel
script-security 2
up /etc/openvpn/update-systemd-resolved
up-restart
down /etc/openvpn/update-systemd-resolved
down-pre
EOT
    sudo cmp -s "$vpn_conf" "/etc/openvpn/client/$vpn_name.conf" \
      || { log "Installing the OpenVPN profile $vpn_name"; sudo install -D -m 600 "$vpn_conf" "/etc/openvpn/client/$vpn_name.conf"; }
    rm -f "$vpn_conf"
  done
}

sudo apt update
sudo apt install -y $DEV_PKGS
link dev/config/k9s "$HOME/.config/k9s" || exit 1
link dev/bin/vpn-openvpn "$HOME/.local/bin/vpn-openvpn" || exit 1
join_group libvirt

if getent group kvm >/dev/null; then join_group kvm; fi
openvpn_profiles

if [ -f private/install ]; then
  private/install || log 'Private development installer failed'
fi

install_rtk
dev_tools
docker_setup
[ "$ANDROID" != 1 ] || android
[ -z "$BACKUP_DIR" ] || log "Backups: $BACKUP_DIR"
