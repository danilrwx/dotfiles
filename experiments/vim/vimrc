" Standalone Vim experiment: no external plugins or language servers.
set nocompatible
let mapleader = ' '
filetype plugin indent on
syntax enable
set background=dark
set notermguicolors
set autoindent
set smartindent
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set number
set laststatus=0
set hidden
set undofile
set completeopt=menuone,noselect,noinsert,fuzzy,popup
set pumheight=12
set wildoptions=pum
let g:c_syntax_for_h = 1
let g:netrw_banner = 0
let g:markdown_syntax_conceal = 1
let g:markdown_fenced_languages = ['bash=sh', 'sh', 'go', 'lua', 'python', 'json', 'yaml', 'vim', 'c', 'rust']

" Native word/tag completion; C also offers include-based omni completion.
set autocomplete
set tags=./tags;,tags
command! Tags execute '!' .. (executable('uctags') ? 'uctags' : 'ctags')
      \ .. ' -R --languages=C,C++,Go,Zig --exclude=.git --exclude=build --exclude=generated --exclude=zig-out --exclude=.zig-cache .'
set undodir=~/.vim/undo//
call mkdir(expand('~/.vim/undo'), 'p')

function! s:Colors() abort
  if &background ==# 'light'
    execute 'source' fnameescape(expand('~/dotfiles/config/themes/light/vim.vim'))
  else
    highlight LineNr ctermfg=8 ctermbg=NONE
    highlight CursorLineNr ctermfg=8 ctermbg=NONE
    highlight DocPopup ctermfg=15 ctermbg=16
    highlight DocBorder ctermfg=8 ctermbg=16
    highlight Pmenu ctermfg=7 ctermbg=235
    highlight PmenuSel ctermfg=15 ctermbg=238 cterm=bold
    highlight PmenuSbar ctermbg=235
    highlight PmenuThumb ctermbg=240
  endif
endfunction
call s:Colors()

function! s:Theme(background) abort
  highlight clear
  let &background = a:background
  let &termguicolors = a:background ==# 'light'
  syntax reset
  call s:Colors()
endfunction
command! ThemeDark call s:Theme('dark')
command! ThemeLight call s:Theme('light')
function! s:SyncTheme() abort
  let path = expand('~/.config/dotfiles/theme/name')
  let mode = filereadable(path) ? get(readfile(path), 0, 'dark') : 'dark'
  if mode !=# get(s:, 'global_theme', '')
    let s:global_theme = mode
    call s:Theme(mode)
  endif
endfunction
nnoremap <silent> <leader>ut <Cmd>call system(expand('~/dotfiles/bin/x-theme') .. ' toggle')<Bar>call <SID>SyncTheme()<CR>

function! NativeFind(text, completing) abort
  if !a:completing && filereadable(a:text)
    return [a:text]
  endif
  if executable('fd')
    let command = 'fd --type f --color never'
  else
    let command = "find . ! -name . -name '.*' -prune -o -type f -print"
  endif
  let files = systemlist(command)
  if v:shell_error
    echoerr 'File search failed: ' .. command
    return []
  endif
  call map(files, {_, path -> substitute(path, '^\./', '', '')})
  return empty(a:text) ? files : matchfuzzy(files, a:text)
endfunction
set findfunc=NativeFind

if executable('ugrep')
  let &grepprg = "ugrep -RInkj --tabs=1 --ignore-files --exclude='zz_generated*' --exclude-dir='generated'"
  let &grepformat = '%f:%l:%c:%m,%f+%l+%c+%m,%-G%f|%l|%c|%m'
else
  let &grepprg = "grep -RInH --exclude-dir=.git --exclude='*zz_generated*' --exclude-dir='generated'"
  let &grepformat = '%f:%l:%m'
endif
function! Grepq(pattern) abort
  let command = &grepprg .. ' -- ' .. shellescape(a:pattern)
  let lines = systemlist(command)
  if v:shell_error > 1
    echoerr join(lines, "\n")
    return
  endif
  call setqflist([], ' ', {'title': command, 'lines': lines, 'efm': &grepformat})
  belowright cwindow
endfunction
command! -nargs=+ Grepq call Grepq(<q-args>)
function! ToggleQuickfix() abort
  if !empty(filter(getwininfo(), {_, w -> w.quickfix && !w.loclist}))
    cclose
  elseif !empty(getqflist())
    execute 'botright copen' min([10, len(getqflist())])
  else
    echo 'quickfix is empty'
  endif
endfunction
function! SearchSelection() abort
  normal! "zy
  let text = get(split(getreg('z'), "\n"), 0, '')
  if !empty(text)
    call Grepq(text)
  endif
endfunction

function! RestorePosition() abort
  let pos = getpos("'\"")
  if &buftype == '' && pos[1] > 0 && pos[1] <= line('$')
    call setpos('.', pos)
  endif
endfunction
function! CopyText(text) abort
  if !empty($WAYLAND_DISPLAY) && executable('wl-copy')
    call system('wl-copy', a:text)
  elseif !empty($DISPLAY) && executable('xclip')
    call system('xclip -selection clipboard', a:text)
  endif
endfunction
function! CopyPosition() abort
  call CopyText(expand('%') .. ':' .. line('.'))
endfunction
function! ClearYank(win, id, timer) abort
  silent! call win_execute(a:win, 'silent! call matchdelete(' .. a:id .. ')')
endfunction
function! OnYank() abort
  if v:event.operator != 'y'
    return
  endif
  if v:event.regname == ''
    call CopyText(join(v:event.regcontents, "\n") .. (v:event.regtype == 'V' ? "\n" : ''))
  endif
  let positions = map(getregionpos(getpos("'["), getpos("']"), {'type': v:event.regtype}),
        \ {_, r -> [r[0][1], r[0][2], max([1, r[1][2] - r[0][2] + 1])]})
  let win = win_getid()
  while !empty(positions)
    let chunk = remove(positions, 0, min([7, len(positions)-1]))
    let id = matchaddpos('IncSearch', chunk)
    call timer_start(200, function('ClearYank', [win, id]))
  endwhile
endfunction

function! Playbook(first, last) abort
  if empty($TMUX)
    echo 'playbook: not inside tmux'
    return
  endif
  let target = shellescape(get(g:, 'playbook_target', '{last}'))
  for text in getline(a:first, a:last)
    if text =~ '\S'
      call system('tmux send-keys -t ' .. target .. ' -l -- ' .. shellescape(text))
      call system('tmux send-keys -t ' .. target .. ' Enter')
    endif
  endfor
endfunction
function! PlaybookMappings() abort
  nnoremap <buffer> <silent> <CR> :call Playbook(line('.'), line('.'))<CR>j
  xnoremap <buffer> <silent> <CR> :<C-u>call Playbook(line("'<"), line("'>"))<CR>
endfunction

function! GoTags(pattern, flags, info) abort
  if a:flags !~# 'c' || !executable('godef') || empty(expand('%:p'))
    return v:null
  endif
  let offset = line2byte(line('.')) + col('.') - 2
  let command = 'cd ' .. shellescape(expand('%:p:h')) .. ' && godef -json -i -f '
        \ .. shellescape(expand('%:p')) .. ' -o ' .. offset
  let output = system(command, join(getline(1, '$'), "\n") .. "\n")
  if v:shell_error
    echohl WarningMsg
    echom trim(output)
    echohl None
    return []
  endif
  let pos = json_decode(output)
  return [{'name': a:pattern, 'filename': pos.filename, 'cmd': string(pos.line)}]
endfunction

function! GoDocFilter(win, key) abort
  if a:key ==# "\<Esc>" || a:key ==# 'q'
    call popup_close(a:win)
    return 1
  endif
  let direction = {"\<C-d>": 1, "\<C-u>": -1, "\<PageDown>": 1, "\<PageUp>": -1}
  if !has_key(direction, a:key)
    return 0
  endif
  let pos = popup_getpos(a:win)
  let step = index(["\<C-d>", "\<C-u>"], a:key) >= 0 ? max([1, pos.core_height / 2]) : pos.core_height
  let last = max([1, len(getbufline(winbufnr(a:win), 1, '$')) - pos.core_height + 1])
  call popup_setoptions(a:win, {'firstline': min([last, max([1, pos.firstline + direction[a:key] * step])])})
  return 1
endfunction

" Explicit package/type names work; local variable types are not inferred.
function! GoDoc(query) abort
  let query = empty(a:query) ? matchstr(expand('<cexpr>'), '\h\w*\%(\.\h\w*\)*') : a:query
  let args = join(map(split(query), {_, arg -> shellescape(arg)}), ' ')
  let command = 'go doc -C ' .. shellescape(expand('%:p:h')) .. ' ' .. args
  let lines = systemlist(command)
  if v:shell_error
    echohl WarningMsg
    echom join(lines, "\n")
    echohl None
    return 0
  endif
  let win = popup_atcursor(lines, {
        \ 'maxheight': 20, 'maxwidth': min([100, &columns - 4]),
        \ 'padding': [0,1,0,1], 'border': [1,1,1,1],
        \ 'borderchars': ['─','│','─','│','╭','╮','╯','╰'],
        \ 'highlight': 'DocPopup', 'borderhighlight': ['DocBorder'],
        \ 'moved': 'any', 'mapping': 0, 'filter': 'GoDocFilter',
        \})
  call setbufvar(winbufnr(win), '&syntax', 'go')
  return win
endfunction
command! -nargs=* GoDoc call GoDoc(<q-args>)

augroup native_config
  autocmd!
  autocmd ColorScheme * call s:Colors()
  autocmd FocusGained * call s:SyncTheme()
  autocmd BufReadPost * call RestorePosition()
  autocmd TextYankPost * call OnYank()
  autocmd BufRead,BufNewFile *.yaml,*.tpl setlocal filetype=helm
  autocmd FileType helm setlocal syntax=yaml
  autocmd FileType c,cpp compiler gcc
  autocmd FileType c,cpp setlocal omnifunc=ccomplete#Complete path+=/usr/include,/usr/local/include
  autocmd FileType go compiler go
  autocmd FileType go setlocal tagfunc=GoTags
  autocmd FileType go nnoremap <buffer> <silent> gd <C-]>
  autocmd FileType go nnoremap <buffer> <silent> K <Cmd>GoDoc<CR>
  autocmd FileType markdown setlocal conceallevel=2 concealcursor= wrap linebreak
  autocmd BufRead,BufNewFile playbook.sh call PlaybookMappings()
augroup END

