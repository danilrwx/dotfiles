#!/bin/sh
# ./debloat [-n]
#   Strip a stock Ubuntu desktop down to what the Labwc session from `./install --desktop` runs on: every
#   snap and snapd itself unless Steam is installed as a snap, GNOME, GDM, the Ubuntu desktop extras,
#   the former bspwm session, NetworkManager (iwd has Wi-Fi),
#   the services nothing here uses and the configs the removed apps left in ~/.config.
#   Run `./install --desktop` first, so greetd is there to log in with once GDM is gone.
#   -n  dry run: show what apt would remove, change nothing

set -eu

log() { printf '\033[0;31m%s\033[0m\n' "$*"; }

DRY=0

case "${1:-}" in
  -n|--dry-run) DRY=1 ;;
  -h|--help) sed -n '/^# \.\/debloat/,/^[^#]/{s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
  "") ;;
  *) log "Unknown option: $1"; exit 1 ;;
esac

# shellcheck source=/dev/null
[ -f /etc/os-release ] && . /etc/os-release
[ "${ID:-}" = ubuntu ] || { log "Ubuntu only"; exit 1; }

# install --desktop has to come first: greetd to log in with once GDM is gone, and the desktop base
# (iwd, sound, Bluetooth...) installed by hand, so the autoremove below keeps it

if [ "$DRY" = 0 ] && { [ "$(readlink -f /etc/systemd/system/display-manager.service)" != /usr/lib/systemd/system/greetd.service ] \
  || ! apt-mark showmanual | grep -qx iwd; }; then
  log "Run ./install --desktop first"; exit 1
fi

# What goes. The metapackages and session first; `--autoremove` then takes the ~350 packages only they
# pulled in (GNOME apps, tracker, evolution-data-server, ibus, cloud-init, sssd, apport, printer drivers...)

REMOVE="
  ubuntu-desktop ubuntu-desktop-minimal ubuntu-session ubuntu-settings gdm3
  gnome-shell gnome-shell-common gnome-session gnome-settings-daemon gnome-control-center
  nautilus ptyxis gnome-terminal yelp localsearch tinysparql evolution-data-server
  xdg-desktop-portal-gnome gnome-online-accounts gnome-software ubuntu-docs
  apport apport-core-dump-handler apport-symptoms python3-apport python3-problem-report
  cups cups-browsed cups-bsd cups-client cups-common cups-core-drivers cups-daemon
  cups-filters cups-filters-core-drivers cups-ipp-utils cups-ppdc cups-server-common
  pavucontrol
  ubuntu-wallpapers ubuntu-wallpapers-resolute
  helium-bin brave-browser brave-keyring claude-desktop bat thunar thunar-data zathura zathura-pdf-poppler
  switcheroo-control iio-sensor-proxy accountsservice
  networkd-dispatcher avahi-daemon avahi-utils libnss-mdns ipp-usb rsyslog fprintd libpam-fprintd playerctl
  kitty kitty-doc kitty-shell-integration kitty-terminfo fuzzel
  alacritty wezterm terminator tilix konsole xfce4-terminal lxterminal gnome-console qterminal
  wlsunset
  bspwm sxhkd polybar cwm spectrwm
  htop zsh nvi xdotool ripgrep
  rxvt-unicode xterm suckless-tools xss-lock scrot xclip redshift xinit
  xauth xinput x11-xserver-utils
  xserver-xorg xserver-xorg-core xserver-xorg-input-all xserver-xorg-input-libinput
  xserver-xorg-input-wacom xserver-xorg-video-all xserver-xorg-video-amdgpu
  xserver-xorg-video-ati xserver-xorg-video-fbdev xserver-xorg-video-intel
  xserver-xorg-video-nouveau xserver-xorg-video-qxl xserver-xorg-video-radeon xserver-xorg-video-vesa
  i3lock maim xcompmgr xwallpaper autorandr xsettingsd
  delta lxpolkit virt-manager discord surf xserver-xorg-legacy
  libgtk4-layer-shell0 libgtk4-layer-shell-dev
  libchewing3-data libopencc-data libpinyin-data
  network-manager network-manager-gnome network-manager-openvpn network-manager-pptp wpasupplicant
  ibus ibus-table-cangjie3 ibus-table-cangjie5 ibus-table-cangjie-big m17n-db
  hunspell-en-au hunspell-en-ca hunspell-en-gb hunspell-en-za wbritish
  gvfs gvfs-common gvfs-daemons gvfs-libs gvfs-backends
  rhythmbox rhythmbox-data rhythmbox-plugins rhythmbox-plugin-alternative-toolbar
  exo-utils xfconf xscreensaver xscreensaver-data xscreensaver-gl"
# Services of what stays that nothing here needs: no modem, no printer discovery on the network, no Ubuntu
# Pro or MOTD news

DISABLE="ModemManager.service motd-news.timer ua-timer.timer ubuntu-advantage.service"
# ~/.config leftovers of the removed apps and of the browsers' first-run probes

STALE="org.gnome.Ptyxis nautilus evolution goa-1.0 gnome-initial-setup gnome-initial-setup-done
  tiling-assistant ubuntu-insights yelp ibus update-notifier gnome-xdg-terminals.list
  ubuntu-xdg-terminals.list xdg-terminals.list monitors.xml monitors.xml~
  chromium microsoft-edge opera vivaldi
  discord i3 sway waybar geoclue-2.0 xterm"
installed() { dpkg-query -W -f='${db:Status-Status}\n' "$1" 2>/dev/null | grep -qx installed; }

STEAM_SNAP=0
snap_list=
if installed snapd; then
  if ! snap_list=$(LC_ALL=C snap list 2>&1); then
    case $snap_list in
      'No snaps are installed yet'*) snap_list= ;;
      *) log "Cannot list installed snaps. Cleanup stopped: $snap_list"; exit 1 ;;
    esac
  fi
fi
if printf '%s\n' "$snap_list" | awk '$1 == "steam" {found = 1} END {exit !found}'; then
  STEAM_SNAP=1
else
  REMOVE="$REMOVE snapd"
fi

set --

for p in $REMOVE; do installed "$p" && set -- "$@" "$p"; done

# Steam packages can be marked automatic, including the 32-bit runtime.
keep_pattern='^(steam|gamemode|lolka|xwayland)($|[-:])'
[ "$STEAM_SNAP" = 0 ] || keep_pattern="$keep_pattern|^snapd($|:)"
keep_option="APT::NeverAutoRemove::=$keep_pattern"
simulation=
if [ "$#" -gt 0 ]; then
  simulation=$(LC_ALL=C apt-get -s -o "$keep_option" purge --autoremove "$@")
  if printf '%s\n' "$simulation" | awk -v keep="$keep_pattern" '/^(Purg|Remv) / && $2 ~ keep {found = 1} END {exit !found}'; then
    log 'APT would remove a gaming package or snapd needed by Steam. Cleanup stopped.'
    exit 1
  fi
fi

if [ "$DRY" = 1 ]; then
  if [ "$STEAM_SNAP" = 1 ]; then
    log 'Keeping snaps because Steam uses snapd.'
  else
    log "Snaps that would go:"
    printf '%s\n' "$snap_list" | awk 'NR > 1 {print "  " $1}'
  fi
  apt-mark showmanual | grep -qx iwd \
    || log "(install --desktop has not run yet: the list still has the desktop base it would keep)"

  log "apt would remove:"
  printf '%s\n' "$simulation" | awk '/^Purg|^Remv/ {print "  " $2}'

  log "Services that would be disabled:"

  for u in $DISABLE; do systemctl -q is-enabled "$u" 2>/dev/null && echo "  $u"; done

  log "$HOME/.config entries that would go:"

  for c in $STALE; do [ -e "$HOME/.config/$c" ] && echo "  $c"; done
  exit 0
fi

# Snaps ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# apps before the bases and snapd they run on; snapd's own purge then drops /snap and its state

if [ "$STEAM_SNAP" = 0 ] && [ -n "$snap_list" ]; then
  log "Removing snaps"
  # `snap list` notes: base for the bases, snapd for snapd; content snaps (gnome-46-2404, mesa-2404) only

  # go once nothing uses them, hence the rounds

  snaps() { snap list 2>/dev/null | awk -v base="$1" 'NR > 1 && $NF != "snapd" && ($NF == "base") == base {print $1}'; }

  for _ in 1 2 3; do
    for s in $(snaps 0); do sudo snap remove --purge "$s" || true; done
  done

  for s in $(snaps 1); do sudo snap remove --purge "$s" || true; done
fi

# Ubuntu's firefox and chromium debs are snap installers that pull snapd back in; pin it out

if [ "$STEAM_SNAP" = 0 ]; then
  log "Blocking snapd"
  sudo tee /etc/apt/preferences.d/no-snapd.pref > /dev/null <<'EOF'
# debloat: no snapd, nor the transitional debs that install a snap

Package: snapd
Pin: release a=*
Pin-Priority: -10
EOF
else
  log 'Keeping snaps because Steam uses snapd.'
fi

# GNOME ─────────────────────────────────────────────────────────────────────────────────────────────────────────────

log "Removing unused packages"
[ "$#" -eq 0 ] || sudo apt-get -o "$keep_option" purge -y --autoremove "$@"

case $(cat /proc/sys/kernel/core_pattern) in
  '|/usr/share/apport/apport '*) sudo sysctl -w kernel.core_pattern=core ;;
esac

# Services and configs ──────────────────────────────────────────────────────────────────────────────────────────────

log "Disabling unused services"

for u in $DISABLE; do sudo systemctl disable --now "$u" 2>/dev/null || true; done

log "Removing configs of the removed apps"

for c in $STALE; do rm -rf "${HOME:?}/.config/$c"; done

log "Done. Reboot: greetd takes over the login."
