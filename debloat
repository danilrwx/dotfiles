#!/usr/bin/env bash
# ./debloat [-n]
#   Strip a stock Ubuntu desktop down to what the i3 session from `./install --desktop` runs on:
#   every snap and snapd itself (blocked from coming back), GNOME, GDM and the Ubuntu desktop extras, the
#   sway stack from before, NetworkManager (iwd has Wi-Fi), the services nothing here uses and the configs
#   the removed apps left in ~/.config.
#   Run `./install --desktop` first, so greetd is there to log in with once GDM is gone.
#   -n  dry run: show what apt would remove, change nothing
set -euo pipefail

log() { echo -e "\033[0;31m$1\033[0m"; }

DRY=0
case "${1:-}" in
  -n|--dry-run) DRY=1 ;;
  -h|--help) sed -n '/^# \.\/debloat/,/^[^#]/{s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
  "") ;;
  *) log "Unknown option: $1"; exit 1 ;;
esac

[ -f /etc/os-release ] && . /etc/os-release
[ "${ID:-}" == ubuntu ] || { log "Ubuntu only"; exit 1; }

# install --desktop has to come first: greetd to log in with once GDM is gone, and the desktop base
# (iwd, sound, Bluetooth...) installed by hand, so the autoremove below keeps it
if [ "$DRY" == 0 ] && { [ "$(readlink -f /etc/systemd/system/display-manager.service)" != /usr/lib/systemd/system/greetd.service ] \
  || ! apt-mark showmanual | grep -qx iwd; }; then
  log "Run ./install --desktop first"; exit 1
fi

# What goes. The metapackages and session first; `--autoremove` then takes the ~350 packages only they
# pulled in (GNOME apps, tracker, evolution-data-server, ibus, cloud-init, sssd, apport, printer drivers...)
REMOVE=(
  ubuntu-desktop ubuntu-desktop-minimal ubuntu-session ubuntu-settings gdm3
  gnome-shell gnome-shell-common gnome-session gnome-settings-daemon gnome-control-center
  nautilus ptyxis gnome-terminal yelp localsearch tinysparql evolution-data-server
  xdg-desktop-portal-gnome gnome-online-accounts gnome-software ubuntu-docs
  snapd wayland-scroll-factor ghostty foot
  # Firefox, Mozilla's .deb an older install put in, Chrome being the browser
  firefox
  # the sway session, given up for i3 on X11, and pavucontrol (bin/wm-ctl picks the devices)
  sway swaybg swayidle swaylock wmenu mako-notifier grim slurp wl-clipboard xdg-desktop-portal-wlr wob xwayland
  pavucontrol
  # Openbox and its bar, awesome: tried as sessions next to i3 and dropped
  openbox dzen2 stalonetray wmctrl awesome
  # Ubuntu's wallpapers under a black root
  ubuntu-wallpapers ubuntu-wallpapers-resolute
  # the heavy terminals, alacritty is the one; not xterm, xinit and steam-libs depend on it
  kitty wezterm terminator tilix konsole xfce4-terminal lxterminal gnome-console qterminal
  # NetworkManager stays off for iwd and systemd-networkd (install), so it goes with its plugins and the
  # wpa_supplicant iwd replaces
  network-manager network-manager-gnome network-manager-openvpn network-manager-pptp wpasupplicant
  # input methods and dictionaries the Ubuntu installer marks as manual
  ibus ibus-table-cangjie3 ibus-table-cangjie5 ibus-table-cangjie-big m17n-db
  hunspell-en-au hunspell-en-ca hunspell-en-gb hunspell-en-za wbritish zenity
)
# Services of what stays that nothing here needs: no modem, no printer discovery on the network, no Ubuntu
# Pro or MOTD news
DISABLE=(ModemManager.service cups-browsed.service motd-news.timer ua-timer.timer ubuntu-advantage.service)
# ~/.config leftovers of the removed apps and of the browsers' first-run probes
STALE=(org.gnome.Ptyxis nautilus evolution goa-1.0 gnome-initial-setup gnome-initial-setup-done
  tiling-assistant ubuntu-insights yelp ibus update-notifier gnome-xdg-terminals.list
  ubuntu-xdg-terminals.list xdg-terminals.list monitors.xml monitors.xml~
  BraveSoftware chromium microsoft-edge opera vivaldi)
installed() { dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null | grep -qx installed; }
remove=(); for p in "${REMOVE[@]}"; do installed "$p" && remove+=("$p"); done

if [ "$DRY" == 1 ]; then
  log "Snaps that would go:"
  command -v snap > /dev/null && snap list 2>/dev/null | awk 'NR > 1 {print "  " $1}'
  apt-mark showmanual | grep -qx iwd \
    || log "(install --desktop has not run yet: the list still has the desktop base it would keep)"
  log "apt would remove:"
  LC_ALL=C apt-get -s purge --autoremove "${remove[@]}" | awk '/^Purg|^Remv/ {print "  " $2}'
  log "Services that would be disabled:"
  for u in "${DISABLE[@]}"; do systemctl -q is-enabled "$u" 2>/dev/null && echo "  $u"; done
  log "~/.config entries that would go:"
  for c in "${STALE[@]}"; do [ -e "$HOME/.config/$c" ] && echo "  $c"; done
  exit 0
fi

# Snaps ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# apps before the bases and snapd they run on; snapd's own purge then drops /snap and its state
if command -v snap > /dev/null; then
  log "Removing snaps"
  # `snap list` notes: base for the bases, snapd for snapd; content snaps (gnome-46-2404, mesa-2404) only
  # go once nothing uses them, hence the rounds
  snaps() { snap list 2>/dev/null | awk -v base="$1" 'NR > 1 && $NF != "snapd" && ($NF == "base") == base {print $1}'; }
  for _ in 1 2 3; do
    for s in $(snaps 0); do sudo snap remove --purge "$s" || true; done
  done
  for s in $(snaps 1); do sudo snap remove --purge "$s" || true; done
fi
# Ubuntu's firefox and chromium debs are snap installers that pull snapd back in; pin it out
log "Blocking snapd"
sudo tee /etc/apt/preferences.d/no-snapd.pref > /dev/null <<'EOF'
# debloat: no snapd, nor the transitional debs that install a snap
Package: snapd
Pin: release a=*
Pin-Priority: -10
EOF

# GNOME ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
log "Removing GNOME, GDM and snapd"
sudo apt purge -y --autoremove "${remove[@]}"
rm -rf "$HOME/snap"
sudo rm -rf /snap /var/snap /var/lib/snapd /var/cache/snapd


# Services and configs ──────────────────────────────────────────────────────────────────────────────────────────────
log "Disabling unused services"
for u in "${DISABLE[@]}"; do sudo systemctl disable --now "$u" 2>/dev/null || true; done
log "Removing configs of the removed apps"
for c in "${STALE[@]}"; do rm -rf "${HOME:?}/.config/$c"; done
# the links install made for sway, mako and kitty point at nothing now
for l in sway mako kitty; do [ -L "$HOME/.config/$l" ] && [ ! -e "$HOME/.config/$l" ] && rm "$HOME/.config/$l"; done
# dwm and st, built into /usr/local by older installs (alacritty is the terminal now), and dwm's session
sudo rm -f /usr/local/bin/dwm /usr/local/share/man/man1/dwm.1 /usr/share/xsessions/dwm.desktop \
  /usr/local/bin/st /usr/local/share/man/man1/st.1

# What older installs left ───────────────────────────────────────────────────────────────────────────────────────────
# fonts downloaded before the archive's fonts-iosevka, fonts-font-awesome and fonts-noto-color-emoji: the
# patched Iosevka Nerd Fonts, Symbols Nerd Font Mono, Apple Color Emoji
rm -f "$HOME"/.local/share/fonts/IosevkaNerdFont*.ttf "$HOME"/.local/share/fonts/SymbolsNerdFontMono-Regular.ttf \
  "$HOME"/.local/share/fonts/AppleColorEmoji.ttf
fc-cache -f
# Docker Inc's docker-ce and its apt repo (get.docker.com), for the archive's docker.io that install puts in;
# /var/lib/docker, the images and containers, stays for it
if dpkg-query -W -f='${db:Status-Status}' docker-ce 2>/dev/null | grep -qx installed; then
  log "Moving from Docker Inc's docker-ce to the archive's docker.io"
  sudo apt remove -y docker-ce docker-ce-cli docker-ce-rootless-extras containerd.io docker-buildx-plugin \
    docker-compose-plugin docker-model-plugin
  sudo rm -f /etc/apt/sources.list.d/docker.list /etc/apt/sources.list.d/docker.sources /etc/apt/keyrings/docker.asc
  sudo apt update -y && sudo apt install -y docker.io docker-compose-v2 docker-buildx
  sudo systemctl enable --now docker.socket
fi
# Mozilla's apt repo, its pin and key, put in with that Firefox, and its profiles
sudo rm -f /etc/apt/sources.list.d/mozilla.sources /etc/apt/preferences.d/mozilla /etc/apt/keyrings/packages.mozilla.org.asc
rm -rf "$HOME/.mozilla" "$HOME/.cache/mozilla" "$HOME/.config/mozilla"
# the dpkg leftovers of what went (the "rc" packages: their configs), and i3's debug-log session hidden
# from tuigreet, the package's own; diverted, so an upgrade does not bring it back
rc=$(dpkg -l | awk '/^rc/ {print $2}')
[ -n "$rc" ] && sudo apt purge -y $rc
[ -f /usr/share/xsessions/i3-with-shmlog.desktop ] \
  && sudo dpkg-divert --quiet --local --rename --add /usr/share/xsessions/i3-with-shmlog.desktop

# the document portal and its permission store, which an older install masked: xdg-desktop-portal exits
# without them
[ -n "${XDG_RUNTIME_DIR:-}" ] && systemctl --user unmask xdg-document-portal.service xdg-permission-store.service

log "Done. Reboot: greetd takes over the login."
