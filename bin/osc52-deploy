#!/usr/bin/env bash

# Deploy the osc52 clipboard bundle to one or more hosts over SSH: stream the
# bundle in, run its installer (drops ~/.osc52 and wires ~/.vimrc + ~/.tmux.conf),
# then clean up the staging dir. Idempotent per host — safe to re-run.
#   usage: osc52-deploy host [host...]      (host = ssh target or config alias)
set -euo pipefail

bundle="$(cd "$(dirname "$0")/../osc52" && pwd)"
[ -f "$bundle/install.sh" ] || { echo "bundle not found at $bundle" >&2; exit 1; }
[ $# -gt 0 ] || { echo "usage: $(basename "$0") host [host...]" >&2; exit 1; }

rc=0
for host in "$@"; do
  echo "==> $host"
  if tar -C "$bundle" -cf - . \
     | ssh "$host" 'd=$(mktemp -d) && tar -C "$d" -xf - && bash "$d/install.sh"; r=$?; rm -rf "$d"; exit $r'; then
    echo "    ok — reload tmux (tmux kill-server) and restart vim on $host"
  else
    echo "    FAILED on $host" >&2
    rc=1
  fi
done
exit $rc
