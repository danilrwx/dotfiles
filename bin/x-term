#!/bin/sh
state=${XDG_STATE_HOME:-$HOME/.local/state}/theme
if [ ! -f "$state/alacritty.toml" ]; then
	current=$(basename "$(readlink "$state/theme.toml")" .toml)
	"$HOME/dotfiles/bin/theme" quick "${current:-kitty}" || exit 1
fi
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
opts=
while [ $# -gt 0 ] && [ "$1" != -e ]; do
	o=$1
	case $o in -c) o=--class ;; -t) o=--title ;; esac
	opts="$opts $(q "$o")"
	shift
done
[ "$1" = -e ] && shift
[ $# -gt 0 ] || set -- "${SHELL:-/bin/sh}"
eval "exec alacritty --config-file \"\$state/alacritty.toml\" $opts -e \"\$@\""
