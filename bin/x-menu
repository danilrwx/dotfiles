#!/bin/sh
# x-menu PROMPT [LINES]: pick a line from stdin in wmenu using the theme's colors.
# LINES makes it a vertical list of that many rows; the callers with a single prompt (bin/x-run, bin/x-ctl,
# bin/x-drives) leave it out.
bg=#000000
fg=#ad9c84
# shellcheck source=/dev/null
[ ! -r "$HOME/.config/dotfiles/theme/menu.sh" ] || . "$HOME/.config/dotfiles/theme/menu.sh"
# A compositor's key binding can pass a tty as stdin. wmenu needs an input list or EOF.
[ -t 0 ] && exec 0< /dev/null
if [ -n "${2:-}" ]; then set -- "$1" -l "$2"; else set -- "$1"; fi
prompt=$1
shift
exec wmenu -i -p "$prompt" "$@" -f 'Fixedsys Excelsior, IosevkaTerm Nerd Font Mono 17.5px' \
	-N "${bg#\#}" -n "${fg#\#}" -S "${fg#\#}" -s "${bg#\#}" \
	-M "${fg#\#}" -m "${bg#\#}"
