#!/bin/sh
# ssh's askpass (SSH_ASKPASS: config/environment.d, ssh-agent's drop-in): the key's passphrase, or a yes to use a
# key (SSH_ASKPASS_PROMPT=confirm), asked by OpenSSH's GTK3 askpass.
# ppid_of PID: its parent's pid, the field after the name in /proc/PID/stat, which may hold spaces ("tmux: server")
ppid_of() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f2; }
# cmdline_of PID: its command line, the NULs as spaces
cmdline_of() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null; }

# who asks and what, a line each, for when a prompt comes unexpected: the time, the kind, the prompt, the asking
# process and its parent (ssh, ssh-add, ssh-agent, git...)
log="${XDG_STATE_HOME:-$HOME/.local/state}/askpass.log"
mkdir -p "${log%/*}"
printf '%s %s %s | %s < %s\n' "$(date '+%F %T')" "${SSH_ASKPASS_PROMPT:-passphrase}" "$*" \
	"$(cmdline_of "$PPID")" "$(cmdline_of "$(ppid_of "$PPID")")" >> "$log"
# sudo -A (SUDO_ASKPASS) asks with its bare "[sudo: authenticate] Password:": the dialog shows the command
# instead, sudo's own options cut off, and who runs it when that is Claude Code (an ancestor named claude)
if [ "$(cat "/proc/$PPID/comm" 2>/dev/null)" = sudo ]; then
	cmd=$(tr '\0' ' ' < "/proc/$PPID/cmdline" | sed -E 's/^[^ ]*sudo +(-[A-Za-z]+ +)*//; s/ +$//')
	[ ${#cmd} -gt 400 ] && cmd="$(printf '%s' "$cmd" | cut -c1-400)…"
	who=sudo p=$PPID
	while [ "$p" -gt 1 ] 2>/dev/null; do
		[ "$(cat "/proc/$p/comm" 2>/dev/null)" = claude ] && { who="Claude Code через sudo"; break; }
		p=$(ppid_of "$p")
	done
	exec /usr/lib/openssh/gnome-ssh-askpass "$(printf '%s хочет выполнить от root:\n\n%s\n\nПароль %s:' "$who" "$cmd" "$USER")"
fi
exec /usr/lib/openssh/gnome-ssh-askpass "$@"
