#!/bin/sh
# The Wayland session's daemons, run once by config/hypr/hyprland.conf (bin/x-autostart is i3's): portals and
# systemd user units told it is a Wayland session and which (wl-autostart Hyprland),
# the shell (ostrov: the bar, notifications, the wallpaper, the lock screen, idle and sleep: locked at 10 min
# idle and before sleep, the screen off at 15; the polkit agent, ssh's askpass, the clipboard's history)
desktop=${1:-$XDG_CURRENT_DESKTOP}
dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK HYPRLAND_INSTANCE_SIGNATURE \
	XDG_CURRENT_DESKTOP="$desktop" 2>/dev/null
# the shell: the bar, its panels, the launcher, notifications, the lock screen (~/w/ostrov, install builds it);
# started again a second after it dies (locked, it locks again at once: lock.rs), not once it quits by itself
# or the compositor is gone; its stderr in ~/.local/state/ostrov/log, the last run's in log.1
(
	log="$HOME/.local/state/ostrov"
	mkdir -p "$log"
	while [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do
		[ -f "$log/log" ] && mv "$log/log" "$log/log.1"
		RUST_BACKTRACE=1 "$HOME/.cargo/bin/ostrov" 2>>"$log/log" && break
		sleep 1
	done
) &
