#!/bin/sh
# x-bg: the background, swaybg on the theme's ground, or on the wallpaper while the terminal's opacity shows it
# (bin/theme's options). Hyprland's exec-once starts it; bin/theme restarts it when either changes.
state=${XDG_STATE_HOME:-$HOME/.local/state}/theme
. "$state/colors.sh" 2> /dev/null
wallpaper=
. "$state/options" 2> /dev/null
pkill -x swaybg 2> /dev/null
if [ "$opacity" != 1 ] && [ -n "$wallpaper" ] && [ -f "$wallpaper" ]; then
	exec swaybg -i "$wallpaper" -m fill
else
	exec swaybg -c "${bg:-#000000}"
fi
