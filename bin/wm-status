#!/bin/bash
# swaybar/i3bar status line, ported from the old i3 baraction: memory, volume, mic,
# battery, brightness, keyboard layout, date. Plain text protocol, once a second.

# wpctl prints 0.45; mawk under LC_NUMERIC=ru_RU reads that as 0
export LC_NUMERIC=C

# Icons: emoji for swaybar and i3bar; WM_STATUS_ICONS=nerd (bin/dwm-session) for dwm, whose Xft draws emoji
# at their own size and colors, so Nerd Font glyphs (Symbols Nerd Font Mono) there, in the text's color and size
if [ "$WM_STATUS_ICONS" == nerd ]; then
  I_MEM=$'\U000f035b ' I_VOL=$'\U000f057e ' I_MUTE=$'\U000f075f ' I_MIC=$'\U000f036c ' I_MICOFF=$'\U000f036d '
  I_BRI=$'\U000f00e0 ' I_RU=$'\U000f030c ' I_US=$'\U000f030c '
else
  I_MEM="🧠" I_VOL="🔊" I_MUTE="🔇" I_MIC="🎙️" I_MICOFF="🙊" I_BRI="🌞" I_RU="🇷🇺" I_US="🇺🇸"
fi

vol() {
  local icon=$I_VOL out
  out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)   # "Volume: 0.45 [MUTED]"
  [[ $out == *MUTED* ]] && icon=$I_MUTE
  echo -e " $icon$(awk '{printf "%d%%", $2*100}' <<<"$out")"
}

mic() {
  local icon=$I_MIC out
  out=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
  [[ $out == *MUTED* ]] && icon=$I_MICOFF
  echo -e " $icon$(awk '{printf "%d%%", $2*100}' <<<"$out")"
}

bat_icon() {
  local bat="/sys/class/power_supply/BAT$1"
  local vol status
  vol="$(cat "$bat/capacity")"
  status="$(cat "$bat/status")"

  local result="󰁹"
  [[ $status = "Charging" ]] && result="󰂅"

  if [[ $vol -lt 90 ]]; then
    result="󰂂"
    [[ $status = "Charging" ]] && result="󰂋"
  fi

  if [[ $vol -lt 80 ]]; then
    result="󰂁"
    [[ $status = "Charging" ]] && result="󰂊"
  fi

  if [[ $vol -lt 70 ]]; then
    result="󰂀"
    [[ $status = "Charging" ]] && result="󰢞"
  fi

  if [[ $vol -lt 60 ]]; then
    result="󰁿"
    [[ $status = "Charging" ]] && result="󰂉"
  fi

  if [[ $vol -lt 50 ]]; then
    result="󰁾"
    [[ $status = "Charging" ]] && result="󰢝"
  fi

  if [[ $vol -lt 40 ]]; then
    result="󰁽"
    [[ $status = "Charging" ]] && result="󰂈"
  fi

  if [[ $vol -lt 30 ]]; then
    result="󰁼"
    [[ $status = "Charging" ]] && result="󰂇"
  fi

  if [[ $vol -lt 20 ]]; then
    result="󰁻"
    [[ $status = "Charging" ]] && result="󰂆"
  fi

  if [[ $vol -lt 10 ]]; then
    result="󰁺"
    [[ $status = "Charging" ]] && result="󰢜"
  fi

  echo "$result"
}

bat() {
  local n=$1
  if [[ -d /sys/class/power_supply/BAT$n/ ]]; then
    echo -e " $(del)$(bat_icon $n) $(cat /sys/class/power_supply/BAT$n/capacity)%"
  fi
}

bri() {
  if command -v brightnessctl &>/dev/null; then
    local c m
    c=$(brightnessctl get)
    m=$(brightnessctl max)
    echo -e "$(del) $I_BRI$(( c * 100 / m ))%"
  fi
}

del() {
  echo -e " "
}

datef() {
  date +'%d/%m/%Y %H:%M'
}

mem() {
  echo -e " $I_MEM$(free -h | awk '/Mem/{print $3}')"
}

keyboard() {
  # sway names the active layout per keyboard; under i3, grp_led:scroll lights Scroll Lock (bit 2 of xset's
  # LED mask) while the second layout is on
  local ru=0
  if [ -n "$WAYLAND_DISPLAY" ]; then
    swaymsg -t get_inputs -r 2>/dev/null \
      | jq -r '[.[] | select(.type=="keyboard") | .xkb_active_layout_name | select(. != null)] | first // ""' \
      | grep -q '^Russian' && ru=1
  else
    (( 0x$(xset q 2>/dev/null | awk '/LED mask/ {print $NF}') & 4 )) && ru=1
  fi
  (( ru )) && echo -e " ${I_RU}RU" || echo -e " ${I_US}US"
}

while true; do
  echo "$(mem)$(del)$(vol)$(del)$(mic)$(bat 0)$(bat 1)$(bri)$(del)$(keyboard)$(del)$(datef)"
  sleep 1
done
