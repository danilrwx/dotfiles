#!/bin/bash
# i3bar and dwm status line, ported from the old i3 baraction: memory, volume, mic,
# battery, brightness, keyboard layout, date. Plain text protocol, once a second.

# wpctl prints 0.45; mawk under LC_NUMERIC=ru_RU reads that as 0
export LC_NUMERIC=C

# Icons: Nerd Font glyphs (Symbols Nerd Font Mono) in the text's color, not emoji, which draw at their own
# size and colors. WM_STATUS_ICONS=nerd (bin/dwm-session): plain glyphs, dwm sizes them by its font list.
# WM_STATUS_ICONS=pango (config/i3/config): i3bar's JSON protocol with pango markup, each glyph a size
# smaller than the text, as in dwm. WM_STATUS_ICONS=markup (config/awesome/rc.lua): the same spans as plain
# lines, for a pango textbox. Unset: the emoji.
glyph() {
  if [ "$WM_STATUS_ICONS" == pango ] || [ "$WM_STATUS_ICONS" == markup ]; then printf "<span font='Symbols Nerd Font Mono 9'>%s</span>" "$1"
  else printf '%s' "$1"; fi
}
if [ "$WM_STATUS_ICONS" == nerd ] || [ "$WM_STATUS_ICONS" == pango ] || [ "$WM_STATUS_ICONS" == markup ]; then
  I_MEM="$(glyph $'\U000f035b') " I_VOL="$(glyph $'\U000f057e') " I_MUTE="$(glyph $'\U000f075f') "
  I_MIC="$(glyph $'\U000f036c') " I_MICOFF="$(glyph $'\U000f036d') " I_BRI="$(glyph $'\U000f00e0') "
  I_RU="$(glyph $'\U000f030c') " I_US="$(glyph $'\U000f030c') "
else
  I_MEM="🧠" I_VOL="🔊" I_MUTE="🔇" I_MIC="🎙️" I_MICOFF="🙊" I_BRI="🌞" I_RU="🇷🇺" I_US="🇺🇸"
fi

vol() {
  local icon=$I_VOL out
  out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)   # "Volume: 0.45 [MUTED]"
  [[ $out == *MUTED* ]] && icon=$I_MUTE
  echo -e " $icon$(awk '{printf "%d%%", $2*100}' <<<"$out")"
}

mic() {
  local icon=$I_MIC out
  out=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
  [[ $out == *MUTED* ]] && icon=$I_MICOFF
  echo -e " $icon$(awk '{printf "%d%%", $2*100}' <<<"$out")"
}

bat_icon() {
  local bat="/sys/class/power_supply/BAT$1"
  local vol status
  vol="$(cat "$bat/capacity")"
  status="$(cat "$bat/status")"

  local result="󰁹"
  [[ $status = "Charging" ]] && result="󰂅"

  if [[ $vol -lt 90 ]]; then
    result="󰂂"
    [[ $status = "Charging" ]] && result="󰂋"
  fi

  if [[ $vol -lt 80 ]]; then
    result="󰂁"
    [[ $status = "Charging" ]] && result="󰂊"
  fi

  if [[ $vol -lt 70 ]]; then
    result="󰂀"
    [[ $status = "Charging" ]] && result="󰢞"
  fi

  if [[ $vol -lt 60 ]]; then
    result="󰁿"
    [[ $status = "Charging" ]] && result="󰂉"
  fi

  if [[ $vol -lt 50 ]]; then
    result="󰁾"
    [[ $status = "Charging" ]] && result="󰢝"
  fi

  if [[ $vol -lt 40 ]]; then
    result="󰁽"
    [[ $status = "Charging" ]] && result="󰂈"
  fi

  if [[ $vol -lt 30 ]]; then
    result="󰁼"
    [[ $status = "Charging" ]] && result="󰂇"
  fi

  if [[ $vol -lt 20 ]]; then
    result="󰁻"
    [[ $status = "Charging" ]] && result="󰂆"
  fi

  if [[ $vol -lt 10 ]]; then
    result="󰁺"
    [[ $status = "Charging" ]] && result="󰢜"
  fi

  echo "$result"
}

bat() {
  local n=$1
  if [[ -d /sys/class/power_supply/BAT$n/ ]]; then
    echo -e " $(del)$(glyph "$(bat_icon $n)") $(cat /sys/class/power_supply/BAT$n/capacity)%"
  fi
}

bri() {
  if command -v brightnessctl &>/dev/null; then
    local c m
    c=$(brightnessctl get)
    m=$(brightnessctl max)
    echo -e "$(del) $I_BRI$(( c * 100 / m ))%"
  fi
}

del() {
  echo -e " "
}

datef() {
  date +'%d/%m/%Y %H:%M'
}

mem() {
  echo -e " $I_MEM$(free -h | awk '/Mem/{print $3}')"
}

keyboard() {
  # grp_led:scroll lights Scroll Lock (bit 2 of xset's LED mask) while the second layout is on
  local ru=0
  (( 0x$(xset q 2>/dev/null | awk '/LED mask/ {print $NF}') & 4 )) && ru=1
  (( ru )) && echo -e " ${I_RU}RU" || echo -e " ${I_US}US"
}

# pango: i3bar's JSON protocol, one block per line in an endless array; the line has no " or \ to escape
if [ "$WM_STATUS_ICONS" == pango ]; then
  echo '{"version":1}'
  echo '['
fi
while true; do
  line="$(mem)$(del)$(vol)$(del)$(mic)$(bat 0)$(bat 1)$(bri)$(del)$(keyboard)$(del)$(datef)"
  if [ "$WM_STATUS_ICONS" == pango ]; then
    printf '[{"full_text":"%s","markup":"pango"}],\n' "$line"
  else
    echo "$line"
  fi
  sleep 1
done
