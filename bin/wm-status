#!/bin/bash
# The bar's status (config/eww under i3, ostrov under Hyprland): memory, volume, mic, battery,
# brightness, keyboard layout, date, and VLESS and OpenVPN while on. A JSON object a line, once a second;
# the bar draws the icons.

# wpctl prints 0.45; mawk under LC_NUMERIC=ru_RU reads that as 0
export LC_NUMERIC=C

# vol SINK|SOURCE: "PCT MUTED" from wpctl's "Volume: 0.45 [MUTED]"
vol() {
  wpctl get-volume "@DEFAULT_AUDIO_$1@" 2>/dev/null | awk '{printf "%d %s", $2 * 100, ($3 == "[MUTED]")}'
}

# batteries: [{pct, icon}], ⚡ while charging, 🪫 below 20%, 🔋 otherwise
bats() {
  local b out=()
  for b in /sys/class/power_supply/BAT*; do
    [ -d "$b" ] || continue
    local pct icon=🔋
    pct=$(cat "$b/capacity")
    if [ "$(cat "$b/status")" = Charging ]; then icon=⚡; elif (( pct < 20 )); then icon=🪫; fi
    out+=("{\"pct\":$pct,\"icon\":\"$icon\"}")
  done
  local IFS=,; echo "[${out[*]}]"
}

# vless: bin/vless's state, "" while off: 🛡️ TUN or 🔀 the system proxy, the profile, "global" in that mode
vless() {
  local how mode profile
  read -r how mode profile < <("$HOME/dotfiles/bin/vless" status)
  [ "$how" = off ] && return
  [ "$mode" = global ] && profile="${profile:0:16} global" || profile=${profile:0:16}
  if [ "$how" = tun ]; then echo "🛡️ $profile"; else echo "🔀 $profile"; fi
}

# openvpn: bin/openvpn-ctl's profile while one is up, "" while off; ⏳ while it connects
openvpn() {
  local s
  s=$("$HOME/dotfiles/bin/openvpn-ctl" status)
  [ "$s" = off ] && return
  case "$s" in
  *" connecting") echo "⏳ ${s% connecting}" ;;
  *)              echo "🔒 ${s:0:20}" ;;
  esac
}

while true; do
  read -r vp vm < <(vol SINK)
  read -r mp mm < <(vol SOURCE)
  # Hyprland names the main keyboard's layout; under X11 grp_led:scroll lights Scroll Lock (bit 2 of xset's
  # LED mask) while the second layout is on
  ru=0
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl devices -j | jq -e '.keyboards[] | select(.main) | .active_keymap | test("Russian")' > /dev/null && ru=1
  else
    (( 0x$(xset q 2>/dev/null | awk '/LED mask/ {print $NF}') & 4 )) && ru=1
  fi
  bri=$(( $(brightnessctl get) * 100 / $(brightnessctl max) ))
  # the strings through jq: a subscription's profile names carry anything
  jq -nc --arg vless "$(vless)" --arg openvpn "$(openvpn)" --arg mem "$(free -h | awk '/Mem/ {print $3}')" \
    --argjson vol "${vp:-0}" --argjson volmute "${vm:-0}" --argjson mic "${mp:-0}" --argjson micmute "${mm:-0}" \
    --argjson bats "$(bats)" --argjson bri "$bri" --argjson ru "$ru" --arg date "$(date +'%d/%m/%Y %H:%M')" \
    '{$vless, $openvpn, $mem, $vol, volmute: ($volmute == 1), $mic, micmute: ($micmute == 1), $bats, $bri,
      ru: ($ru == 1), $date}'
  sleep 1
done
