#!/usr/bin/env bash

# Watch a tmux session an agent spawned via the `tmux` skill. Sessions live on
# isolated sockets under CLAUDE_TMUX_SOCKET_DIR (default $TMPDIR/agentic-tmux-sockets).
# One match: use it; several: pick with fzf.
#
#   agent-watch       attach read-only (Detach with Ctrl-b d). Note: attaching
#                     resizes the agent's window to your terminal, which sends
#                     SIGWINCH to whatever it's running.
#   agent-watch -f    follow via capture-pane polling — zero effect on the
#                     session's geometry or process. Ctrl-C to stop.
set -euo pipefail

follow=0
case "${1:-}" in
  -f|--follow) follow=1 ;;
  '') ;;
  *) echo "usage: agent-watch [-f|--follow]" >&2; exit 2 ;;
esac

dir="${CLAUDE_TMUX_SOCKET_DIR:-${TMPDIR:-/tmp}/agentic-tmux-sockets}"

rows=()
for sock in "$dir"/*.sock; do
  [ -S "$sock" ] || continue
  while IFS= read -r name; do
    [ -n "$name" ] && rows+=("$sock"$'\t'"$name")
  done < <(tmux -S "$sock" list-sessions -F '#{session_name}' 2>/dev/null)
done

if [ "${#rows[@]}" -eq 0 ]; then
  echo "no agent tmux sessions in $dir" >&2
  exit 1
fi

if [ "${#rows[@]}" -eq 1 ]; then
  pick="${rows[0]}"
else
  pick=$(printf '%s\n' "${rows[@]}" \
    | fzf --no-sort --height=100% --delimiter='\t' --with-nth=2 \
          --header='Watch agent session (read-only)')
  [ -n "$pick" ] || exit 0
fi

IFS=$'\t' read -r sock session <<<"$pick"

if [ "$follow" -eq 0 ]; then
  exec tmux -S "$sock" attach -r -t "$session"
fi

trap 'exit 0' INT
while tmux -S "$sock" has-session -t "$session" 2>/dev/null; do
  printf '\033[H\033[2J== %s (Ctrl-C to stop) ==\n\n' "$session"
  tmux -S "$sock" capture-pane -p -J -t "$session"
  sleep 0.5
done
echo "session '$session' ended"
