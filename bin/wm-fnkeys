#!/bin/sh
# Media and HONOR Fn keys under i3. Levels (volume, mic, brightness)
# are a dunst progress card, states (mute, touchpad, profile, camera) a
# notification card. The performance and camera keys are acted on by
# honor-hotkey-actions.service; here we only show what it did.
# wpctl prints 0.45; mawk under LC_NUMERIC=ru_RU reads that as 0
export LC_NUMERIC=C

# osd ICON TITLE [TEXT], bar ICON LEVEL: the card or the level, with an Adwaita symbolic icon (the OSD of the
# ostrov and dunst both show it)
osd() { notify-send -a fnkeys -r 9912 -t 1500 -i "$1" "$2" "${3:-}"; }
bar() { notify-send -a fnkeys -r 9913 -t 1000 -i "$1" -h "int:value:$2" "$2%"; }
# "Volume: 0.45 [MUTED]" -> 45, or 0 while muted
level() { wpctl get-volume "$1" | awk '{print /MUTED/ ? 0 : int($2 * 100 + 0.5)}'; }
# icon SINK|SOURCE LEVEL: the speaker's or the mic's, by how loud, muted at 0
icon() {
	local kind=audio-volume
	[ "$1" = "$SOURCE" ] && kind=microphone-sensitivity
	if [ "$2" -eq 0 ]; then echo "$kind-muted-symbolic"
	elif [ "$2" -lt 34 ]; then echo "$kind-low-symbolic"
	elif [ "$2" -lt 67 ]; then echo "$kind-medium-symbolic"
	else echo "$kind-high-symbolic"; fi
}
vol() { wpctl set-volume -l 1.0 "$1" "$2" && { l=$(level "$1"); bar "$(icon "$1" "$l")" "$l"; }; }
mute() {
	wpctl set-mute "$1" toggle
	if wpctl get-volume "$1" | grep -q MUTED; then osd "$(icon "$1" 0)" "$2" "muted"
	else l=$(level "$1"); osd "$(icon "$1" "$l")" "$2" "on"; bar "$(icon "$1" "$l")" "$l"; fi
}
light() { brightnessctl -q set "$1" && bar display-brightness-symbolic "$(brightnessctl -m | cut -d, -f4 | tr -d %)"; }

# on, off or toggle: through Hyprland's or sway's input settings under them, else through xinput, the pad
# by its id: xinput lists a disabled one's name as "∼ NAME", which no xinput command then finds, so it could
# not be turned back on. One at a time (flock), a toggle within half a second of the last one dropped,
# should the key arrive twice
touchpad() {
	lock=${XDG_RUNTIME_DIR:-/tmp}/wm-fnkeys-touchpad
	exec 9> "$lock"
	flock 9
	if [ "$1" = toggle ]; then
		now=$(date +%s%N)
		last=$(cat "$lock.last" 2>/dev/null || echo 0)
		[ $(( (now - last) / 1000000 )) -lt 500 ] && return
		echo "$now" > "$lock.last"
	fi
	if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
		# Hyprland's per-device setting, the touchpad by its name; its state kept in the lock's sibling, as
		# hyprctl does not report it
		pad=$(hyprctl devices -j | jq -r '[.mice[] | select(.name | test("touchpad"; "i"))][0].name')
		state=$(cat "$lock.state" 2>/dev/null || echo on)
		case $1 in
		toggle) [ "$state" = on ] && state=off || state=on ;;
		*)      state=$1 ;;
		esac
		echo "$state" > "$lock.state"
		[ "$state" = on ] && set -- true || set -- false
		hyprctl -q keyword "device[$pad]:enabled" "$1"
	elif [ -n "${SWAYSOCK:-}" ]; then
		# sway's own input settings, the touchpad by its type
		state=$(swaymsg -t get_inputs -r | jq -r '[.[] | select(.type == "touchpad")][0].libinput.send_events
			| if . == "enabled" then "on" else "off" end')
		case $1 in
		toggle) [ "$state" = on ] && state=off || state=on ;;
		*)      state=$1 ;;
		esac
		[ "$state" = on ] && set -- enabled || set -- disabled
		swaymsg -q input type:touchpad events "$1"
	else
		dev=$(xinput list | grep -i -m1 touchpad | sed -n 's/.*id=\([0-9]*\).*/\1/p')
		state=$(xinput list-props "$dev" | awk '/Device Enabled/ {print $NF == 1 ? "on" : "off"}')
		case $1 in
		toggle) [ "$state" = on ] && state=off || state=on ;;
		*)      state=$1 ;;
		esac
		[ "$state" = on ] && xinput enable "$dev" || xinput disable "$dev"
	fi
	if [ "$state" = on ]; then osd input-touchpad-symbolic "Touchpad" "$state"
	else osd touchpad-disabled-symbolic "Touchpad" "$state"; fi
}

SINK=@DEFAULT_AUDIO_SINK@ SOURCE=@DEFAULT_AUDIO_SOURCE@
case ${1:-} in
vol-up)      vol $SINK 2%+ ;;
vol-down)    vol $SINK 2%- ;;
vol-mute)    mute $SINK "Volume" ;;
mic-up)      vol $SOURCE 2%+ ;;
mic-down)    vol $SOURCE 2%- ;;
mic)         mute $SOURCE "Microphone" ;;
bright-up)   light 2%+ ;;
bright-down) light 2%- ;;
touchpad-on)     touchpad on ;;
touchpad-off)    touchpad off ;;
touchpad-toggle) touchpad toggle ;;
profile)
	sleep 0.3
	p=$(powerprofilesctl get)
	osd "power-profile-$p-symbolic" "Power profile" "$p" ;;
camera)
	sleep 0.5
	[ -e /dev/video0 ] && osd camera-web-symbolic "Camera" "on" || osd camera-disabled-symbolic "Camera" "off" ;;
*)
	echo "usage: wm-fnkeys vol-up|vol-down|vol-mute|mic-up|mic-down|mic|bright-up|bright-down|" >&2
	echo "       touchpad-on|touchpad-off|touchpad-toggle|profile|camera" >&2
	exit 1 ;;
esac
