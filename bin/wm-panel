#!/bin/sh
# The bar's panels (config/eww): wm-panel NAME toggles the window NAME, wm-panel NAME close closes it. The
# variable of the same name tells the panel's polls to run only while it is open; one panel at a time
name=$1
open=$(eww active-windows | grep -c "^$name:")
for w in ctl calendar; do eww close "$w" 2>/dev/null; eww update "$w=false"; done
[ "${2:-}" = close ] || [ "$open" -gt 0 ] || { eww update "$name=true"; eww open "$name"; }
