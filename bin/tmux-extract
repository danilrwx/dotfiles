#!/usr/bin/env bash

# fzf-based replacement for the extrakto tmux plugin: no python, no TPM, works
# anywhere fzf+tmux exist (incl. devbox containers). Opens on prefix+Tab; inside
# fzf, Tab types the picked token (word/path/url) into the pane, Enter copies it
# to the clipboard (via OSC52, so it also works over SSH/devbox).
#
# The pane is resolved via display-message rather than passed in: display-popup
# does NOT expand #{pane_id} in its command, so we ask tmux from the popup.
set -euo pipefail

extract() {
  grep -oE '(https?://|git@|ssh://|file://)?[[:alnum:]_@%./:~+-]{2,}' | awk '!seen[$0]++'
}

if [ "${1:-}" = "--selftest" ]; then
  out=$(printf 'see https://example.com/x and /etc/hosts foo\n' | extract)
  printf '%s\n' "$out" | grep -qx 'https://example.com/x' || { echo "FAIL url"; exit 1; }
  printf '%s\n' "$out" | grep -qx '/etc/hosts'            || { echo "FAIL path"; exit 1; }
  echo ok; exit 0
fi

pane=$(tmux display-message -p '#{pane_id}')

out=$(tmux capture-pane -pJ -t "$pane" -S -200 | extract \
  | fzf --no-sort --tac --height=100% --expect=tab,enter) || exit 0
key=$(printf '%s\n' "$out" | sed -n 1p)
sel=$(printf '%s\n' "$out" | sed -n 2p)
[ -n "$sel" ] || exit 0

case "$key" in
  tab) tmux send-keys -t "$pane" -l -- "$sel" ;;      # insert into the pane
  *)   printf '%s' "$sel" | tmux load-buffer -w - ;;  # enter: copy to clipboard
esac
