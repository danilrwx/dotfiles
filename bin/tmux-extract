#!/usr/bin/env bash

# fzf-based replacement for the extrakto tmux plugin: no python, no TPM, works
# anywhere fzf+tmux exist (incl. devbox containers). Fuzzy-pick a token
# (word/path/url) from the visible pane. mode=insert (prefix+Tab) types it into
# the pane; mode=copy (prefix+y) puts it into the tmux buffer.
set -euo pipefail

extract() {
  grep -oE '(https?://|git@|ssh://|file://)?[[:alnum:]_@%./:~+-]{2,}' | awk '!seen[$0]++'
}

if [ "${1:-}" = "--selftest" ]; then
  out=$(printf 'see https://example.com/x and /etc/hosts foo\n' | extract)
  printf '%s\n' "$out" | grep -qx 'https://example.com/x' || { echo "FAIL url"; exit 1; }
  printf '%s\n' "$out" | grep -qx '/etc/hosts'            || { echo "FAIL path"; exit 1; }
  echo ok; exit 0
fi

pane="${1:?pane id required}"
mode="${2:-insert}"

sel=$(tmux capture-pane -pJ -t "$pane" -S -200 | extract | fzf --no-sort --tac) || exit 0
[ -n "$sel" ] || exit 0

case "$mode" in
  copy) printf '%s' "$sel" | tmux load-buffer - ;;
  *)    tmux send-keys -t "$pane" -l -- "$sel" ;;
esac
