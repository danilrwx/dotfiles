#!/bin/sh
# theme [NAME]: the colour theme, one of config/themes/: its ground, text and 16 ANSI colours, and two options
# over it: the ground plain (black, white on a light theme) or the theme's own (bg), and the terminal's opacity
# (opacity: foot's alpha, by bin/x-term). A theme is dark or light by its ground's luminance, and what has the
# two modes takes it: Claude's base, GTK's theme, the portal's color-scheme. The terminal, foot, gets the palette
# as OSC escapes, the open windows at once and the new ones by bin/x-term; nvim (plugin/colors.lua), tmux, fzf,
# bat and k9s take their colours from those ANSI slots, so they follow; Claude has its own theme, "dotfiles",
# written here. What wants hex, sway's borders, waybar, dunst, wmenu (bin/x-menu), swaylock (bin/x-lock), gets its
# colours written next to the link, from the ground, text, grey (bright black) and green and blue (bright), and
# is reloaded; Chrome's theme colour is the ground when it is the theme's own.
#   theme, theme list dark|light
#                         the themes, or those of one mode, the current one marked
#   theme NAME            set it
#   theme set bg plain|theme|toggle, theme set opacity 0.1-1|cycle, theme set wallpaper FILE|none
#                         an option, the current theme set again with it; the wallpaper, an image filling
#                         sway's background while the opacity is below 1, is what it shows through; the
#                         ground's colour without it
#   theme pick            an fzf of them (tmux's prefix T, in a popup), the current one's mode first: the one
#                         under the cursor tried on the terminal at once, ctrl-b the ground, ctrl-o the
#                         opacity, ctrl-t the other mode's; Enter sets it, Esc puts the old one back
#   theme quick NAME      the terminal's colours only, no reloads (pick's tries)
#   theme preview NAME    its 16 colours and a piece of C coloured as nvim colours it (plugin/colors.lua)
dir=$HOME/dotfiles/config/themes
state=${XDG_STATE_HOME:-$HOME/.local/state}/theme
mkdir -p "$state"
cur=$(basename "$(readlink "$state/theme.toml")" .toml 2>/dev/null)
# the options, kept as shell: bg_mode=plain|theme opacity=1 wallpaper=FILE (black, plain's old name, read as it)
bg_mode=plain opacity=1 wallpaper=
[ -f "$state/options" ] && . "$state/options"
[ "$bg_mode" = black ] && bg_mode=plain
# ponytail: the wallpaper's path single-quoted, one with a ' in it breaks the file
save() { printf "bg_mode=%s opacity=%s wallpaper='%s'\n" "$bg_mode" "$opacity" "$wallpaper" > "$state/options"; }
# modeof FILE: dark or light, by the theme's own ground's relative luminance
modeof() {
	sed -n 's/^background = "\(#[0-9a-fA-F]*\)"/\1/p' "$1" | awk '{
		for (i = 0; i < 3; i++) {
			c = index("0123456789abcdef", tolower(substr($0, 2 + 2 * i, 1))) * 16 - 16
			c = (c + index("0123456789abcdef", tolower(substr($0, 3 + 2 * i, 1))) - 1) / 255
			v[i] = c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4
		}
		print ((0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2] > 0.4) ? "light" : "dark")
	}'
}

case $1 in
""|list)
	# list dark|light|toggle: those of one mode; toggle the other one than the last list's (pick's ctrl-t)
	m=$2
	if [ "$m" = toggle ]; then
		[ "$(cat "$state/list" 2>/dev/null)" = light ] && m=dark || m=light
	fi
	[ -n "$m" ] && echo "$m" > "$state/list"
	for f in "$dir"/*.toml; do
		[ -z "$m" ] || [ "$(modeof "$f")" = "$m" ] || continue
		n=$(basename "$f" .toml)
		[ "$n" = "$cur" ] && echo "$n *" || echo "$n"
	done
	exit 0 ;;
pick)
	old="$bg_mode $opacity"
	m=dark
	[ -n "$cur" ] && m=$(modeof "$dir/$cur.toml")
	list="sort -k2 -r | cut -d' ' -f1"
	name=$("$0" list "$m" | eval "$list" | fzf --prompt='theme> ' --no-sort --height=100% \
		--header '^b ground ^o opacity ^t mode' \
		--bind "ctrl-t:reload($0 list toggle | $list)" \
		--bind "focus:execute-silent($0 quick {})" \
		--bind "ctrl-b:execute-silent($0 set bg toggle quick; $0 quick {})+refresh-preview" \
		--bind "ctrl-o:execute-silent($0 set opacity cycle quick; $0 quick {})+refresh-preview" \
		--preview "$0 preview {}" --preview-window=right,70%) || {
		set -- $old
		bg_mode=$1 opacity=$2; save
		[ -n "$cur" ] && "$0" quick "$cur"
		exit 0
	}
	exec "$0" "$name" ;;
set)
	case $2 in
	bg)
		case $3 in
		toggle) [ "$bg_mode" = plain ] && bg_mode=theme || bg_mode=plain ;;
		plain|theme) bg_mode=$3 ;;
		black) bg_mode=plain ;;
		*) echo "theme: bg is plain or theme" >&2; exit 1 ;;
		esac ;;
	opacity)
		case $3 in
		cycle) case $opacity in 1) opacity=0.9 ;; 0.9) opacity=0.8 ;; 0.8) opacity=0.7 ;; *) opacity=1 ;; esac ;;
		0.[1-9]|0.[1-9][0-9]|1) opacity=$3 ;;
		*) echo "theme: opacity is 0.1-1" >&2; exit 1 ;;
		esac ;;
	wallpaper)
		case $3 in
		none) wallpaper= ;;
		*) [ -f "$3" ] || { echo "theme: no file $3" >&2; exit 1; }; wallpaper=$(realpath "$3") ;;
		esac ;;
	*) echo "theme: set bg|opacity|wallpaper VALUE" >&2; exit 1 ;;
	esac
	save
	# pick's tries leave setting the theme to it
	[ "$4" = quick ] && exit 0
	[ -n "$cur" ] && exec "$0" "$cur"
	exit 0 ;;
preview) preview=1; shift ;;
quick) quick=1; shift ;;
esac
f=$dir/$1.toml
[ -f "$f" ] || { echo "theme: no $1 in $dir" >&2; exit 1; }

# val SECTION KEY: a colour of the theme, "#rrggbb"
val() { sed -n "/^\[colors\.$1\]/,/^\[/s/^$2 = \"\(#[0-9a-fA-F]*\)\"/\1/p" "$f"; }
bg=$(val primary background) fg=$(val primary foreground)
grey=$(val bright black) green=$(val bright green) blue=$(val bright blue)
mode=$(modeof "$f")
if [ "$bg_mode" = plain ]; then
	[ "$mode" = light ] && bg=#ffffff || bg=#000000
fi

if [ -n "$preview" ]; then
	# rgb HEX: "R;G;B" of it, for truecolor (the theme's own colours, not the terminal's current ones)
	rgb() { printf '%d;%d;%d' "0x$(echo "$1" | cut -c2-3)" "0x$(echo "$1" | cut -c4-5)" "0x$(echo "$1" | cut -c6-7)"; }
	c() { printf '\033[38;2;%sm' "$(rgb "$1")"; }
	# the theme's ground under it all, \033[K carrying it to the line's end
	r=$(printf '\033[0m\033[48;2;%sm' "$(rgb "$bg")")$(c "$fg") e=$(printf '\033[K')
	printf '%s ground %s, opacity %s%s\n%s\n' "$r" "$bg_mode" "$opacity" "$e" "$e"
	for n in black red green yellow blue magenta cyan white; do
		printf ' %s%-8s %s%-8s%s%s\n' "$(c "$(val normal $n)")" "$n" "$(c "$(val bright $n)")" "bright" "$r" "$e"
	done
	# nvim's roles: comments grey (8), definitions and flow magenta (13), calls blue (12), types cyan (14),
	# strings green (10), the rest the text
	cm=$(c "$grey") df=$(c "$(val bright magenta)") cl=$(c "$blue") ty=$(c "$(val bright cyan)") st=$(c "$green")
	cat <<-EOF
	$e
	 ${cm}// the bar's window${r}$e
	 ${df}#ifndef${r} PLANKA_BAR_H$e
	 static ${ty}int${r} ${df}bar_create${r}(struct ${ty}bar${r} *bar)$e
	 {$e
	     ${ty}xcb_generic_error_t${r} *err = ${cl}xcb_request_check${r}(bar->conn, cookie);$e
	     ${df}if${r} (err != NULL) {$e
	         ${cl}fprintf${r}(stderr, ${st}"planka: code %d\\\\n"${r}, err->error_code);$e
	         ${df}return${r} -1;$e
	     }$e
	     ${df}return${r} 0;$e
	 }$e
	 ${df}#endif${r}$e
	EOF
	printf '\033[0m'
	exit 0
fi

ln -sfn "$f" "$state/theme.toml"
# mix A B PERCENT: A with that much of B, "#rrggbb"
mix() {
	printf '#'
	for i in 2 4 6; do
		a=$(printf %d "0x$(echo "$1" | cut -c$i-$((i + 1)))") b=$(printf %d "0x$(echo "$2" | cut -c$i-$((i + 1)))")
		printf %02x $((a + (b - a) * $3 / 100))
	done
}
# the terminal's (foot, bin/x-term): its palette as OSC escapes, 4 for the 16 slots and for the 256 palette's
# darkest greys (235-238: nvim's selection, LSP references and columns, fzf's current line, tmux's pane
# borders) a tint of the ground toward the text rather than neutral grey, 10, 11 and 12 the text, the ground
# and the cursor. bin/x-term prints it to each new foot before its shell; the open ones get it on their ttys,
# the shell's under each foot, which the tmux client in it shares
i=0
{
	for r in normal bright; do
		for n in black red green yellow blue magenta cyan white; do
			printf '\033]4;%d;%s\007' "$i" "$(val "$r" "$n")"
			i=$((i + 1))
		done
	done
	for i in "235 6" "236 10" "237 14" "238 20"; do
		set -- $i
		printf '\033]4;%s;%s\007' "$1" "$(mix "$bg" "$fg" "$2")"
	done
	# the ground with the opacity as its alpha, in percent (foot takes URxvt's [N] before the colour), so the
	# open terminals change their see-through at once, not only the new ones
	printf '\033]10;%s\007\033]11;[%s]%s\007\033]12;%s\007' "$fg" \
		"$(awk -v o="$opacity" 'BEGIN { printf "%d", o * 100 + 0.5 }')" "$bg" "$fg"
} > "$state/osc"
for p in $(pgrep -x foot); do
	for t in $(ps -o tty= --ppid "$p"); do
		[ -w "/dev/$t" ] && cat "$state/osc" > "/dev/$t"
	done
done
# quick: the terminal only, and what takes the terminal's colours (nvim, tmux, fzf, k9s)
[ -n "$quick" ] && exit 0

# wmenu's (bin/x-menu), swaylock's (bin/x-lock) and the status' (bin/x-status), sourced
printf 'bg=%s fg=%s grey=%s green=%s blue=%s yellow=%s red=%s\n' "$bg" "$fg" "$grey" "$green" "$blue" \
	"$(val bright yellow)" "$(val bright red)" > "$state/colors.sh"
sel=$(mix "$bg" "$fg" 20) red=$(val bright red)
# sway's: the background, the wallpaper while the opacity shows it (below 1), else the ground's colour, and the
# borders, the focused one green, the rest the ground; a file its config includes at the start, and each line
# sent to the running one
{
	if [ "$opacity" != 1 ] && [ -f "$wallpaper" ]; then printf 'output * bg "%s" fill\n' "$wallpaper"
	else printf 'output * bg %s solid_color\n' "$bg"; fi
	printf 'client.focused %s %s %s %s %s\n' "$green" "$bg" "$fg" "$green" "$green"
	for k in focused_inactive unfocused; do printf 'client.%s %s %s %s %s %s\n' "$k" "$bg" "$bg" "$fg" "$bg" "$bg"; done
	printf 'client.urgent %s %s %s %s %s\n' "$red" "$bg" "$fg" "$red" "$red"
} > "$state/sway.conf"
[ -n "$SWAYSOCK" ] && while read -r l; do swaymsg -q "$l"; done < "$state/sway.conf"
# waybar's (config/waybar/style.css imports it), reloaded by its USR2
printf '@define-color theme_bg %s;\n@define-color theme_fg %s;\n@define-color theme_grey %s;\n@define-color theme_green %s;\n' \
	"$bg" "$fg" "$grey" "$green" > "$state/waybar.css"
pkill -USR2 -x waybar
# dunst's, as the bar and the borders look: the ground and the text, the frame green as a focused window's (grey for a
# low urgency, red for a critical one), the progress bar green, and as see-through as the terminal: the ground's
# alpha the opacity's, dunst's own transparency being X's alone; a drop-in, kept out of git (.gitignore)
mkdir -p "$HOME/.config/dunst/dunstrc.d"
cbg=$bg$(awk -v o="$opacity" 'BEGIN { printf "%02x", o * 255 + 0.5 }')
{
	printf '[global]\n    background = "%s"\n    foreground = "%s"\n    frame_color = "%s"\n    highlight = "%s"\n' \
		"$cbg" "$fg" "$green" "$green"
	for u in "low $grey" "normal $green" "critical $red"; do
		set -- $u
		printf '[urgency_%s]\n    background = "%s"\n    foreground = "%s"\n    frame_color = "%s"\n' "$1" "$cbg" "$fg" "$2"
	done
} > "$HOME/.config/dunst/dunstrc.d/theme.conf"
# GTK's: adw-gtk3's and libadwaita's named colours (adw-gtk3 the theme named below), the ground
# and text, the views and popovers a shade up, the accent its blue; ~/.config/gtk-{3,4}.0/gtk.css link here
# (install), read by each app as it starts
{
	for k in window headerbar theme; do printf '@define-color %s_bg_color %s;\n' "$k" "$bg"; done
	for k in view popover dialog; do printf '@define-color %s_bg_color %s;\n' "$k" "$(mix "$bg" "$fg" 5)"; done
	printf '@define-color sidebar_bg_color %s;\n@define-color card_bg_color %s;\n' "$(mix "$bg" "$fg" 3)" "$(mix "$bg" "$fg" 8)"
	for k in window view headerbar sidebar card popover dialog theme; do printf '@define-color %s_fg_color %s;\n' "$k" "$fg"; done
	printf '@define-color theme_base_color %s;\n@define-color theme_text_color %s;\n' "$(mix "$bg" "$fg" 5)" "$fg"
	printf '@define-color accent_bg_color %s;\n@define-color accent_color %s;\n@define-color accent_fg_color %s;\n' "$blue" "$blue" "$bg"
	printf '@define-color destructive_bg_color %s;\n@define-color error_color %s;\n' "$red" "$red"
	printf '@define-color theme_selected_bg_color %s;\n@define-color theme_selected_fg_color %s;\n' "$sel" "$fg"
	printf '@define-color theme_unfocused_selected_bg_color %s;\n@define-color theme_unfocused_selected_fg_color %s;\n' "$sel" "$fg"
} > "$state/gtk.css"
# GTK3's theme: outside GNOME it reads no color-scheme, so adw-gtk3 (install puts it in ~/.local/share/themes,
# libadwaita's look built on the named colours above) in the theme's mode as its gtk-theme setting, which GTK3
# on Wayland reads, the windows open now too. The portal's color-scheme for GTK4 and Chrome
if [ "$mode" = dark ]; then gtk=adw-gtk3-dark scheme=prefer-dark; else gtk=adw-gtk3 scheme=prefer-light; fi
gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2> /dev/null
# and as settings.ini, what GTK3 reads where gsettings does not reach: under Xwayland (an X11 app, or one started
# with a stale WAYLAND_DISPLAY, ssh's askpass among them), no XSETTINGS being served any more
mkdir -p "$HOME/.config/gtk-3.0"
printf '[Settings]\ngtk-theme-name=%s\ngtk-application-prefer-dark-theme=%d\ngtk-cursor-theme-name=Adwaita\ngtk-cursor-theme-size=24\n' \
	"$gtk" "$([ "$mode" = dark ] && echo 1 || echo 0)" > "$HOME/.config/gtk-3.0/settings.ini"
gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2> /dev/null ||
	gsettings set org.gnome.desktop.interface color-scheme default 2> /dev/null
# Claude Code's: a theme of its own over dark-ansi or light-ansi by the mode (/theme, "dotfiles"), its diffs a tint of the ground toward
# green and red rather than the plain slots, its message grounds a shade up, its greys the theme's
claude=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
if [ -d "$claude" ]; then
	gr=$(val bright green) up=$(mix "$bg" "$fg" 8)
	mkdir -p "$claude/themes"
	cat > "$claude/themes/dotfiles.json" <<-EOF
	{
	  "name": "dotfiles",
	  "base": "$mode-ansi",
	  "overrides": {
	    "diffAdded": "$(mix "$bg" "$gr" 22)",
	    "diffRemoved": "$(mix "$bg" "$red" 22)",
	    "diffAddedDimmed": "$(mix "$bg" "$gr" 10)",
	    "diffRemovedDimmed": "$(mix "$bg" "$red" 10)",
	    "diffAddedWord": "$(mix "$bg" "$gr" 45)",
	    "diffRemovedWord": "$(mix "$bg" "$red" 45)",
	    "userMessageBackground": "$up",
	    "userMessageBackgroundHover": "$(mix "$bg" "$fg" 12)",
	    "bashMessageBackgroundColor": "$up",
	    "memoryBackgroundColor": "$up",
	    "selectionBg": "$sel",
	    "inactive": "$grey",
	    "subtle": "$grey",
	    "promptBorder": "$grey"
	  }
	}
	EOF
fi
# k9s's: config/k9s/skin.yaml's colour names the theme's hex, into the skin config.yaml names (skins/, out of
# git); hex rather than the names as ANSI, which tcell sends as its own fixed RGB on a truecolor terminal
sed -e '/^#/d' -e "s/\bgray\b/\"$grey\"/g; s/\bblue\b/\"$blue\"/g; s/\bfuchsia\b/\"$(val bright magenta)\"/g" \
	-e "s/\byellow\b/\"$(val bright yellow)\"/g; s/\bred\b/\"$red\"/g; s/\blime\b/\"$green\"/g" \
	-e "s/\baqua\b/\"$(val bright cyan)\"/g; s/\bsel\b/\"$sel\"/g; s/\btext\b/\"$fg\"/g; s/\bground\b/\"$bg\"/g" \
	"$HOME/dotfiles/config/k9s/skin.yaml" > "$HOME/dotfiles/config/k9s/skins/theme.yaml"
# htop's scheme: its own colours on a dark theme, monochrome (reversed text for the header and the cursor) on a
# light one, where its black on green and cyan reads badly; htop writes its htoprc back on quitting, so one
# running keeps its scheme till restarted
sed -i "s/^color_scheme=.*/color_scheme=$([ "$mode" = light ] && echo 1 || echo 0)/" "$HOME/dotfiles/config/htop/htoprc"
# lazygit's: its borders and selection, which it otherwise takes from the plain green and blue; a second config
# file over config/lazygit (LG_CONFIG_FILE, .profile)
printf 'gui:\n  theme:\n    activeBorderColor: ["%s", bold]\n    inactiveBorderColor: ["%s"]\n    searchingActiveBorderColor: ["%s", bold]\n    optionsTextColor: ["%s"]\n    selectedLineBgColor: ["%s"]\n    inactiveViewSelectedLineBgColor: [bold]\n    unstagedChangesColor: ["%s"]\n' \
	"$green" "$grey" "$blue" "$blue" "$sel" "$red" > "$state/lazygit.yml"

# Chrome's: its theme colour the ground when the theme's own shows (bg theme), its own theme under plain; a
# managed policy, which Chrome watches, through install's root helper (sudo without a password, it alone)
if [ -x /usr/local/sbin/chrome-theme-color ]; then
	if [ "$bg_mode" = theme ]; then set -- "$bg"; else set --; fi
	sudo -n /usr/local/sbin/chrome-theme-color "$@" 2> /dev/null
fi

# what runs now picks them up
pgrep -x dunst > /dev/null && dunstctl reload
exit 0
