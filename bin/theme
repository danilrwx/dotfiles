#!/bin/bash
# The see-through terminal and Chrome's colour, following ostrov's wallpaper (its [widget.wallpaper] on_change
# in config/ostrov runs this; ostrov draws the wallpaper itself):
#   theme dark            everything solid: the default
#   theme dark-wall [IMG] a wallpaper (~/Pictures/wallpapers) under a see-through terminal, at the ALPHA of
#                         ostrov's bar (alacritty's window.opacity, written here)
#   theme apply           the last pick again (config/hypr, at login)
#   theme wallpapers      the wallpapers to pick from
# The pick is kept in ~/.cache/theme. Chrome's theme colour follows: under a wallpaper the colour the
# see-through bar shows over it (black at ALPHA over the picture's top strip), set as Chrome's
# BrowserThemeColor policy in the file install makes this user's; under dark the policy is cleared and
# Chrome keeps its own theme. Chrome watches the policy dir and recolours as the file changes.
state=${XDG_CACHE_HOME:-$HOME/.cache}/theme
walls=$HOME/Pictures/wallpapers
ALPHA=0.65
mkdir -p "$state"

wallpapers() {
	find "$walls" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null | sort
}

CHROME_POLICY=/etc/opt/chrome/policies/managed/dotfiles-theme.json

# barcolor IMG: black at ALPHA over the mean of the picture's top strip, where the bar lies (the picture
# stretched over the screen, the bar is about a fortieth of its height)
barcolor() {
	python3 - "$1" "$ALPHA" <<-'EOF'
	import sys
	from PIL import Image
	img = Image.open(sys.argv[1]).convert("RGB")
	a = float(sys.argv[2])
	strip = img.crop((0, 0, img.width, max(1, img.height // 40))).resize((1, 1), Image.Resampling.BOX)
	print("#%02x%02x%02x" % tuple(round((1 - a) * c) for c in strip.getpixel((0, 0))))
	EOF
}

# chrome [COLOUR]: Chrome's theme colour, or none (its own theme); nothing where install made no file
chrome() {
	[ -w "$CHROME_POLICY" ] || return 0
	if [ -n "${1:-}" ]; then printf '{ "BrowserThemeColor": "%s" }\n' "$1"; else echo '{}'; fi > "$CHROME_POLICY"
}

# wall IMG: the remembered wallpaper, and the bar's colour over it for Chrome
wall() {
	echo "$1" > "$state/wallpaper"
	chrome "$(barcolor "$1")"
}

# apply MODE [IMG]
apply() {
	local mode=$1 a
	if [ "$mode" = dark ]; then a=1; else a=$ALPHA; fi
	# alacritty's opacity, the file its config imports; it reloads it in every open window
	printf '# bin/theme: %s\n[window]\nopacity = %s\n' "$mode" "$a" > "$state/alacritty.toml"

	if [ "$mode" = dark ]; then
		chrome
	else
		wall "$2"
	fi
	echo "$mode" > "$state/mode"
}

case "${1:-}" in
dark) apply dark ;;
dark-wall)
	# the image given, else the last one, else the first in the wallpapers dir
	img=${2:+$(readlink -f "$2")}
	[ -z "$img" ] && [ -f "$state/wallpaper" ] && img=$(cat "$state/wallpaper")
	[ -f "$img" ] || img=$(wallpapers | head -1)
	[ -f "$img" ] || { echo "theme: no wallpaper; put some in $walls" >&2; exit 1; }
	apply dark-wall "$img" ;;
apply)
	if [ "$(cat "$state/mode" 2>/dev/null)" = dark-wall ]; then "$0" dark-wall; else apply dark; fi ;;
wallpapers) wallpapers ;;
*)
	echo "usage: theme dark | dark-wall [IMG] | apply | wallpapers" >&2
	exit 1 ;;
esac
