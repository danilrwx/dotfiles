#!/bin/bash
# The desktop's theme, picked in bin/wm-ctl's theme menu; the colours are the same dark ones in both:
#   theme dark            black root, everything solid: the default
#   theme dark-wall [IMG] a wallpaper (~/Pictures/wallpapers) under a see-through terminal and bar, the
#                         one ALPHA of both (st's alpha in config.def.h is the same), through xcompmgr
#   theme apply           the last pick again (bin/x-autostart, at login)
#   theme shuffle         under dark-wall, a random other wallpaper, the root alone touched: i3 runs it on
#                         every start and restart (exec_always in config/i3/config)
#   theme wallpapers      the wallpapers to pick from
# The pick is kept in ~/.cache/theme: the bar's background alpha as the X resource config/i3/config reads,
# the root, and xcompmgr, run only under a wallpaper. Chrome's theme colour follows: under a wallpaper the
# colour the see-through bar shows over it (black at ALPHA over the picture's top strip), set as Chrome's
# BrowserThemeColor policy in the file install makes this user's; under dark the policy is cleared and
# Chrome keeps its own theme. Chrome watches the policy dir and recolours as the file changes. The same
# colour goes to ~/.cache/theme/barbg for bin/wm-menu, dmenu being solid where the bar is see-through.
state=${XDG_CACHE_HOME:-$HOME/.cache}/theme
walls=$HOME/Pictures/wallpapers
ALPHA=0.65
mkdir -p "$state"

wallpapers() {
	find "$walls" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null | sort
}

CHROME_POLICY=/etc/opt/chrome/policies/managed/dotfiles-theme.json

# barcolor IMG: black at ALPHA over the mean of the picture's top strip, where the bar lies (hsetroot
# -fill stretches the picture over the screen, the bar is about a fortieth of its height)
barcolor() {
	python3 - "$1" "$ALPHA" <<-'EOF'
	import sys
	from PIL import Image
	img = Image.open(sys.argv[1]).convert("RGB")
	a = float(sys.argv[2])
	strip = img.crop((0, 0, img.width, max(1, img.height // 40))).resize((1, 1), Image.Resampling.BOX)
	print("#%02x%02x%02x" % tuple(round((1 - a) * c) for c in strip.getpixel((0, 0))))
	EOF
}

# chrome [COLOUR]: Chrome's theme colour, or none (its own theme); nothing where install made no file
chrome() {
	[ -w "$CHROME_POLICY" ] || return 0
	if [ -n "${1:-}" ]; then printf '{ "BrowserThemeColor": "%s" }\n' "$1"; else echo '{}'; fi > "$CHROME_POLICY"
}

# wall IMG: the root, the remembered wallpaper, and the bar's colour over it for dmenu and Chrome
wall() {
	local c
	hsetroot -fill "$1" > /dev/null
	echo "$1" > "$state/wallpaper"
	c=$(barcolor "$1")
	echo "$c" > "$state/barbg"
	chrome "$c"
}

# apply MODE [IMG]
apply() {
	local mode=$1 a hex
	if [ "$mode" = dark ]; then a=1; else a=$ALPHA; fi
	hex=$(printf '%02x' "$(awk -v a="$a" 'BEGIN { printf "%d", a * 255 + 0.5 }')")
	echo "theme.barbg: #000000$hex" | xrdb -merge

	pkill -x xcompmgr
	if [ "$mode" = dark ]; then
		hsetroot -solid '#000000' > /dev/null
		echo '#000000' > "$state/barbg"
		chrome
	else
		wall "$2"
		xcompmgr > /dev/null 2>&1 &   # its BadRegion errors are harmless noise
		disown
	fi
	pgrep -x i3 > /dev/null && i3-msg -q reload
	echo "$mode" > "$state/mode"
}

case "${1:-}" in
dark) apply dark ;;
dark-wall)
	# the image given, else the last one, else the first in the wallpapers dir
	img=${2:+$(readlink -f "$2")}
	[ -z "$img" ] && [ -f "$state/wallpaper" ] && img=$(cat "$state/wallpaper")
	[ -f "$img" ] || img=$(wallpapers | head -1)
	[ -f "$img" ] || { echo "theme: no wallpaper; put some in $walls" >&2; exit 1; }
	apply dark-wall "$img" ;;
apply)
	if [ "$(cat "$state/mode" 2>/dev/null)" = dark-wall ]; then "$0" dark-wall; else apply dark; fi ;;
shuffle)
	[ "$(cat "$state/mode" 2>/dev/null)" = dark-wall ] || exit 0
	last=$(cat "$state/wallpaper" 2>/dev/null)
	img=$(wallpapers | grep -vxF "$last" | shuf -n 1)
	[ -n "$img" ] && wall "$img" ;;
wallpapers) wallpapers ;;
*)
	echo "usage: theme dark | dark-wall [IMG] | apply | shuffle | wallpapers" >&2
	exit 1 ;;
esac
