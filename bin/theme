#!/bin/bash
# The wallpaper's pick remembered, following ostrov's wallpaper (its [widget.wallpaper] on_change in
# config/ostrov runs this; ostrov draws the wallpaper itself). The terminal's colours and see-through and Chrome's
# frame are ostrov's now (its apps.rs: ~/.local/state/ostrov/colors, the ostrov-theme.json policy); what this
# still writes for alacritty no config imports.
#   theme dark            everything solid: the default
#   theme dark-wall [IMG] a wallpaper (~/Pictures/wallpapers)
#   theme apply           the last pick again (config/hypr, at login)
#   theme wallpapers      the wallpapers to pick from
# The pick is kept in ~/.cache/theme.
state=${XDG_CACHE_HOME:-$HOME/.cache}/theme
walls=$HOME/Pictures/wallpapers
ALPHA=0.65
mkdir -p "$state"

wallpapers() {
	find "$walls" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null | sort
}

# wall IMG: the remembered wallpaper (Chrome's colour is ostrov's now, apps.rs)
wall() {
	echo "$1" > "$state/wallpaper"
}

# apply MODE [IMG]
apply() {
	local mode=$1 a
	if [ "$mode" = dark ]; then a=1; else a=$ALPHA; fi
	# alacritty's opacity, the file its config imports; it reloads it in every open window
	printf '# bin/theme: %s\n[window]\nopacity = %s\n' "$mode" "$a" > "$state/alacritty.toml"

	[ "$mode" = dark ] || wall "$2"
	echo "$mode" > "$state/mode"
}

case "${1:-}" in
dark) apply dark ;;
dark-wall)
	# the image given, else the last one, else the first in the wallpapers dir
	img=${2:+$(readlink -f "$2")}
	[ -z "$img" ] && [ -f "$state/wallpaper" ] && img=$(cat "$state/wallpaper")
	[ -f "$img" ] || img=$(wallpapers | head -1)
	[ -f "$img" ] || { echo "theme: no wallpaper; put some in $walls" >&2; exit 1; }
	apply dark-wall "$img" ;;
apply)
	if [ "$(cat "$state/mode" 2>/dev/null)" = dark-wall ]; then "$0" dark-wall; else apply dark; fi ;;
wallpapers) wallpapers ;;
*)
	echo "usage: theme dark | dark-wall [IMG] | apply | wallpapers" >&2
	exit 1 ;;
esac
