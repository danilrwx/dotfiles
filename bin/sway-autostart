#!/bin/bash
# Started once by sway (`exec` in config/sway/config): the shell daemons, each
# detached, sway never waits on them. The session env for portals is exported
# by the distro snippet /etc/sway/config.d/50-systemd-user.conf.

mako &                     # notifications (config/mako)
# volume/brightness bar: bin/wm-fnkeys writes 0-100 into the FIFO, tail keeps it open between writes
wob_fifo="${XDG_RUNTIME_DIR}/wob.fifo"
rm -f "$wob_fifo" && mkfifo "$wob_fifo"
tail -f "$wob_fifo" | wob &
lxpolkit &                 # polkit agent: virt-manager, udisks, ...
swayidle -w \
  timeout 600 'swaylock -f -c 000000' \
  timeout 900 'swaymsg "output * power off"' \
  resume      'swaymsg "output * power on"' \
  before-sleep 'swaylock -f -c 000000' &
