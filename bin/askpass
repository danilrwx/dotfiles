#!/usr/bin/python3
# ssh-askpass on the GNOME Shell system prompt (gcr 4 over D-Bus): the same modal dialog as the keyring
# unlock, drawn by the shell itself, so it stays above every window, dims the rest of the screen and takes
# the keyboard without the "inhibit shortcuts" prompt a client grab gets under Wayland. Covers the three
# prompts OpenSSH asks for, told apart by SSH_ASKPASS_PROMPT:
#   confirm  AddKeysToAgent/ssh-add -c: allow one use of the key. ssh-agent
#            reads exit 0 with empty output as yes, anything else as no.
#   none     a notice, e.g. "touch your security key"; ssh kills it when done,
#            and the shell drops the prompt once its caller is gone.
#   (unset)  a passphrase or PIN, printed on stdout.
# Wired to the systemd ssh-agent by config/systemd/ssh-agent-askpass.conf.
import os
import sys

import gi

gi.require_version("Gcr", "4")
from gi.repository import Gcr  # noqa: E402

text = sys.argv[1] if len(sys.argv) > 1 else "SSH"
mode = os.environ.get("SSH_ASKPASS_PROMPT", "")

# the shell shows one system prompt at a time; wait for a busy one to close
prompt = Gcr.SystemPrompt.open(60, None)
prompt.set_title("SSH")
prompt.set_message("SSH")
prompt.set_description(text)

try:
    if mode == "confirm":
        prompt.set_continue_label("Allow")
        prompt.set_cancel_label("Deny")
        sys.exit(0 if prompt.confirm_run(None) == Gcr.PromptReply.CONTINUE else 1)
    elif mode == "none":
        prompt.set_continue_label("OK")
        prompt.confirm_run(None)
    else:
        secret = prompt.password_run(None)
        if secret is None:
            sys.exit(1)
        print(secret)
finally:
    prompt.close()
