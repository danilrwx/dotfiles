#!/bin/sh
# Media and HONOR Fn keys under sway (config/sway). Levels (volume, mic, brightness)
# are a dunst progress card, states (mute, profile, camera) a
# notification card. The performance and camera keys are acted on by
# honor-hotkey-actions.service; here we only show what it did.
# wpctl prints 0.45; mawk under LC_NUMERIC=ru_RU reads that as 0
export LC_NUMERIC=C

osd() { notify-send -a fnkeys -r 9912 -t 1500 "$1" "${2:-}"; }
bar() { notify-send -a fnkeys -r 9913 -t 1000 -h "int:value:$1" "$1%"; }
# "Volume: 0.45 [MUTED]" -> 45, or 0 while muted
level() { wpctl get-volume "$1" | awk '{print /MUTED/ ? 0 : int($2 * 100 + 0.5)}'; }
# a level key unmutes first, so the card shows the kept level, not 0
vol() { wpctl set-mute "$1" 0 && wpctl set-volume -l 1.0 "$1" "$2" && bar "$(level "$1")"; }
mute() {
	wpctl set-mute "$1" toggle
	if wpctl get-volume "$1" | grep -q MUTED; then m=off; osd "$2" "muted"; else m=on; osd "$2" "on"; bar "$(level "$1")"; fi
	# the keycap's mic LED follows the built-in mic's ALSA switch alone (audio-micmute trigger), so the mic key
	# sets that switch as the default mic's mute too: lit with the headset's mic muted as well
	[ "$1" = "$SOURCE" ] && amixer -q -D hw:sofhdadsp cset name='Dmic0 Capture Switch' "$m" 2>/dev/null
}
light() { brightnessctl -q set "$1" && bar "$(brightnessctl -m | cut -d, -f4 | tr -d %)"; }

SINK=@DEFAULT_AUDIO_SINK@ SOURCE=@DEFAULT_AUDIO_SOURCE@
case ${1:-} in
vol-up)      vol $SINK 2%+ ;;
vol-down)    vol $SINK 2%- ;;
vol-mute)    mute $SINK "Volume" ;;
mic-up)      vol $SOURCE 2%+ ;;
mic-down)    vol $SOURCE 2%- ;;
mic)         mute $SOURCE "Microphone" ;;
bright-up)   light 2%+ ;;
bright-down) light 2%- ;;
profile)
	sleep 0.3
	osd "Power profile" "$(powerprofilesctl get)" ;;
camera)
	sleep 0.5
	[ -e /dev/video0 ] && osd "Camera" "on" || osd "Camera" "off" ;;
*)
	echo "usage: x-fnkeys vol-up|vol-down|vol-mute|mic-up|mic-down|mic|bright-up|bright-down|" >&2
	echo "       profile|camera" >&2
	exit 1 ;;
esac
