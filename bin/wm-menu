#!/bin/sh
# rofi for i3, a dmenu-like line in the bar's middle, see-through (config/rofi/wm-menu.rasi), matching case-insensitively:
#   wm-menu             launch an app: rofi's own list of the .desktop entries (drun), with its history of
#                       what was launched first
#   wm-menu pick PROMPT choose a line of stdin, print it
export PATH="$HOME/dotfiles/private/bin:$HOME/dotfiles/bin:$HOME/.local/bin:$HOME/go/bin:$PATH"
# as tall as the bar (config/eww); the DPI rofi does not take from Xft.dpi itself
h=$(xwininfo -root -tree | awk '/"Eww - bar"/ { split($(NF-1), g, /[x+]/); print g[2]; exit }')
rofi() {
	command rofi -i -dpi "$(xrdb -get Xft.dpi 2>/dev/null || echo 96)" -theme "$HOME/dotfiles/config/rofi/wm-menu.rasi" \
		-theme-str "window { height: ${h:-50}px; }" "$@"
}
if [ "${1:-}" = pick ]; then
	rofi -dmenu -p "$2"
else
	rofi -show drun -display-drun '' -drun-display-format '{name}'
fi
