#!/bin/sh
# helium-search [WORDS]: a page in Helium on a search (or an address) — WORDS, or what our menu (bin/x-menu) takes
# when there are none. bin/web-url decides search or address; Helium gets the URL, so a running instance opens a tab.
if [ $# -gt 0 ]; then text=$*; else
	text=$("$HOME/dotfiles/bin/x-menu" 'Search:' < /dev/null) || exit 0
fi
[ -n "$text" ] || exit 0
url=$("$HOME/dotfiles/bin/web-url" "$text") || exit 0
("$HOME/dotfiles/bin/helium" "$url" > /dev/null 2>&1 &)
