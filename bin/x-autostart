#!/bin/bash
# The X11 session setup, run by i3 (`exec` in config/i3/config): the keyboard (Caps
# as Ctrl is etc/udev/hwdb.d, below the keymap), Xresources for the scale, a black root, then the daemons, each
# detached.

xrdb -merge "$HOME/.Xresources"
setxkbmap -layout us,ru -option '' -option grp:ctrl_space_toggle,grp_led:scroll
# the theme picked last (bin/theme): its colours, wallpaper and compositor, black by default
"$HOME/dotfiles/bin/theme" apply
# portals and systemd user units see this session
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP 2>/dev/null

# the bar (config/eww): GTK at the panel's 2x, the daemon, then its window
GDK_SCALE=2 GDK_DPI_SCALE=0.5 eww daemon && eww open bar
dunst &                    # notifications (config/dunst)
lxpolkit &                 # polkit agent: virt-manager, udisks, ...
# lock at 10 min idle and before sleep; screens off at 15 min through DPMS
xset s 600 600 dpms 900 900 900
xss-lock --transfer-sleep-lock -- i3lock -n -c 000000 &
