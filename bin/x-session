#!/bin/sh
# The session: bspwm (config/bspwm) on Xorg, tuigreet starting it through startx (etc/greetd/config.toml).
xrdb -merge "$HOME/.Xresources"
# the colour theme set again (bin/theme): its X resources (polybar's and bspwm's colours), the root (its ground,
# or the wallpaper while the opacity is below 1), xcompmgr for that opacity, and its files for the rest
"$HOME/dotfiles/bin/theme" "$(basename "$(readlink "${XDG_STATE_HOME:-$HOME/.local/state}/theme/theme.toml")" .toml)"
xsetroot -cursor_name left_ptr
# portals, ssh-agent's askpass and the other user units see this display, and xss-lock.service the login
# session
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_ID XDG_CURRENT_DESKTOP=bspwm 2>/dev/null

# locked at 10 min idle (xss-lock.service), the screen off at 15
xset s 600 600 dpms 900 900 900
# the session's daemons as user units (config/systemd): x-session.target brings up graphical-session.target and
# what it wants, xsettingsd (the 2x, before any app), snixembed, polkit-agent, xss-lock and x-night.timer;
# dunst comes over D-Bus with the first notification. They restart on a crash, log to journalctl --user, and
# stop with the session, bspwm's end
systemctl --user start x-session.target
bspwm
systemctl --user stop x-session.target
