#!/bin/sh
# The session: bspwm (config/bspwm) on Xorg, tuigreet starting it through startx (etc/greetd/config.toml). No
# compositor unless the theme's opacity asks for picom, the root the theme's ground.
xrdb -merge "$HOME/.Xresources"
# the colour theme's (bin/theme): bspwm's and polybar's colours
xrdb -merge "${XDG_STATE_HOME:-$HOME/.local/state}/theme/Xresources" 2>/dev/null
# picom for the terminal's opacity, only when the theme's below 1 (bin/theme)
opacity=1
. "${XDG_STATE_HOME:-$HOME/.local/state}/theme/options" 2>/dev/null
[ "$opacity" = 1 ] || picom -b --backend xrender 2>/dev/null
# us and ru, Ctrl+Space between them, Scroll Lock's LED on ru (bin/x-status reads it); Caps as Ctrl is the hwdb's
setxkbmap -layout us,ru -option '' -option grp:ctrl_space_toggle,grp_led:scroll
# the ground the colour theme's (bin/theme), black without one
bg=$(xrdb -get theme.bg)
xsetroot -solid "${bg:-#000000}" -cursor_name left_ptr
# portals, ssh-agent's askpass and the other user units see this display
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=bspwm 2>/dev/null

dunst &   # notifications (config/dunst)
# the StatusNotifierItem icons (Electron's trays) in polybar's tray; without it they quit on close
"$HOME/.local/bin/snixembed" &
# the polkit agent: virt-manager's, udisks' and the rest's password prompts
/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &
# locked at 10 min idle and before sleep (loginctl lock-session too), the screen off at 15
xset s 600 600 dpms 900 900 900
xss-lock --transfer-sleep-lock -- i3lock -n -c 000000 &
# the night light every minute (bin/x-night)
(while :; do "$HOME/dotfiles/bin/x-night"; sleep 60; done) &
exec bspwm
