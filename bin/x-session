#!/bin/sh
# The session: bspwm (config/bspwm) on Xorg, tuigreet starting it through startx (etc/greetd/config.toml). No
# compositor unless the theme's opacity asks for xcompmgr, the root the theme's ground.
xrdb -merge "$HOME/.Xresources"
# the colour theme's (bin/theme): bspwm's and polybar's colours
xrdb -merge "${XDG_STATE_HOME:-$HOME/.local/state}/theme/Xresources" 2>/dev/null
# xcompmgr for the terminal's opacity, only when the theme's below 1 (bin/theme)
opacity=1 wallpaper=
. "${XDG_STATE_HOME:-$HOME/.local/state}/theme/options" 2>/dev/null
[ "$opacity" = 1 ] || xcompmgr &
# the root: the colour theme's wallpaper while its opacity is below 1, else its ground, black without one
# (bin/theme)
bg=$(xrdb -get theme.bg)
xsetroot -solid "${bg:-#000000}" -cursor_name left_ptr
[ "$opacity" != 1 ] && [ -f "$wallpaper" ] && xwallpaper --zoom "$wallpaper"
# portals, ssh-agent's askpass and the other user units see this display, and xss-lock.service the login
# session
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_ID XDG_CURRENT_DESKTOP=bspwm 2>/dev/null

# locked at 10 min idle (xss-lock.service), the screen off at 15
xset s 600 600 dpms 900 900 900
# the session's daemons as user units (config/systemd): x-session.target brings up graphical-session.target and
# what it wants, xsettingsd (the 2x, before any app), snixembed, polkit-agent, xss-lock and x-night.timer;
# dunst comes over D-Bus with the first notification. They restart on a crash, log to journalctl --user, and
# stop with the session, bspwm's end
systemctl --user start x-session.target
bspwm
systemctl --user stop x-session.target
