#!/bin/bash
# The VLESS client: mihomo as a systemd --user service (config/systemd/mihomo.service), driven through its
# API on 127.0.0.1:9090. bin/wm-ctl's vpn menu and bin/wm-status's bar block call it.
#   vpn on tun|proxy    start, all traffic through TUN, or the proxy on 127.0.0.1:7890 set as GNOME's
#                       system proxy (GTK apps; Chrome outside GNOME reads only the env, Telegram its own)
#   vpn off             stop, the system proxy cleared
#   vpn mode rule|global  Russia and the local networks direct (rule), or everything through the profile
#   vpn profile [NAME]  pick the profile (PROXY's server), or list them, the current one first
#   vpn status          "off", or "tun|proxy rule|global PROFILE"
#   vpn build           merge config/mihomo/base.yaml and private/config/mihomo/desktop.yaml into
#                       ~/.config/mihomo/config.yaml (mihomo.service's ExecStartPre)
api=http://127.0.0.1:9090
dir=$HOME/.config/mihomo

call() { curl -fsS --max-time 2 -X "$1" "$api$2" ${3:+-H 'Content-Type: application/json' -d "$3"}; }

# global_via_profile: the global mode goes through mihomo's built-in GLOBAL group, DIRECT unless told,
# so it is pointed at PROXY, the group the profile is picked in
global_via_profile() { call PUT /proxies/GLOBAL '{"name":"PROXY"}'; }

# reroute: close the open connections, which keep the way they were opened on (a browser holds and reuses
# them), so the apps reconnect by the new mode, profile or TUN
reroute() { call DELETE /connections; }

# up: start the service and wait for its API, which the first start's geodata download can delay
up() {
	systemctl --user start mihomo.service || exit 1
	for _ in $(seq 1 100); do call GET /version > /dev/null 2>&1 && { global_via_profile; return; }; sleep 0.2; done
	echo "vpn: mihomo's API did not come up, see journalctl --user -u mihomo" >&2
	exit 1
}

system_proxy() {
	if [ "$1" = on ]; then
		gsettings set org.gnome.system.proxy mode manual
		for p in http https socks; do
			gsettings set "org.gnome.system.proxy.$p" host 127.0.0.1
			gsettings set "org.gnome.system.proxy.$p" port 7890
		done
	else
		gsettings set org.gnome.system.proxy mode none
	fi
}

case "${1:-}" in
build)
	mkdir -p "$dir"
	# yq is go install's (dev_tools), off the PATH systemd gives the service
	"$HOME/go/bin/yq" eval-all '. as $part ireduce ({}; . * $part)' "$HOME/dotfiles/config/mihomo/base.yaml" \
		"$HOME/dotfiles/private/config/mihomo/desktop.yaml" > "$dir/config.yaml.new" \
		&& mv "$dir/config.yaml.new" "$dir/config.yaml" ;;
on)
	case "${2:-}" in
	tun)
		up; call PATCH /configs '{"tun":{"enable":true}}' || exit 1
		# mihomo takes the patch even when the TUN device fails to come up, so check it did
		if [ "$(call GET /configs | jq -r .tun.enable)" != true ]; then
			systemctl --user stop mihomo.service; system_proxy off   # back to off, not a half-on proxy
			echo "vpn: TUN did not come up, so off. mihomo lacks cap_net_admin? Run:" >&2
			echo "sudo setcap cap_net_admin,cap_net_bind_service+ep ~/.local/bin/mihomo" >&2
			exit 1
		fi
		system_proxy off; reroute ;;
	proxy) up; call PATCH /configs '{"tun":{"enable":false}}' && system_proxy on && reroute ;;
	*)     echo "usage: vpn on tun|proxy" >&2; exit 1 ;;
	esac ;;
off)
	system_proxy off
	systemctl --user stop mihomo.service ;;
mode)
	case "${2:-}" in
	rule|global) global_via_profile && call PATCH /configs "{\"mode\":\"$2\"}" && reroute ;;
	*) echo "usage: vpn mode rule|global" >&2; exit 1 ;;
	esac ;;
profile)
	if [ -n "${2:-}" ]; then
		call PUT /proxies/PROXY "$(jq -nc --arg n "$2" '{name: $n}')" && reroute
	else
		call GET /proxies/PROXY | jq -r '.now as $now | ([$now] + (.all - [$now]))[]'
	fi ;;
status)
	configs=$(call GET /configs 2> /dev/null) || { echo off; exit 0; }
	now=$(call GET /proxies/PROXY | jq -r .now)
	jq -r --arg now "$now" '"\(if .tun.enable then "tun" else "proxy" end) \(.mode) \($now)"' <<< "$configs" ;;
*)
	echo "usage: vpn on tun|proxy | off | mode rule|global | profile [NAME] | status | build" >&2
	exit 1 ;;
esac
