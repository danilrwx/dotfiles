#!/usr/bin/env bash

# Manage the global devbox dev container via DevPod. Provider is selected with a
# leading -k/--k8s flag:
#   devbox            docker provider (local): binds ~/w, host docker.sock
#   devbox -k         kubernetes provider (remote): source uploaded to a PVC
# In both cases DevPod forwards the host ssh-agent and gpg-agent over its SSH
# tunnel, so git auth and commit signing use the host keys with no key material
# copied into the container. Extra args after the command pass through to devpod.
#
# One-time setup registers the provider:  devbox provider  /  devbox -k provider
#
# k8s knobs (env): DEVBOX_K8S_NS (devbox), DEVBOX_K8S_DISK (50Gi),
# DEVBOX_K8S_SC (storage class, default cluster default). The kubernetes
# provider add provisions a cluster-admin ServiceAccount, builds a Secret from a
# self-contained kubeconfig of its static token, and a pod template that mounts
# it, since host bind mounts do not work in the k8s provider.
set -euo pipefail

log() { echo -e "\033[0;31m$1\033[0m"; }

usage() {
  cat <<'EOF'
devbox — manage the global dev container via DevPod

Usage:
  devbox [-k|--k8s] <command> [devpod args...]

Provider (default: docker):
  -k, --k8s        use the kubernetes provider (remote pod on a PVC) instead of
                   docker (local, binds ~/w and the host docker.sock)

Commands:
  shell            open a shell in the container (default; creates it if needed)
  up               create/start the workspace
  update           pull the latest image and rebuild from scratch (fresh home
                   from the image: dotfiles, tools, gnupg; ~/w work is kept)
  down             stop the workspace (data is kept)
  delete           remove the workspace
  check            check the registry for a newer image (notifies on up/shell)
  provider         register/configure the DevPod provider (one-time setup)
  help             show this help

The host ssh-agent and gpg-agent are forwarded, so git auth and commit signing
use the host keys with nothing copied into the container.

Kubernetes env knobs:
  DEVBOX_K8S_NS    namespace (default: devbox)
  DEVBOX_K8S_DISK  PVC size (default: 50Gi)
  DEVBOX_K8S_SC    storage class (default: cluster default)

Examples:
  devbox                 shell into the local (docker) container
  devbox up              start it without attaching
  devbox -k provider     one-time: register the kubernetes provider
  devbox -k shell        shell into the remote (kubernetes) pod
EOF
}

IMAGE="ghcr.io/danilrwx/devbox:latest"
DOT="$HOME/dotfiles/devcontainer"
WS="$HOME/w"

PROVIDER=docker
CONFIG="$DOT/devcontainer.json"
NAME=w
SRC="$WS"
case "${1:-}" in
  -k|--k8s|kube|kubernetes)
    PROVIDER=kubernetes
    CONFIG="$DOT/devcontainer.k8s.json"
    NAME=w-k8s
    # k8s does not bind ~/w (8 GB) — upload a tiny source that only carries the
    # config and a bootstrap that clones the work repos into the PVC.
    SRC="$HOME/.config/devbox/k8s-src"
    KCFG="$HOME/.config/devbox/kubeconfig"
    shift
    ;;
esac

# Forward the host gpg-agent (signing) and ssh-agent (git). DevPod aborts hard if
# SSH_AUTH_SOCK points at a dead socket, so drop it when the agent does not
# answer (rc 2 = cannot connect); ssh-agent forwarding is on by default.
setup_forwarding() {
  gpgconf --launch gpg-agent 2>/dev/null || true
  # If the inherited SSH_AUTH_SOCK is dead (rc 2), point at the persistent
  # launchd ssh-agent on macOS — it supports the native confirm dialog, which a
  # plain spawned agent does not. Capture rc via `|| rc=` so a non-zero ssh-add
  # does not trip `set -e`.
  local rc=0
  ssh-add -l >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ] && [ "$(uname -s)" = Darwin ]; then
    local sock
    sock=$(launchctl asuser "$(id -u)" launchctl getenv SSH_AUTH_SOCK 2>/dev/null || true)
    [ -n "$sock" ] && export SSH_AUTH_SOCK="$sock"
  fi
  # Load the key with confirmation required (-c) so each forwarded use prompts on
  # the host; re-adding updates the flag even if it was already loaded without it.
  if [ -e "$HOME/.ssh/id_rsa" ]; then
    ssh-add -c --apple-use-keychain "$HOME/.ssh/id_rsa" >/dev/null 2>&1 \
      || ssh-add -c "$HOME/.ssh/id_rsa" >/dev/null 2>&1 || true
  fi
  rc=0
  ssh-add -l >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ]; then
    log "ssh-agent unreachable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset}) — skipping ssh-agent forwarding"
    unset SSH_AUTH_SOCK
  fi
  # DEVBOX_NO_GPG=1 skips gpg-agent forwarding (DevPod's gpg import can deadlock
  # keyboxd on some gpg version mismatches, aborting the connection).
  if [ -n "${DEVBOX_NO_GPG:-}" ]; then FWD=(); else FWD=(--gpg-agent-forwarding); fi
}

# DevPod discovers .devcontainer/devcontainer.json in the source root. docker
# binds ~/w and reads the config via a symlink; k8s uploads a tiny source, so the
# config and bootstrap are copied into it (uploads do not follow symlinks).
link_config() {
  mkdir -p "$SRC/.devcontainer"
  if [ "$PROVIDER" = kubernetes ]; then
    cp "$CONFIG" "$SRC/.devcontainer/devcontainer.json"
    cp "$DOT/bootstrap.sh" "$SRC/.devcontainer/bootstrap.sh"
    # The repo list and work git identity come from the private submodule, which
    # bootstrap.sh pulls in the pod over the forwarded ssh-agent — nothing to
    # ship here.
  else
    ln -sf "$CONFIG" "$SRC/.devcontainer/devcontainer.json"
  fi
}

# k8s has no host bind mount, so push the current host ~/.ssh/config into the pod
# on every up/shell (DevPod has no live sync). docker binds ~/.ssh already.
push_ssh_config() {
  [ "$PROVIDER" = kubernetes ] || return 0
  [ -f "$HOME/.ssh/config" ] || return 0
  devpod ssh "$NAME" --command 'umask 077; mkdir -p ~/.ssh; cat > ~/.ssh/config' \
    < "$HOME/.ssh/config" 2>/dev/null || true
}

up() {
  link_config
  devpod up "$SRC" --id "$NAME" --provider "$PROVIDER" --ide none "${FWD[@]}" "$@"
  push_ssh_config
}

# Register (or reconfigure) the DevPod provider for the selected mode.
provider_add() {
  if [ "$PROVIDER" = docker ]; then
    devpod provider add docker --use 2>/dev/null || devpod provider use docker
    return
  fi

  local ns="${DEVBOX_K8S_NS:-devbox}"
  local disk="${DEVBOX_K8S_DISK:-50Gi}"
  local gocache="${DEVBOX_K8S_GOCACHE:-20Gi}"
  local tmpl="$HOME/.config/devbox/pod-template.yaml"
  local kcfg="$HOME/.config/devbox/kubeconfig"
  mkdir -p "$(dirname "$kcfg")"

  log "Creating namespace '$ns'"
  kubectl create namespace "$ns" --dry-run=client -o yaml | kubectl apply -f -
  # Allow the privileged docker:dind sidecar. Deckhouse (admission-policy-engine)
  # gates Pod Security by this namespace label; harmless on non-Deckhouse clusters.
  kubectl label namespace "$ns" security.deckhouse.io/pod-policy=privileged --overwrite

  # In-pod kubectl cannot use the host's OIDC exec kubeconfig (no `d8`/browser in
  # the pod), so provision a cluster-admin ServiceAccount and build a
  # self-contained kubeconfig from its static (non-expiring) token. Needs the
  # current host context to be able to create these — run under your OIDC admin.
  log "Provisioning ServiceAccount '$ns/admin' (cluster-admin) for in-pod kubectl"
  kubectl create serviceaccount admin -n "$ns" --dry-run=client -o yaml | kubectl apply -f -
  kubectl create clusterrolebinding devbox-admin --clusterrole=cluster-admin \
    --serviceaccount="$ns:admin" --dry-run=client -o yaml | kubectl apply -f -
  kubectl apply -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: admin-token
  namespace: $ns
  annotations:
    kubernetes.io/service-account.name: admin
type: kubernetes.io/service-account-token
EOF

  local token=""
  for _ in $(seq 1 10); do
    token=$(kubectl -n "$ns" get secret admin-token -o jsonpath='{.data.token}' 2>/dev/null | base64 -d)
    [ -n "$token" ] && break; sleep 1
  done
  [ -n "$token" ] || { log "timed out waiting for the admin-token secret"; exit 1; }

  # Reuse the current cluster's endpoint and TLS trust; swap only the credential.
  local server cadata insecure
  server=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}')
  cadata=$(kubectl config view --minify --flatten -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
  insecure=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.insecure-skip-tls-verify}')

  log "Writing SA kubeconfig -> $kcfg"
  {
    echo "apiVersion: v1"
    echo "kind: Config"
    echo "clusters:"
    echo "- name: devbox"
    echo "  cluster:"
    echo "    server: $server"
    [ -n "$cadata" ] && echo "    certificate-authority-data: $cadata"
    [ "$insecure" = true ] && echo "    insecure-skip-tls-verify: true"
    echo "users:"
    echo "- name: admin"
    echo "  user:"
    echo "    token: $token"
    echo "contexts:"
    echo "- name: devbox"
    echo "  context:"
    echo "    cluster: devbox"
    echo "    user: admin"
    echo "    namespace: $ns"
    echo "current-context: devbox"
  } > "$kcfg"
  chmod 600 "$kcfg"

  log "Creating secret '$ns/devbox-kube'"
  kubectl -n "$ns" create secret generic devbox-kube --from-file="config=$kcfg" \
    --dry-run=client -o yaml | kubectl apply -f -

  # Persistent go module + build cache, kept across pod recreates (the home dir is
  # ephemeral in k8s, so without this every recreate re-downloads all modules).
  # Not mounted over ~/go — that holds the image's baked go tools; the pod points
  # GOMODCACHE/GOCACHE at this mount instead. Survives `devbox -k delete`.
  log "Ensuring go-cache PVC '$ns/devbox-gocache' ($gocache)"
  kubectl -n "$ns" apply -f - <<EOF
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: devbox-gocache
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: $gocache
$([ -n "${DEVBOX_K8S_SC:-}" ] && echo "  storageClassName: $DEVBOX_K8S_SC")
EOF

  # DevPod merges this onto its generated pod; the volumeMount attaches to its dev
  # container (name "devpod"). Mount the kubeconfig at a side path (not
  # ~/.kube/config) so ~/.kube stays writable; devcontainer.k8s.json points
  # KUBECONFIG at it. A privileged docker:dind
  # sidecar gives the pod a real docker daemon on tcp://localhost:2375 (there is
  # no host socket to mount in k8s); devcontainer.k8s.json sets DOCKER_HOST.
  mkdir -p "$(dirname "$tmpl")"
  cat > "$tmpl" <<'YAML'
spec:
  containers:
    - name: devpod
      volumeMounts:
        - name: kube
          mountPath: /opt/devbox
          readOnly: true
        - name: gocache
          mountPath: /home/dev/gocache
    - name: dind
      image: docker:dind
      args: ["--host=tcp://0.0.0.0:2375"]
      securityContext:
        privileged: true
      env:
        - name: DOCKER_TLS_CERTDIR
          value: ""
      volumeMounts:
        - name: dind-storage
          mountPath: /var/lib/docker
  volumes:
    - name: kube
      secret:
        secretName: devbox-kube
    - name: dind-storage
      emptyDir: {}
    - name: gocache
      persistentVolumeClaim:
        claimName: devbox-gocache
YAML

  # Mount the PVC only on the work dir; the home dir must keep the image's baked
  # go tools and dotfiles (a PVC over /home/dev would start empty, unlike a
  # docker named volume which seeds from the image).
  local opts=(-o "KUBERNETES_CONFIG=$kcfg" -o "KUBERNETES_NAMESPACE=$ns"
    -o "DISK_SIZE=$disk" -o "WORKSPACE_VOLUME_MOUNT=/home/dev/w"
    -o "POD_MANIFEST_TEMPLATE=$tmpl")
  [ -n "${DEVBOX_K8S_SC:-}" ] && opts+=(-o "STORAGE_CLASS=$DEVBOX_K8S_SC")
  devpod provider add kubernetes --use "${opts[@]}" "$@" 2>/dev/null \
    || devpod provider set-options kubernetes "${opts[@]}" "$@"
}

# --- Image update check -----------------------------------------------------
# Compare the digest of :latest in the registry against the image the workspace
# actually runs. Everything here is best-effort and must never block or fail a
# shell: all network calls have a short timeout and swallow errors.
CHECK_STAMP="$HOME/.config/devbox/$NAME.last-check"

# Docker-Content-Digest of :latest from GHCR via an anonymous pull token. Prints
# nothing on any failure (offline, rate limit, missing jq).
remote_digest() {
  local repo token
  repo="${IMAGE#ghcr.io/}"; repo="${repo%:*}"
  token=$(curl -fsS --max-time 5 "https://ghcr.io/token?scope=repository:${repo}:pull" 2>/dev/null \
    | jq -r '.token // empty' 2>/dev/null) || return 0
  [ -n "$token" ] || return 0
  curl -fsSI --max-time 5 -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.oci.image.index.v1+json" \
    -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" \
    "https://ghcr.io/v2/${repo}/manifests/latest" 2>/dev/null \
    | awk 'tolower($1)=="docker-content-digest:"{print $2}' | tr -d '\r'
}

# Digest of the image the workspace actually runs (:latest is single-arch, so
# the pod/local digest equals the registry content digest). docker: the locally
# pulled image; k8s: the running pod's devpod container (assumes one devbox pod
# in the namespace). Empty if it can't be determined (not pulled / not running).
current_digest() {
  if [ "$PROVIDER" = docker ]; then
    docker image inspect "$IMAGE" --format '{{index .RepoDigests 0}}' 2>/dev/null | sed -n 's/.*@//p'
  else
    kubectl -n "${DEVBOX_K8S_NS:-devbox}" get pods -l devpod.sh/created=true \
      -o jsonpath='{.items[-1:].status.containerStatuses[?(@.name=="devpod")].imageID}' 2>/dev/null \
      | sed -n 's/.*@//p'
  fi
}

# Notify if the registry :latest differs from the running image. Throttled to
# once per 12h; `check_update force` bypasses it and also reports up-to-date.
check_update() {
  local force=""; [ "${1:-}" = force ] && force=1
  mkdir -p "$(dirname "$CHECK_STAMP")"
  if [ -z "$force" ] && [ -n "$(find "$CHECK_STAMP" -mmin -720 2>/dev/null)" ]; then
    return 0
  fi
  local remote; remote=$(remote_digest) || true
  if [ -z "$remote" ]; then
    [ -n "$force" ] && log "Could not reach the registry to check for updates."
    return 0
  fi
  touch "$CHECK_STAMP"
  local cur flag=""; cur=$(current_digest) || true; [ "$PROVIDER" = kubernetes ] && flag=" -k"
  if [ -z "$cur" ]; then
    [ -n "$force" ] && log "Could not determine the running image (is the workspace up?)."
  elif [ "$remote" != "$cur" ]; then
    log "A new devbox image is available — run 'devbox${flag} update' to update."
  else
    [ -n "$force" ] && log "devbox image is up to date."
  fi
}

cmd="${1:-shell}"; shift || true

case "$cmd" in -h|--help|help) usage; exit 0 ;; esac

# DevPod reads KUBECONFIG from the env and cannot handle a colon-merged list, so
# pin it to the flattened per-cluster config written by `devbox -k provider`.
if [ "$PROVIDER" = kubernetes ] && [ "$cmd" != provider ]; then
  [ -f "$KCFG" ] || { log "run 'devbox -k provider' first"; exit 1; }
  export KUBECONFIG="$KCFG"
fi

case "$cmd" in
  provider)
    provider_add "$@"
    ;;
  update)
    setup_forwarding
    if [ "$PROVIDER" = docker ]; then
      # Full refresh: pull the latest image and drop the workspace + its home
      # volume so it re-seeds from the image (baked dotfiles, tools, ~/.gnupg).
      # A --recreate alone keeps the named volume, so stale home state persists.
      # Work lives in the ~/w bind mount, so it is untouched.
      log "Pulling $IMAGE"
      docker pull "$IMAGE"
      devpod delete "$NAME" --force >/dev/null 2>&1 || true
      # Drop the home volume(s) so home re-seeds from the image. Force-remove any
      # container still holding a volume first, else `volume rm` fails silently.
      for v in $(docker volume ls -q 2>/dev/null | grep -- 'devbox-home'); do
        docker ps -aq --filter "volume=$v" 2>/dev/null | xargs -r docker rm -f >/dev/null 2>&1 || true
        docker volume rm "$v" >/dev/null 2>&1 || true
      done
      up "$@"
    else
      # k8s home is ephemeral (from the image), so a recreate refreshes it and
      # the image; the PVC (work repos) is kept.
      up --recreate "$@"
    fi
    ;;
  check)
    check_update force
    ;;
  up|start)
    setup_forwarding
    up "$@"
    check_update
    ;;
  shell|sh|"")
    setup_forwarding
    up >/dev/null
    check_update
    devpod ssh "$NAME" "${FWD[@]}" "$@"
    ;;
  down|stop)
    devpod stop "$NAME" "$@"
    ;;
  delete|rm)
    devpod delete "$NAME" --force "$@"
    ;;
  *)
    echo "devbox: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
