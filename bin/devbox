#!/usr/bin/env bash

# Manage the global devbox dev container via DevPod (docker provider locally,
# swap to the kubernetes provider for remote). DevPod forwards the host
# ssh-agent and gpg-agent, so auth and commit signing use the host keys with no
# key material copied into the container.
set -euo pipefail

log() { echo -e "\033[0;31m$1\033[0m"; }

IMAGE="ghcr.io/danilrwx/devbox:latest"
WS="$HOME/w"
NAME="w"

# Forward the host gpg-agent (commit signing) and ssh-agent (git auth). DevPod
# aborts hard if SSH_AUTH_SOCK points at a dead socket, so drop it when the
# agent does not answer (rc 2 = cannot connect); ssh-agent forwarding is on by
# default when the socket is live.
gpgconf --launch gpg-agent 2>/dev/null || true
ssh-add -l >/dev/null 2>&1 || [ $? -ne 2 ] || {
  log "ssh-agent unreachable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset}) — skipping ssh-agent forwarding"
  unset SSH_AUTH_SOCK
}
FWD=(--gpg-agent-forwarding)

# DevPod discovers .devcontainer/devcontainer.json in the workspace root; the
# real config lives in dotfiles and is exposed via a symlink.
link_config() {
  mkdir -p "$WS/.devcontainer"
  ln -sf "$HOME/dotfiles/devcontainer/devcontainer.json" "$WS/.devcontainer/devcontainer.json"
}

up() { link_config; devpod up "$WS" --id "$NAME" --ide none "${FWD[@]}" "$@"; }

case "${1:-shell}" in
  update)
    log "Pulling $IMAGE"
    docker pull "$IMAGE"
    up --recreate
    ;;
  up|start)
    up
    ;;
  shell|sh|"")
    up >/dev/null
    devpod ssh "$NAME" "${FWD[@]}"
    ;;
  down|stop)
    devpod stop "$NAME"
    ;;
  delete|rm)
    devpod delete "$NAME" --force
    ;;
  *)
    echo "usage: devbox {shell|up|update|down|delete}" >&2
    exit 1
    ;;
esac
