#!/bin/sh
# The dwm session (/usr/share/xsessions/dwm.desktop from install, started by tuigreet through startx): the
# X11 setup and sxhkd from bin/x-autostart, bin/wm-status as dwm's status text, then dwm itself.
"$HOME/dotfiles/bin/x-autostart" dwm
"$HOME/dotfiles/bin/wm-status" | while read -r line; do xsetroot -name "$line"; done &
exec dwm
