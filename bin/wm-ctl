#!/bin/sh
# $mod+x: pick Wi-Fi, Bluetooth, the sound output or input, the headset mode or the power profile. Wi-Fi
# and Bluetooth are impala and bluetui in a floating st of class wm-ctl (for_window rule in
# config/i3/config); output, input and power are a second pick, the current one first: PipeWire's sinks or
# sources by wpctl, or power-profiles-daemon's profiles. headset flips the Bluetooth headset between
# headphones (A2DP, the good sound, no mic) and handsfree (HFP, with the mic). vless drives bin/vless: on through
# TUN or as the system proxy, off, the rule or global mode, the profile. theme picks bin/theme's dark,
# or a wallpaper's dark or light palette and then the wallpaper, the current one first.
menu="$HOME/dotfiles/bin/wm-menu"
# term TITLE CMD: st with class wm-ctl, in the theme's colours (bin/term)
term() { exec "$HOME/dotfiles/bin/term" -c wm-ctl -t "$1" -e "$2"; }
# devices Sink|Source: "ID<tab>NAME" per PipeWire audio sink or source, the default one first. Only the
# nodes of class Audio/Sink or Audio/Source: wpctl status lists WirePlumber's internal Bluetooth nodes as the
# sinks, while the headset's real one sits under its filters. Left out unless the default: those whose every
# port the card reports unplugged ("available": "no", the HDMI outputs with no display on them; a port ALSA
# cannot sense, the speaker or a mic, says "unknown")
devices() {
	pw-dump | jq -r --arg class "Audio/$1" --arg key "default.audio.$(echo "$1" | tr '[:upper:]' '[:lower:]')" '
		([.[] | select(.type == "PipeWire:Interface:Metadata" and .props["metadata.name"] == "default")
			| .metadata[] | select(.key == $key) | .value.name][0] // "") as $default
		| (map(select(.type == "PipeWire:Interface:Device"))
			| map({key: (.id | tostring), value: [.info.params.EnumRoute[]?]}) | from_entries) as $routes
		| [.[] | select(.type == "PipeWire:Interface:Node" and .info.props["media.class"] == $class)
			| .info.props as $p
			| ($p["node.name"] == $default) as $def
			| (($routes[$p["device.id"] | tostring] // []) | map(select(.devices | index($p["card.profile.device"])))) as $r
			| select($def or ($r | length) == 0 or any($r[]; .available != "no"))
			| {def: $def, id, name: ($p["node.nick"] // $p["node.description"])}]
		| sort_by(.def | not) | .[] | "\(.id)\t\(.name)"'
}
# sound Sink|Source TITLE: pick a device by name, make it the default
sound() {
	list=$(devices "$1")
	name=$(printf '%s\n' "$list" | cut -f2- | "$menu" pick "$2") || exit 0
	id=$(printf '%s\n' "$list" | awk -F '\t' -v n="$name" '$2 == n {print $1; exit}')
	[ -n "$id" ] || exit 0
	if wpctl set-default "$id"; then notify-send -a fnkeys -r 9912 -t 1500 "Sound $2" "$name"
	else notify-send -a fnkeys -r 9912 -t 3000 "Sound $2" "could not switch to $name"; fi
}
# headset: the first Bluetooth device as "ID<tab>NAME<tab>PROFILE<tab>A2DP<tab>HFP", the current profile's
# name and the index of the best A2DP and handsfree profile each; nothing without one
headset_info() {
	pw-dump | jq -r '[.[] | select(.type == "PipeWire:Interface:Device" and .info.props["device.api"] == "bluez5")][0]
		// empty | [.id, .info.props["device.description"], (.info.params.Profile[0].name // ""),
		([.info.params.EnumProfile[] | select(.name | startswith("a2dp-sink"))] | max_by(.priority) | .index // ""),
		([.info.params.EnumProfile[] | select(.name | startswith("headset-head-unit"))] | max_by(.priority) | .index // "")]
		| map(tostring) | @tsv'
}
headset() {
	info=$(headset_info)
	[ -n "$info" ] || { notify-send -a fnkeys -r 9912 -t 1500 "Headset" "no Bluetooth headset"; exit 0; }
	IFS='	' read -r id name cur a2dp hfp <<-EOF
	$info
	EOF
	case "$cur" in
	headset-head-unit*) to=$a2dp mode=headphones ;;
	*)                  to=$hfp mode=handsfree ;;
	esac
	[ -n "$to" ] || { notify-send -a fnkeys -r 9912 -t 1500 "Headset" "$name has no $mode mode"; exit 0; }
	wpctl set-profile "$id" "$to" && notify-send -a fnkeys -r 9912 -t 1500 "Headset" "$name: $mode"
}
# vless: the picks that change the state, bin/vless's status as the prompt
vless() {
	vless=$HOME/dotfiles/bin/vless
	# off, or: tun|proxy rule|global PROFILE, the profile's name as it is, spaces and all
	read -r how mode profile <<-EOF
	$("$vless" status)
	EOF
	if [ "$how" = off ]; then
		pick=$(printf 'tun\nproxy\n' | "$menu" pick "vless off") || exit 0
	else
		other=tun; [ "$how" = tun ] && other=proxy
		flip=global; [ "$mode" = global ] && flip=rule
		pick=$(printf 'profile\n%s\n%s\noff\n' "$flip" "$other" | "$menu" pick "vless $how $mode $profile") || exit 0
	fi
	case "$pick" in
	tun|proxy)   set -- on "$pick" ;;
	rule|global) set -- mode "$pick" ;;
	off)         set -- off ;;
	profile)
		pick=$("$vless" profile | "$menu" pick profile) || exit 0
		set -- profile "$pick" ;;
	esac
	# the outcome as a card: the new state, or bin/vless's error
	if err=$("$vless" "$@" 2>&1); then
		notify-send -a fnkeys -r 9912 -t 1500 "VLESS" "$("$vless" status)"
	else
		notify-send -a fnkeys -r 9912 -u critical "VLESS" "$err"
	fi
}
# theme: the mode, then for a wallpaper's palette the wallpaper, by file name
theme() {
	theme=$HOME/dotfiles/bin/theme
	state=${XDG_CACHE_HOME:-$HOME/.cache}/theme
	mode=$(cat "$state/mode" 2>/dev/null || echo dark)
	pick=$(printf 'dark\nwall-dark\nwall-light\n' | "$menu" pick "theme $mode") || exit 0
	if [ "$pick" = dark ]; then
		set -- dark
	else
		cur=$(cat "$state/wallpaper" 2>/dev/null)
		name=$({ [ -f "$cur" ] && basename "$cur"; "$theme" wallpapers | xargs -r -n1 -d '\n' basename | grep -vxF "$(basename "$cur" 2>/dev/null)"; } | "$menu" pick wallpaper) || exit 0
		set -- "$pick" "$HOME/Pictures/wallpapers/$name"
	fi
	if err=$("$theme" "$@" 2>&1); then
		notify-send -a fnkeys -r 9912 -t 1500 "Theme" "$*"
	else
		notify-send -a fnkeys -r 9912 -u critical "Theme" "$err"
	fi
}
choice=$(printf 'wifi\nbluetooth\noutput\ninput\nheadset\nvless\ntheme\npower\n' | "$menu" pick ctl) || exit 0
case "$choice" in
power)
	cur=$(powerprofilesctl get)
	profile=$({ echo "$cur"; powerprofilesctl list | sed -n 's/^[* ] *\([a-z-]*\):$/\1/p' | grep -vx "$cur"; } | "$menu" pick power) || exit 0
	powerprofilesctl set "$profile" && notify-send -a fnkeys -r 9912 -t 1500 "Power profile" "$profile" ;;
wifi)      term Wi-Fi "$HOME/.local/bin/impala" ;;
bluetooth) term Bluetooth "$HOME/.local/bin/bluetui" ;;
output)    sound Sink output ;;
input)     sound Source input ;;
headset)   headset ;;
vless)     vless ;;
theme)     theme ;;
esac
