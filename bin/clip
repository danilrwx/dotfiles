#!/usr/bin/env bash

# Copy stdin to the host clipboard via OSC 52, for use from the devbox over SSH
# where pbcopy/xclip cannot reach the host. The terminal emulator turns the
# escape sequence into a real clipboard write; inside tmux it is forwarded to the
# outer terminal (needs set-clipboard on + the clipboard terminal-feature, see
# .tmux.conf). Usage:  some-command | clip   |   clip < file
#
# Locally it goes straight to wl-copy or pbcopy: Ptyxis/VTE and Terminal.app
# ignore OSC 52.
set -euo pipefail

if [ -z "${SSH_CONNECTION:-}" ]; then
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null; then exec wl-copy; fi
  if command -v pbcopy >/dev/null; then exec pbcopy; fi
fi

b64=$(base64 | tr -d '\n')
printf '\033]52;c;%s\a' "$b64" > /dev/tty
