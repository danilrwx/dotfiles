#!/bin/bash
# i3's dmenu (its $mod+d): over the bar, the apps by their names (the
# .desktop entries, not PATH's binaries; those hidden by NoDisplay, config/applications's among them, left out).
# What is typed instead: arithmetic is calculated, its result copied; "s words" searches DuckDuckGo, "g words"
# Google, "?question" asks Claude, in the browser; anything else runs as a command, dmenu_run's way.

# the entries by id, the user's over the system's
declare -A app seen
for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/local/share/applications /usr/share/applications; do
  for f in "$d"/*.desktop; do
    [ -f "$f" ] || continue
    id=${f##*/}
    [ -n "${seen[$id]}" ] && continue
    seen[$id]=1
    # the [Desktop Entry] group's Name, unless the entry is hidden or not an app
    name=$(awk -F= '/^\[/ {g = ($0 == "[Desktop Entry]")} g && /^Name=/ && !n {n = $2}
      g && /^(NoDisplay|Hidden)=true/ {h = 1} g && /^Type=/ && $2 != "Application" {h = 1}
      END {if (!h) print n}' "$f")
    [ -n "$name" ] && [ -z "${app[$name]}" ] && app[$name]=${id%.desktop}
  done
done

q=$(printf '%s\n' "${!app[@]}" | sort -f | dmenu -i -p run -fn 'Iosevka:size=11' \
  -nb '#000000' -nf '#ffffff' -sb '#ffffff' -sf '#000000') || exit 0
web() { xdg-open "$1$(jq -rn --arg q "$2" '$q | @uri')" & }
case $q in
  "s "*) web 'https://duckduckgo.com/?q=' "${q#s }" ;;
  "g "*) web 'https://www.google.com/search?q=' "${q#g }" ;;
  "?"*)  web 'https://claude.ai/new?q=' "${q#\?}" ;;
  *)
    if [ -n "${app[$q]}" ]; then
      exec gtk-launch "${app[$q]}"
    # digits and operators alone, so safe in awk's program
    elif [[ $q =~ ^[0-9.+*/%^()\ -]+$ ]] && r=$(awk "BEGIN {print $q}" 2>/dev/null) && [ -n "$r" ]; then
      printf %s "$r" | xclip -selection clipboard
      notify-send -a run "$q = $r" "copied"
    else
      exec sh -c "$q"
    fi ;;
esac
