#!/bin/sh
# PipeWire's sound devices, for bin/wm-ctl's output and input picks and the bar's sound panel (config/eww):
#   wm-audio Sink|Source  "ID<tab>NAME" per device, the default one first
#   wm-audio json         {"sinks": [{id, name, def}], "sources": [...]}
# Only the nodes of class Audio/Sink or Audio/Source: wpctl status lists WirePlumber's internal Bluetooth
# nodes as the sinks, while the headset's real one sits under its filters. Left out unless the default:
# those whose every port the card reports unplugged ("available": "no", the HDMI outputs with no display on
# them; a port ALSA cannot sense, the speaker or a mic, says "unknown")
devices='
	def devices($class; $key):
		([.[] | select(.type == "PipeWire:Interface:Metadata" and .props["metadata.name"] == "default")
			| .metadata[] | select(.key == $key) | .value.name][0] // "") as $default
		| (map(select(.type == "PipeWire:Interface:Device"))
			| map({key: (.id | tostring), value: [.info.params.EnumRoute[]?]}) | from_entries) as $routes
		| [.[] | select(.type == "PipeWire:Interface:Node" and .info.props["media.class"] == $class)
			| .info.props as $p
			| ($p["node.name"] == $default) as $def
			| (($routes[$p["device.id"] | tostring] // []) | map(select(.devices | index($p["card.profile.device"])))) as $r
			| select($def or ($r | length) == 0 or any($r[]; .available != "no"))
			| {def: $def, id, name: ($p["node.nick"] // $p["node.description"])}]
		| sort_by(.def | not);'
case ${1:-} in
Sink|Source)
	key=default.audio.$(echo "$1" | tr '[:upper:]' '[:lower:]')
	pw-dump | jq -r --arg class "Audio/$1" --arg key "$key" "$devices"' devices($class; $key) | .[] | "\(.id)\t\(.name)"' ;;
json)
	pw-dump | jq -c "$devices"' {sinks: devices("Audio/Sink"; "default.audio.sink"),
		sources: devices("Audio/Source"; "default.audio.source")}' ;;
*)
	echo "usage: wm-audio Sink|Source|json" >&2
	exit 1 ;;
esac
