#!/bin/sh
# Mirror every tmux paste buffer into the desktop clipboard (wl-copy on Wayland,
# pbcopy on macOS). VTE terminals (Ptyxis, GNOME Terminal) and macOS Terminal.app
# drop OSC 52, so a copy that only reaches tmux never
# lands on the desktop clipboard. tmux has no hook for "buffer changed", but it
# tells control-mode clients (%paste-buffer-changed), so this attaches one
# read-only client that takes no part in sizing and gets no pane output, and
# pipes each new buffer into the clipboard tool. That covers mouse selections, `y` in copy
# mode and OSC 52 from apps in any pane, including nvim/tmux on a server over
# ssh (with set-clipboard on, tmux turns their OSC 52 into a buffer).
#
# Started by .tmux.conf with run-shell -b; one instance per tmux server.
if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
	copier=wl-copy
elif command -v pbcopy >/dev/null 2>&1; then
	copier=pbcopy
else
	exit 0 # a server: OSC 52 to the outer terminal is all there is
fi

socket=$(tmux display-message -p '#{socket_path}') || exit 0
lock="${XDG_RUNTIME_DIR:-/tmp}/tmux-clip-sync.$(echo "$socket" | tr / %).lock"
exec 9>"$lock"
if command -v flock >/dev/null 2>&1; then
	flock -n 9 || exit 0 # already running for this server
fi

# control mode detaches on EOF, so its stdin is a FIFO opened read-write: it
# never hits EOF and needs no extra process that could outlive tmux
fifo=$(mktemp -u)
mkfifo "$fifo" && exec 8<>"$fifo" && rm -f "$fifo"

# the client follows the session it attached to; when that one closes, attach
# to another until the server itself is gone
while tmux -S "$socket" has-session 2>/dev/null; do
	tmux -S "$socket" -C attach-session -f read-only,ignore-size,no-output <&8 2>/dev/null |
		while IFS=' ' read -r event name _; do
			[ "$event" = "%paste-buffer-changed" ] || continue
			tmux -S "$socket" save-buffer -b "$name" - | $copier
		done
	sleep 1
done
