[core]
  editor = nvim
  excludesfile = ~/.gitignore_global

[user]
  name = Daniil Antoshin
  email = antoshindanil@ya.ru
  signingkey = FD3CC5C71FFD6458

[commit]
  gpgsign = true
	verbose = true

[pull]
  rebase = true

[alias]
  # git ignores aliases that shadow a built-in, so `commit = commit --signoff` never fired
  ci = commit --signoff

[tag]
  gpgSign = true

[rerere]
	enabled = true

[format]
	signOff = yes

[diff]
    tool = nvimdiff
[difftool]
    prompt = false

[merge]
	tool = nvimdiff
[mergetool]
    prompt = true
[mergetool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'"

[includeIf "gitdir:~/w/"]
    path = ~/dotfiles/private/work.gitconfig

# [url "ssh://git@fox.flant.com/"]
# 	insteadOf = https://fox.flant.com/
