[core]
  editor = vim
  attributesfile = ~/.gitattributes
  excludesfile = ~/.gitignore_global

[user]
  name = Daniil Antoshin
  email = antoshindanil@ya.ru
  signingkey = FD3CC5C71FFD6458

[commit]
  gpgsign = true
	verbose = true

[pull]
  rebase = true

[alias]
  commit = commit --signoff

[tag]
  gpgSign = true

[rerere]
	enabled = true

[format]
	signOff = yes

[diff]
    tool = vimdiff
[difftool]
    prompt = false

[merge]
	tool = vimdiff
[mergetool]
    prompt = true
[mergetool "vimdiff"]
    cmd = "vim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'"

[includeIf "gitdir:~/w/"]
    path = ~/dotfiles/private/work.gitconfig

