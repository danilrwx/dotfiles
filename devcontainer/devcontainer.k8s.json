{
  "name": "devbox-k8s",
  "image": "ghcr.io/danilrwx/devbox:latest",
  "workspaceFolder": "/home/dev/w",
  "containerUser": "dev",
  "remoteUser": "dev",
  "containerEnv": {
    "DEVCONTAINER": "k8s",
    "KUBECONFIG": "/opt/devbox/config"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh"
}
