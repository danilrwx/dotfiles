{
  "name": "devbox-k8s",
  "image": "ghcr.io/danilrwx/devbox:latest",
  "workspaceFolder": "/home/dev/w",
  "containerUser": "dev",
  "remoteUser": "dev",
  "containerEnv": {
    "DEVCONTAINER": "k8s",
    "KUBECONFIG": "/opt/devbox/config",
    "DOCKER_HOST": "tcp://localhost:2375",
    "GOMODCACHE": "/home/dev/gocache/mod",
    "GOCACHE": "/home/dev/gocache/build"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh"
}
