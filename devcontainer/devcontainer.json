{
  "name": "devbox",
  "image": "ghcr.io/danilrwx/devbox:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/w,type=bind,consistency=cached",
  "workspaceFolder": "/home/dev/w",
  "containerUser": "dev",
  "remoteUser": "dev",
  "containerEnv": {
    "DEVCONTAINER": "1"
  },
  "mounts": [
    "source=devbox-home,target=/home/dev,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/dev/.claude.json,type=bind",
    "source=${localEnv:HOME}/.kube,target=/home/dev/.kube,type=bind",
    "source=${localEnv:HOME}/.kubeconfigs,target=/home/dev/.kubeconfigs,type=bind"
  ]
}
