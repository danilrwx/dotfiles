#!/usr/bin/env bash

log() {
  echo -e "\033[0;31m$1\033[0m"
}

# ./install [--desktop] [--ru-mirror] [--skip-go] [--skip-ts]
#   --desktop    the i3 and dwm sessions with greetd, and the GUI apps: Chrome, virt-manager, Telegram,
#                Discord, Steam.
#                Then ./debloat strips GNOME and snapd
#   --ru-mirror  pin the Ubuntu archive to mirror.yandex.ru
#   --skip-go    keep the Go tools in ~/go/bin as they are, no `go install`
#   --skip-ts    keep the built treesitter parsers, no TSBuild
DESKTOP=0; RU_MIRROR=0; SKIP_GO=0; SKIP_TS=0
for arg in "$@"; do
  case "$arg" in
    --desktop)   DESKTOP=1 ;;
    --ru-mirror) RU_MIRROR=1 ;;
    --skip-go)   SKIP_GO=1 ;;
    --skip-ts)   SKIP_TS=1 ;;
    -h|--help)   sed -n '/^# \.\/install/,/^[^#]/{s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    *) log "Unknown option: $arg"; exit 1 ;;
  esac
done

# Everything below (git remote/submodules, `link`, config/hwdb) is relative to the repo, and
# bin/dotfiles-update is this script on PATH, so it may be started from any directory
cd "$HOME/dotfiles" || { log "No $HOME/dotfiles"; exit 1; }

# Ubuntu only ─────────────────────────────────────────────────────────────────────────────────────────────────────────
[ -f /etc/os-release ] && . /etc/os-release
[ "${ID:-}" == ubuntu ] || { log "Unsupported system: ${ID:-$(uname -s)}, Ubuntu only"; exit 1; }
log "This is an Ubuntu $VERSION_ID system."

pkg() { sudo apt install -y "$@"; }

# SSH remote and private submodules (need an ssh key) ─────────────────────────────────────────────────────────────────
if compgen -G "$HOME/.ssh/id_*" | grep -qv '\.pub$'; then
  log "Switching origin to ssh and updating submodules"
  git remote set-url origin git@github.com:danilrwx/dotfiles.git

  if ! git submodule update --init --recursive; then
    log "Failed to update submodules. Continue installation."
  fi
else
  log "No ssh key in ~/.ssh. Skip ssh remote and private submodules."
fi

# Symlink configs. A real file/dir already at the target is moved aside,
# otherwise ln would put the link inside that dir ──────────────────────────────────────────────────────────────────────
link() {
  local src=$HOME/dotfiles/$1 dst=$2
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    log "Backing up $dst to $dst.bak"
    rm -rf "$dst.bak" && mv "$dst" "$dst.bak"
  fi
  ln -snf "$src" "$dst"
}

log "Linking configs"
mkdir -p $HOME/.config
mkdir -p $HOME/.local/bin $HOME/.local/share

for f in .gitconfig .gitignore_global .profile .tmux.conf .zprofile .zshrc; do
  link $f $HOME/$f
done
for c in k9s htop lazygit nvim; do
  link config/$c $HOME/.config/$c
done
# Private CLI configs (claude, pi, CLAUDE.md) are symlinked by private/install,
# which also keeps those paths out of this public repo.
if [ -f $HOME/dotfiles/private/install ]; then
  log "Running private install"
  "$HOME/dotfiles/private/install" || log "Failed to run private install. Continue installation."
fi

# Base CLI packages from apt. Everything Go-based comes from `go install` below ───────────────────────────────────────
log "Installing base packages"
if [ "$RU_MIRROR" == 1 ]; then
  log "Pinning apt repos to mirror.yandex.ru"
  sudo sed -i -E 's|https?://([a-z]{2}\.)?archive\.ubuntu\.com/|https://mirror.yandex.ru/|' \
    /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list 2>/dev/null
fi
sudo apt update -y
pkg build-essential git wget zip unzip curl file procps zsh tmux gnupg2 htop ugrep ripgrep fzf jq clangd \
  golang-go neovim nodejs npm fd-find fastfetch
# Ubuntu ships fd as fdfind; nvim's :find and file picker look for fd
ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"

# Desktop (--desktop): i3, dwm, greetd, GUI apps ────────────────────────────────────────────────────────────────
if [ "$DESKTOP" == 1 ]; then
  # The desktop base, explicit so it holds on Ubuntu Server as on a debloated desktop: iwd for Wi-Fi, Bluetooth,
  # sound, fingerprint, power profiles (bin/wm-fnkeys), firmware updates, the portal for
  # file dialogs, the keyring Chrome keeps passwords in, fonts, printing. Installed by hand, so debloat's
  # autoremove keeps them when the desktop metapackages go
  log "Installing the desktop base"
  pkg iwd bluez rfkill \
    pipewire-audio pipewire-alsa pipewire-pulse wireplumber alsa-utils alsa-ucm-conf firmware-sof-signed \
    fprintd libpam-fprintd power-profiles-daemon thermald switcheroo-control iio-sensor-proxy bolt upower \
    udisks2 fwupd systemd-oomd accountsservice polkitd xdg-desktop-portal-gtk xdg-utils xdg-user-dirs \
    gnome-keyring libpam-gnome-keyring fonts-noto-color-emoji fonts-noto-cjk cups
  # Network: iwd for Wi-Fi with its own DHCP (impala is its TUI), systemd-networkd for the wire through
  # netplan, DNS through systemd-resolved. No NetworkManager: the one VPN wanted is VLESS, which NM cannot do
  sudo install -D -m 644 /dev/stdin /etc/iwd/main.conf <<'EOT'
# install: iwd configures the address itself, DNS goes to systemd-resolved
[General]
EnableNetworkConfiguration=true

[Network]
NameResolvingService=systemd
EOT
  sudo install -m 600 /dev/stdin /etc/netplan/01-wired.yaml <<'EOT'
# install: the wire by systemd-networkd; Wi-Fi is iwd's, outside netplan
network:
  version: 2
  renderer: networkd
  ethernets:
    wired:
      match:
        name: "en*"
      dhcp4: true
      dhcp6: true
      optional: true
EOT
  if systemctl is-active -q NetworkManager; then
    # NM's saved Wi-Fi networks to iwd profiles while NM still runs; iwd names a file after the SSID
    # when it is plain [A-Za-z0-9 _-], else "=" and its hex
    log "Moving the saved Wi-Fi networks from NetworkManager to iwd"
    nmcli -t -f NAME,TYPE connection show | while IFS=: read -r name type; do
      [ "$type" == 802-11-wireless ] || continue
      IFS=$'\n' read -r -d '' ssid keymgmt psk < <(sudo nmcli -s -g 802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk connection show "$name"; printf '\0') || true
      file=$ssid
      [[ $ssid =~ ^[A-Za-z0-9\ _-]+$ ]] || file="=$(printf %s "$ssid" | od -An -tx1 | tr -d ' \n')"
      case "$keymgmt" in
        wpa-psk|sae) printf '[Security]\nPassphrase=%s\n' "$psk" | sudo install -D -m 600 /dev/stdin "/var/lib/iwd/$file.psk" ;;
        "")          sudo install -D -m 600 /dev/null "/var/lib/iwd/$file.open" ;;
        *)           log "  $ssid: $keymgmt is not moved, add it in impala" ;;
      esac
    done
    # the switch itself at the next boot: done now, it would cut the network under this very script
    sudo rm -f /etc/netplan/01-network-manager-all.yaml /etc/netplan/90-NM-*.yaml
    sudo systemctl disable NetworkManager NetworkManager-wait-online wpa_supplicant 2>/dev/null || true
    log "Wi-Fi moves to iwd at the next boot"
  fi
  sudo systemctl enable iwd systemd-networkd

  # Wi-Fi and Bluetooth TUIs (impala, bluetui), one author, static builds; not in the archive
  for t in impala:v0.9.0:impala-x86_64-unknown-linux-musl bluetui:v0.8.1:bluetui-x86_64-linux-musl; do
    IFS=: read -r name ver asset <<< "$t"
    if [ "$("$HOME/.local/bin/$name" --version 2>/dev/null | awk '{print "v" $2}')" != "$ver" ]; then
      log "Installing $name $ver"
      curl -fsSL -o "$HOME/.local/bin/$name.new" "https://github.com/pythops/$name/releases/download/$ver/$asset" \
        && chmod +x "$HOME/.local/bin/$name.new" && mv "$HOME/.local/bin/$name.new" "$HOME/.local/bin/$name"
    fi
  done

  # X11 and i3 (config/i3), the base dwm shares: dmenu, dunst (config/dunst), i3lock/xss-lock, maim
  # screenshots, xclip, the media keys (bin/wm-fnkeys), lxpolkit; Xft.dpi for the scale (.Xresources).
  # Started by tuigreet through startx
  log "Installing i3"
  sudo apt install -y --no-install-recommends xserver-xorg-core xserver-xorg-input-libinput xinit \
    x11-xserver-utils xinput i3-wm i3lock xss-lock dunst suckless-tools maim xclip hsetroot \
    brightnessctl playerctl lxpolkit libnotify-bin jq
  link config/i3 $HOME/.config/i3
  link config/dunst $HOME/.config/dunst
  # dark GTK3 and GTK4 (config/gtk-*); GTK keeps bookmarks next to them, so the files are linked, not the dirs
  for g in gtk-3.0 gtk-4.0; do mkdir -p "$HOME/.config/$g" && link "config/$g/settings.ini" "$HOME/.config/$g/settings.ini"; done
  link .Xresources $HOME/.Xresources
  # clicks only by pressing the pad down, no tap: one, two or three fingers for left, right and middle
  # (clickfinger); natural scrolling, a slower pointer, and scrolling at the driver's slowest: 50 px of
  # finger travel per wheel step, against the default 15 (the most xf86-input-libinput accepts)
  sudo install -D -m 644 /dev/stdin /etc/X11/xorg.conf.d/30-touchpad.conf <<'EOT'
# install: the touchpad under i3 and dwm
Section "InputClass"
    Identifier "touchpad"
    MatchIsTouchpad "on"
    Driver "libinput"
    Option "Tapping" "off"
    Option "NaturalScrolling" "true"
    Option "ClickMethod" "clickfinger"
    Option "DisableWhileTyping" "true"
    Option "AccelSpeed" "-0.25"
    Option "ScrollPixelDistance" "50"
EndSection
EOT

  # dwm and st, my own builds (github.com/danilrwx/{dwm,st}, patched, config.def.h as config) into /usr/local.
  # dwm runs as its own session (bin/dwm-session) with the same X11 setup as i3 (bin/x-autostart); its
  # config.def.h binds the media, Fn and menu keys to the bin/ scripts. A rerun pulls and rebuilds
  log "Installing dwm and st"
  pkg libx11-dev libxft-dev libxinerama-dev
  for r in dwm st; do
    if [ -d "$HOME/w/$r/.git" ]; then
      git -C "$HOME/w/$r" pull -q --ff-only || log "Failed to update ~/w/$r. Continue installation."
    else
      mkdir -p "$HOME/w" && git clone -q "https://github.com/danilrwx/$r" "$HOME/w/$r"
    fi
    # make copies config.def.h to config.h only while there is none, so a stale one would win
    rm -f "$HOME/w/$r/config.h"
    make -s -C "$HOME/w/$r" && sudo make -s -C "$HOME/w/$r" install || log "Failed to build $r. Continue installation."
  done
  # st as x-terminal-emulator, for whatever opens "a terminal"; debloat takes the rest
  if [ -x /usr/local/bin/st ]; then
    sudo update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/local/bin/st 60
    sudo update-alternatives --set x-terminal-emulator /usr/local/bin/st
  fi
  sudo install -D -m 644 /dev/stdin /usr/share/xsessions/dwm.desktop <<EOT
[Desktop Entry]
Name=dwm
Comment=dwm with the dotfiles session setup
Exec=$HOME/dotfiles/bin/dwm-session
Type=Application
EOT

  # Login: greetd with tuigreet, offering i3 and dwm (through startx), remembering the pick; GDM goes
  # with GNOME in ./debloat. Takes over the display-manager alias at the next boot, the running session is
  # left alone
  log "Installing greetd"
  pkg greetd tuigreet
  sudo tee /etc/greetd/config.toml > /dev/null <<'EOT'
# install: tuigreet on vt 7 with the i3 and dwm sessions, remembering the last user and session
[terminal]
vt = 7

[default_session]
command = "tuigreet --time --remember --remember-session --asterisks --xsessions /usr/share/xsessions --xsession-wrapper 'startx /usr/bin/env' --cmd 'startx /usr/bin/env i3'"
user = "_greetd"
EOT
  # display-manager.service points at gdm3.service, itself an alias of gdm.service, so disabling gdm3 keeps
  # the link and a plain enable (greetd's postinst too) fails on it quietly; --force replaces it
  if [ "$(readlink -f /etc/systemd/system/display-manager.service)" != /usr/lib/systemd/system/greetd.service ]; then
    sudo systemctl enable --force greetd
    echo /usr/sbin/greetd | sudo tee /etc/X11/default-display-manager > /dev/null
  fi
  # tuigreet draws on the console, so its scale is the console font: Terminus 16x32, twice the 8x16 default
  # as Xft.dpi 192 is for the sessions, on vt 7 as well, which the default ACTIVE_CONSOLES leaves out
  sudo sed -i -e 's|^ACTIVE_CONSOLES=.*|ACTIVE_CONSOLES="/dev/tty[1-7]"|' -e 's|^FONTFACE=.*|FONTFACE="Terminus"|' \
    -e 's|^FONTSIZE=.*|FONTSIZE="16x32"|' /etc/default/console-setup

  log "Installing virtualization"; pkg virt-manager tigervnc-viewer
  # id -nG USER reads the group db, as for docker below
  if ! id -nG "$USER" | grep -qw libvirt; then
    log "Adding user to libvirt group"
    sudo usermod -aG libvirt $USER
  fi

  # Fonts: Iosevka from the archive for st, the bars and the menus; the Nerd Font icons as their own
  # single-width Symbols Nerd Font Mono, which fontconfig falls back to and dwm lists after Iosevka; Apple's
  # emoji. The patched Iosevka Nerd Fonts from before go, their 700 MB zip with them
  log "Installing Iosevka"; pkg fonts-iosevka
  mkdir -p $HOME/.local/share/fonts
  rm -f $HOME/.local/share/fonts/IosevkaNerdFont*.ttf
  if [ ! -f $HOME/.local/share/fonts/SymbolsNerdFontMono-Regular.ttf ]; then
    log "Downloading Symbols Nerd Font Mono"
    font_tmp=$(mktemp -d)
    curl -fsSL -o "$font_tmp/symbols.zip" \
      https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/NerdFontsSymbolsOnly.zip \
      && unzip -o -q "$font_tmp/symbols.zip" 'SymbolsNerdFontMono-Regular.ttf' -d $HOME/.local/share/fonts
    rm -rf "$font_tmp"
    fc-cache -f
  fi
  if [ ! -f $HOME/.local/share/fonts/AppleColorEmoji.ttf ]; then
    log "Downloading Apple Emoji font"
    curl -fsSL -o $HOME/.local/share/fonts/AppleColorEmoji.ttf \
      https://github.com/samuelngs/apple-emoji-linux/releases/download/v18.4/AppleColorEmoji.ttf
    fc-cache -f
  fi

  # ssh: the plain ssh-agent with OpenSSH's GTK3 askpass, so AddKeysToAgent confirm shows a dialog per key
  # use. gcr4's gcr-ssh-agent sits in front of the agent and pre-lists ~/.ssh keys, so ssh never loads the
  # key file itself and the confirm constraint never applies (its gcr4-ssh-askpass has no confirm mode
  # either); mask it and let ssh-agent.socket own SSH_AUTH_SOCK
  log "Setting up ssh-agent with ssh-askpass-gnome"; pkg ssh-askpass-gnome
  mkdir -p "$HOME/.config/systemd/user/ssh-agent.service.d"
  link config/systemd/ssh-agent-askpass.conf "$HOME/.config/systemd/user/ssh-agent.service.d/askpass.conf"
  # the same askpass for ssh clients started without a terminal, for the key passphrase
  mkdir -p "$HOME/.config/environment.d"
  link config/environment.d/ssh-askpass.conf "$HOME/.config/environment.d/ssh-askpass.conf"
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    systemctl --user daemon-reload
    systemctl --user mask --now gcr-ssh-agent.socket gcr-ssh-agent.service
    systemctl --user enable --now ssh-agent.socket
  fi

  # User daemons the session has no use for: filter-chain runs with no filter configured, the at-spi bus
  # serves screen readers. Not the document portal and its permission store: xdg-desktop-portal exits
  # without them, and Chrome, Telegram and the file dialogs wait on it; unmasked for a host an older
  # install masked them on
  link config/environment.d/no-at-bridge.conf "$HOME/.config/environment.d/no-at-bridge.conf"
  link config/environment.d/gdk-scale.conf "$HOME/.config/environment.d/gdk-scale.conf"
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    systemctl --user mask --now filter-chain.service at-spi-dbus-bus.service
    systemctl --user unmask xdg-document-portal.service xdg-permission-store.service
  fi

  # Google Chrome from Google's own .deb, which adds their apt repo and key, so later updates come with
  # apt upgrade. Only amd64, Google ships no Linux arm64 build
  if [ "$(dpkg --print-architecture)" == amd64 ] && ! dpkg -s google-chrome-stable &> /dev/null; then
    log "Installing Google Chrome"
    chrome_deb=$(mktemp --suffix .deb)
    curl -fsSL -o "$chrome_deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
      && sudo apt install -y "$chrome_deb"
    rm -f "$chrome_deb"
  fi
  command -v google-chrome &> /dev/null && xdg-settings set default-web-browser google-chrome.desktop

  # Telegram: the official tarball in ~/.local/opt, which updates itself and writes its own .desktop
  # file on the first start
  if [ ! -x "$HOME/.local/opt/Telegram/Telegram" ]; then
    log "Installing Telegram"
    mkdir -p "$HOME/.local/opt"
    curl -fsSL https://telegram.org/dl/desktop/linux | tar -xJ -C "$HOME/.local/opt" \
      && ln -sf "$HOME/.local/opt/Telegram/Telegram" "$HOME/.local/bin/telegram"
  fi

  # Discord: the official .deb (Ubuntu's AppArmor ships a profile for its sandbox). It does not update
  # itself; a rerun installs the current one when Discord says it is outdated
  discord_url=$(curl -fsS -o /dev/null -w '%{redirect_url}' "https://discord.com/api/download?platform=linux&format=deb")
  if [ -n "$discord_url" ] && [ "$(dpkg-query -W -f='${Version}' discord 2>/dev/null)" != "$(basename "$discord_url" .deb | sed 's/^discord-//')" ]; then
    log "Installing Discord"
    discord_deb=$(mktemp --suffix .deb)
    curl -fsSL -o "$discord_deb" "$discord_url" && sudo apt install -y "$discord_deb"
    rm -f "$discord_deb"
  fi

  # Steam: multiverse's steam-installer, which fetches and updates Valve's client; needs i386 enabled
  log "Installing Steam"
  if ! dpkg --print-foreign-architectures | grep -qx i386; then
    sudo dpkg --add-architecture i386
    sudo apt update -y
  fi
  pkg steam-installer
fi

# kubectl: one static binary from dl.k8s.io ───────────────────────────────────────────────────────────────────────────
if ! command -v kubectl &> /dev/null; then
  log "Installing kubectl"
  arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
  # into a temp file and checked against the published sha256: a failed download must not leave an
  # empty /usr/local/bin/kubectl that `command -v` then takes as installed on every later run
  url="https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${arch}/kubectl"
  tmp=$(mktemp)
  if curl -fsSL -o "$tmp" "$url" && echo "$(curl -fsSL "$url.sha256")  $tmp" | sha256sum -c --quiet; then
    sudo install -m 755 "$tmp" /usr/local/bin/kubectl
  else
    log "kubectl download failed. Continue installation."
  fi
  rm -f "$tmp"
fi

# Go-based CLIs and dev tools into ~/go/bin, newer than the archive's; fetched through
# proxy.golang.org, no GitHub involved ─────────────────────────────────────────────────────
export PATH="$HOME/go/bin:$HOME/.local/bin:$PATH"
if [ "$SKIP_GO" == 1 ]; then
  log "Skipping go tools"
else
  log "Installing go tools"
  for mod in \
    github.com/cli/cli/v2/cmd/gh@latest \
    gitlab.com/gitlab-org/cli/cmd/glab@latest \
    helm.sh/helm/v3/cmd/helm@latest \
    github.com/derailed/k9s@latest \
    github.com/mikefarah/yq/v4@latest \
    github.com/jesseduffield/lazygit@latest \
    github.com/google/go-containerregistry/cmd/crane@latest \
    github.com/go-task/task/v3/cmd/task@latest \
    github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest \
    golang.org/x/tools/gopls@latest \
    golang.org/x/tools/cmd/goimports@latest \
    mvdan.cc/gofumpt@latest \
    github.com/go-delve/delve/cmd/dlv@latest \
    github.com/matryer/moq@latest \
    github.com/onsi/ginkgo/v2/ginkgo@v2.14.0 \
    github.com/mrjosh/helm-ls@latest \
    github.com/nametake/golangci-lint-langserver@latest
  do
    go install "$mod" || log "go install $mod failed. Continue installation."
  done
fi

# Treesitter parsers (.so, per-machine) + queries, without the nvim-treesitter
# plugin. Queries are vendored in the repo; parsers are compiled here.
if [ "$SKIP_TS" == 1 ]; then
  log "Skipping treesitter parsers"
else
  log "Building treesitter parsers"
  nvim --headless -c 'TSBuild' -c 'qa' || log "TSBuild failed. Continue installation."
fi

# zsh completions (sourced from .zshrc)
log "Generating zsh completions"
mkdir -p $HOME/.local/share/completions
fzf --zsh              > $HOME/.local/share/completions/fzf.zsh     2>/dev/null || true
kubectl completion zsh > $HOME/.local/share/completions/kubectl.zsh 2>/dev/null || true

# d8 / deckhouse-cli (official installer; default INSTALL_DIR is /opt not on PATH)
if ! command -v d8 &> /dev/null; then
  log "Installing d8"
  INSTALL_DIR=/usr/local/bin UNATTENDED=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/deckhouse/deckhouse-cli/main/tools/install.sh)"
fi

# claude-code via the native installer (self-updating, no node needed)
if ! command -v claude &> /dev/null; then
  log "Installing claude-code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Use zsh as the login shell ──────────────────────────────────────────────────────────────────────────────────────────
zsh_bin="$(command -v zsh || true)"
# passwd, not $SHELL: $SHELL stays stale until the next login, so chsh would ask on every run
if [ -n "$zsh_bin" ] && [ "$(getent passwd "$USER" | cut -d: -f7)" != "$zsh_bin" ]; then
  grep -qxF "$zsh_bin" /etc/shells || echo "$zsh_bin" | sudo tee -a /etc/shells
  log "Setting zsh as default shell"
  chsh -s "$zsh_bin"
fi

# Docker and the HONOR MagicBook fixes ────────────────────────────────────────
if [ ! -f /usr/bin/docker ]; then
  log "Installing docker"
  curl -fsSL https://get.docker.com | bash
  log "Enabling docker"
  sudo systemctl enable --now docker.socket
fi

# id -nG USER reads the group db; bare `groups` is this process, stale until relogin
if ! id -nG "$USER" | grep -qw docker; then
  log "Adding user to docker group"
  sudo usermod -aG docker $USER
fi

# Caps Lock as Left Ctrl at the evdev level (config/hwdb), so xkb and games reading raw
# scancodes all agree; replaces the old caps:ctrl_modifier xkb option. Rebuilt only on change
hwdb=/etc/udev/hwdb.d/62-caps-as-ctrl.hwdb
if ! cmp -s config/hwdb/62-caps-as-ctrl.hwdb "$hwdb"; then
  log "Installing the Caps as Ctrl hwdb rule"
  sudo install -D -m 644 config/hwdb/62-caps-as-ctrl.hwdb "$hwdb"
  sudo systemd-hwdb update && sudo udevadm trigger --subsystem-match=input --action=change
fi

# HONOR MagicBook Pro 14 2026 (ZQC-P): firmware and driver fixes from the
# fork. apply_patch.sh skips a revision it has already applied, so this is
# cheap on every run; kernel updates are handled by its own hook
HONOR=$HOME/w/honor-magicbook-pro-14-2026-ubuntu
if [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" == "ZQC-P" ]; then
  if [ -d "$HONOR/.git" ]; then
    git -C "$HONOR" pull -q --ff-only || log "Failed to update $HONOR. Continue installation."
  else
    log "Cloning the HONOR MagicBook fixes"
    mkdir -p "$HOME/w"
    git clone -q https://github.com/danilrwx/honor-magicbook-pro-14-2026-ubuntu "$HONOR"
  fi
  # No pipe around it: under sudo's pty a piped apt stops on SIGTTOU.
  # The DSC colour-depth preference is not worth an xe.ko rebuild on every kernel.
  log "Applying the HONOR MagicBook fixes"
  sudo SKIP_DSC=1 "$HONOR/apply_patch.sh" \
    || log "HONOR fixes reported problems, see above. Continue installation."
fi
