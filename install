#!/usr/bin/env bash

log() {
  echo -e "\033[0;31m$1\033[0m"
}

# ./install --desktop: also set up X11 + lightdm + i3 desktop on a bare Debian netinst
DESKTOP=0
[ "${1:-}" == "--desktop" ] && DESKTOP=1

# Some useful functions ─────────────────────────────────────────────────────────────────────────────────────────────────
OS=$(uname -s)
if [ -f /etc/os-release ]; then
  . /etc/os-release

  if [ "$ID" == "debian" ] || [ "$ID" == "ubuntu" ]; then
    log "This is a $ID system."
  else
    log "Unsupported distro: $ID"
    exit 1
  fi
fi

# SSH remote and private submodules (need an ssh key) ─────────────────────────────────────────────────────────────────
if compgen -G "$HOME/.ssh/id_*" | grep -qv '\.pub$'; then
  log "Switching origin to ssh and updating submodules"
  git remote set-url origin git@github.com:danilrwx/dotfiles.git

  if ! git submodule update --init --recursive; then
    log "Failed to update submodules. Continue installation."
  fi
else
  log "No ssh key in ~/.ssh. Skip ssh remote and private submodules."
fi

# Create directories and synlinks to config files ───────────────────────────────────────────────────────────────────────
log "Linking configs"
mkdir -p $HOME/.config
mkdir -p $HOME/.local/share

ln -sf $HOME/dotfiles/.gitconfig $HOME/
ln -sf $HOME/dotfiles/.gitignore_global $HOME/
ln -sf $HOME/dotfiles/.tmux.conf $HOME/.tmux.conf
ln -sf $HOME/dotfiles/.zprofile $HOME/
ln -sf $HOME/dotfiles/.zshrc $HOME/
for c in k9s htop lazygit nvim; do
  ln -snf $HOME/dotfiles/config/$c $HOME/.config/
done
if [[ "$OS" == "Darwin" ]] || [ "$DESKTOP" == 1 ]; then
  for c in kitty alacritty ghostty; do
    ln -snf $HOME/dotfiles/config/$c $HOME/.config/
  done
fi

# Treesitter parsers (.so, per-machine) + queries, without the nvim-treesitter
# plugin. Queries are vendored in the repo; parsers are compiled here.
if command -v cc >/dev/null 2>&1; then
  log "Building treesitter parsers"
  nvim --headless -c 'TSBuild' -c 'qa' || log "TSBuild failed. Continue installation."
fi

# Private CLI configs (claude, pi, CLAUDE.md) are symlinked by private/install,
# which also keeps those paths out of this public repo.
if [ -f $HOME/dotfiles/private/install ]; then
  log "Running private install"
  if ! "$HOME/dotfiles/private/install"; then
    log "Failed to run private install. Continue installation."
  fi
fi

if [ "$DESKTOP" == 1 ]; then
  ln -snf $HOME/dotfiles/config/i3 $HOME/.config/
  ln -snf $HOME/dotfiles/config/dunst $HOME/.config/
  ln -sf $HOME/dotfiles/.Xresources $HOME/
fi

# Install packages for different OSes ───────────────────────────────────────────────────────────────────────────────────
if [[ "$OS" == "Linux" ]]; then
  log "Installing apt packages"
  sudo apt update -y

  sudo apt install -y build-essential git wget zip unzip curl file procps zsh tmux fzf jq gnupg2 pinentry-curses \
	htop lazygit ugrep ripgrep nodejs npm golang-go gh neovim
fi

# Desktop stack for a bare netinst, mirroring the Fedora i3 Spin comps group "i3"
# (lightdm, i3status, nm-applet, mousepad, pavucontrol, volumeicon, firefox) plus
# its base-x / fonts / hardware-support / multimedia environment groups ────────────────────────────────────────────────
if [ "$DESKTOP" == 1 ]; then
  log "Installing desktop packages"
  sudo apt install -y xorg xinit lightdm lightdm-gtk-greeter lightdm-gtk-greeter-settings \
	i3 i3lock i3status suckless-tools dunst xss-lock dex hsetroot xcompmgr maim brightnessctl acpi libnotify-bin \
	x11-xserver-utils xclip xsel bc alacritty \
	network-manager network-manager-gnome \
	pipewire pipewire-pulse wireplumber pulseaudio-utils alsa-utils pavucontrol volumeicon-alsa \
	mousepad firefox-esr feh lxpolkit xdg-utils xdg-user-dirs \
	fonts-dejavu fonts-noto-core fonts-noto-color-emoji firmware-linux \
	virt-manager tigervnc-viewer ssh-askpass pinentry-gnome3
  sudo systemctl enable lightdm NetworkManager
fi


# Install Homebrew (macOS only) ─────────────────────────────────────────────────────────────────────────────────────────
if [[ "$OS" == "Darwin" ]] && [ ! -x /opt/homebrew/bin/brew ]; then
  log "Installing homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"


# Host tooling: launcher + ops CLIs + the Go dev toolchain ──────────────────────────────────────────────────────────────
if [[ "$OS" == "Darwin" ]]; then
  log "Installing host tools from brew"
  brew install go kubectl gh glab tmux fzf jq yq gnupg pinentry-mac watch htop lazygit ugrep node neovim
else
  export PATH="$HOME/go/bin:$PATH"
  arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')

  # CLIs missing from distro repos; all are Go modules except kubectl
  log "Installing yq, lazygit, gh, glab, helm"
  go install github.com/mikefarah/yq/v4@latest
  command -v lazygit &> /dev/null || go install github.com/jesseduffield/lazygit@latest
  command -v gh      &> /dev/null || go install github.com/cli/cli/v2/cmd/gh@latest
  command -v glab    &> /dev/null || go install gitlab.com/gitlab-org/cli/cmd/glab@main
  command -v helm    &> /dev/null || go install helm.sh/helm/v3/cmd/helm@latest

  if ! command -v kubectl &> /dev/null; then
    log "Installing kubectl"
    curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${arch}/kubectl" \
      | sudo tee /usr/local/bin/kubectl > /dev/null
    sudo chmod +x /usr/local/bin/kubectl
  fi

  # distro neovim may be too old for the config
  if ! command -v nvim &> /dev/null; then
    log "Installing neovim from github"
    nvim_arch=$(uname -m | sed 's/aarch64/arm64/')
    curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" \
      | sudo tar -xzf - -C /usr/local --strip-components=1
  fi

  # Telegram: official static build into ~/.local/Telegram
  if [ "$DESKTOP" == 1 ] && [ ! -x "$HOME/.local/Telegram/Telegram" ]; then
    log "Installing Telegram"
    mkdir -p "$HOME/.local/bin"
    curl -fsSL https://telegram.org/dl/desktop/linux | tar -xJf - -C "$HOME/.local"
    ln -sf "$HOME/.local/Telegram/Telegram" "$HOME/.local/bin/telegram-desktop"
  fi
fi

# Go dev tools into ~/go/bin
log "Installing go tools"
go install github.com/onsi/ginkgo/v2/ginkgo@v2.14.0
go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
go install golang.org/x/tools/gopls@latest
go install mvdan.cc/gofumpt@latest
go install golang.org/x/tools/cmd/goimports@latest
go install github.com/go-delve/delve/cmd/dlv@latest
go install github.com/matryer/moq@latest
go install github.com/google/go-containerregistry/cmd/crane@latest
go install github.com/go-task/task/v3/cmd/task@latest

# claude-code via the native installer (self-updating, no node needed)
if ! command -v claude &> /dev/null; then
  log "Installing claude-code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

# d8 / deckhouse-cli (official installer; default INSTALL_DIR is /opt not on PATH)
if ! command -v d8 &> /dev/null; then
  log "Installing d8"
  INSTALL_DIR=/usr/local/bin UNATTENDED=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/deckhouse/deckhouse-cli/main/tools/install.sh)"
fi


# Use zsh as the login shell (macOS already defaults to it; install + chsh on
# Linux) ────────────────────────────────────────────────────────────────────────────────────────────────────────────────
if [[ "$OS" == "Linux" ]]; then
  zsh_bin="$(command -v zsh || true)"
  if [ -n "$zsh_bin" ] && [ "$SHELL" != "$zsh_bin" ]; then
    grep -qw "$zsh_bin" /etc/shells || echo "$zsh_bin" | sudo tee -a /etc/shells
    log "Setting zsh as default shell"
    chsh -s "$zsh_bin"
  fi
fi


# zsh completions (sourced from .zshrc) ────────────────────────────────────────────────────────────────────────────────
log "Generating zsh completions"
mkdir -p $HOME/.local/share/completions
command -v fzf     >/dev/null && fzf --zsh              > $HOME/.local/share/completions/fzf.zsh     2>/dev/null || true
command -v kubectl >/dev/null && kubectl completion zsh > $HOME/.local/share/completions/kubectl.zsh 2>/dev/null || true


# Linux: docker; then (--desktop only) libvirt group and fonts ─────────────────────────────────────────────────────────────────────────────────
if [[ "$OS" == "Linux" ]]; then
  # install docker ──────────────────────────────────────────────────────────────────────────────────────────────────────
  if [ ! -f /usr/bin/docker ]; then
    log "Installing docker"
    curl -fsSL get.docker.com | bash

    log "Starting docker"
    sudo systemctl start docker.socket
    log "Enabling docker"
    sudo systemctl enable docker.socket
  fi

  # add user to docker group ────────────────────────────────────────────────────────────────────────────────────────────
  if ! groups | grep -q '\bdocker\b'; then
    log "Adding user to docker group"
    sudo usermod -aG docker $USER
  fi

  [ "$DESKTOP" == 1 ] || exit 0

  # add user to libvirt group ───────────────────────────────────────────────────────────────────────────────────────────
  if ! groups | grep -q '\blibvirt\b'; then
    log "Adding user to libvirt group"
    sudo usermod -aG libvirt $USER
  fi

  # download Iosevka nerd font ──────────────────────────────────────────────────────────────────────────────────────────
  if [ ! -f $HOME/.local/share/fonts/IosevkaNerdFont-Medium.ttf ]; then
    log "Downloading Iosevka nerd font"
    wget https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/Iosevka.zip
    mkdir -p $HOME/.local/share/fonts
    cd $HOME/.local/share/fonts && unzip $HOME/dotfiles/Iosevka.zip
    rm $HOME/dotfiles/Iosevka.zip
    fc-cache -f
  fi

  # download Apple Emoji font ───────────────────────────────────────────────────────────────────────────────────────────
  if [ ! -f $HOME/.local/share/fonts/AppleColorEmoji.ttf ]; then
    log "Downloading Apple Emoji font"
    wget -P $HOME/.local/share/fonts https://github.com/samuelngs/apple-emoji-linux/releases/download/v18.4/AppleColorEmoji.ttf
    fc-cache -f
  fi
fi
