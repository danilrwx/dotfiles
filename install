#!/bin/sh
# ./install [--desktop] [--configs] [--ru-mirror]
#   --desktop    install the Labwc desktop and Firefox
#   --configs    apply user configs only; add --desktop for desktop configs
#   --ru-mirror  use the Yandex Ubuntu mirror
# Development and gaming are separate: ./install_dev and ./install_game.

DESKTOP=0
CONFIGS=0
RU_MIRROR=0

for arg do
  case $arg in
    --desktop) DESKTOP=1 ;;
    --configs) CONFIGS=1 ;;
    --ru-mirror) RU_MIRROR=1 ;;
    -h|--help) sed -n '2,6s/^# //p' "$0"; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

cd "$HOME/dotfiles" || exit 1

. ./lib/install.sh
# shellcheck source=/dev/null
. /etc/os-release
[ "$ID" = ubuntu ] || { log 'Ubuntu only'; exit 1; }
MIHOMO_VERSION=v1.19.32

if [ "$CONFIGS" = 1 ] && [ "$RU_MIRROR" = 1 ]; then
  log '--configs cannot change apt mirrors'; exit 1
fi

BASE_PKGS="git libcap2-bin openssl wget zip unzip curl file procps bash bash-completion tmux gnupg2 desktop-file-utils
  ugrep fzf jq neovim fd-find
  openssh-server pass vim-gtk3 age python3"

DESKTOP_PKGS="iwd bluez rfkill
  pipewire-audio pipewire-alsa pipewire-pulse wireplumber alsa-utils alsa-ucm-conf firmware-sof-signed
  power-profiles-daemon thermald bolt upower
  udisks2 fwupd systemd-oomd polkitd xdg-desktop-portal-gtk xdg-utils xdg-user-dirs
  intel-media-va-driver-non-free
  gnome-keyring libpam-gnome-keyring fonts-iosevka fonts-terminus-otb fonts-noto-color-emoji fonts-noto-cjk
  gstreamer1.0-libav gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly
  greetd tuigreet ssh-askpass-gnome"

WAYLAND_PKGS="foot labwc swaybg wlr-randr swayidle swaylock wlopm wmenu wl-clipboard grim slurp xdg-desktop-portal-wlr
  dunst libnotify-bin policykit-1-gnome brightnessctl libgtk-3-bin mpv"

base_configs() {
  log "Linking configs"

  for f in .gitconfig .gitignore_global .profile .tmux.conf .bash_profile .bashrc; do
    link "$f" "$HOME/$f" || return
  done
  retire_link .zprofile .zprofile || return
  retire_link .zshrc .zshrc || return
  retire_link .config/MangoHud config/MangoHud || return
  retire_link .config/maki config/maki || return

  retire_link .config/htop config/htop || return
  link config/nvim "$HOME/.config/nvim" || return
  link config/ctags "$HOME/.config/ctags" || return

  if [ -x /usr/bin/fdfind ]; then link /usr/bin/fdfind "$HOME/.local/bin/fd" || return; fi
}

desktop_configs() {
  if [ ! -e "$HOME/.config/dotfiles/theme" ]; then
    link config/themes/dark "$HOME/.config/dotfiles/theme" || return
  fi

  link config/labwc "$HOME/.config/labwc" || return
  link config/foot "$HOME/.config/foot" || return
  link config/xdg-desktop-portal/labwc-portals.conf "$HOME/.config/xdg-desktop-portal/labwc-portals.conf" || return

  for profile in "$HOME"/.config/mozilla/firefox/* "$HOME"/.mozilla/firefox/*; do
    [ -f "$profile/prefs.js" ] || continue
    link config/firefox/user.js "$profile/user.js" || return
    link config/firefox/chrome/userChrome.css "$profile/chrome/userChrome.css" || return
    link config/firefox/chrome/userContent.css "$profile/chrome/userContent.css" || return
  done

  retire_link .config/dunst config/dunst || return
  link config/dunst/dunstrc "$HOME/.config/dunst/dunstrc" || return
  link "$HOME/.config/dotfiles/theme/dunst.conf" "$HOME/.config/dunst/dunstrc.d/theme.conf" || return
  link "$HOME/.config/dotfiles/theme/labwc-themerc" "$HOME/.local/share/themes/Dotfiles/openbox-3/themerc" || return

  for e in config/environment.d/*.conf; do
    link "$e" "$HOME/.config/environment.d/${e##*/}" || return
  done

  for g in gtk-3.0 gtk-4.0; do
    link "$HOME/.config/dotfiles/theme/gtk.css" "$HOME/.config/$g/gtk.css" || return
  done
  link "$HOME/.config/dotfiles/theme/settings.ini" "$HOME/.config/gtk-3.0/settings.ini" || return
  link config/fontconfig/fonts.conf "$HOME/.config/fontconfig/fonts.conf" || return
  link config/systemd/ssh-agent-askpass.conf "$HOME/.config/systemd/user/ssh-agent.service.d/askpass.conf" || return
  link config/systemd/mihomo.service "$HOME/.config/systemd/user/mihomo.service" || return

  for unit in x-battery.service x-battery.timer; do
    link "config/systemd/$unit" "$HOME/.config/systemd/user/$unit" || return
  done

  for a in config/applications/*.desktop; do
    link "$a" "$HOME/.local/share/applications/${a##*/}" || return
  done
}

base() {
  # Update private submodules when an SSH key is available.
  if find "$HOME/.ssh" -maxdepth 1 -type f -name 'id_*' ! -name '*.pub' 2>/dev/null | grep -q .; then
    log "Switching origin to ssh and updating submodules"
    git remote set-url origin git@github.com:danilrwx/dotfiles.git
    # Keep private on its branch instead of resetting it to the recorded commit.
    git submodule update --init --recursive --merge || log "Failed to update submodules. Continue installation."

    if ! git -C private symbolic-ref -q HEAD > /dev/null; then
      git -C private checkout -q master 2>/dev/null || log "private is detached and has no master. Continue installation."
    fi
  else
    log "No ssh key in ~/.ssh. Skip ssh remote and private submodules."
  fi

  base_configs || return

  log "Installing base packages"

  if [ "$RU_MIRROR" = 1 ]; then
    log "Pinning apt repos to mirror.yandex.ru"
    sudo sed -i -E 's|https?://([a-z]{2}\.)?archive\.ubuntu\.com/|https://mirror.yandex.ru/|' \
      /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list 2>/dev/null
  fi

  sudo apt update -y
  sudo apt install -y $BASE_PKGS
  # Ubuntu calls fd fdfind.
  link /usr/bin/fdfind "$HOME/.local/bin/fd"
}

desktop_system() {
  log "Installing the desktop base"
  sudo apt install -y $DESKTOP_PKGS
  sudo apt install -y --no-install-recommends $WAYLAND_PKGS

  # iwd handles Wi-Fi and DHCP; networkd handles Ethernet; resolved handles DNS.
  put /etc/iwd/main.conf
  put /etc/netplan/01-wired.yaml 600

  if systemctl is-active -q NetworkManager; then
    # Copy saved Wi-Fi networks before disabling NetworkManager.
    log "Moving the saved Wi-Fi networks from NetworkManager to iwd"
    nmcli -t -f NAME,TYPE connection show | while IFS=: read -r name type; do
      [ "$type" = 802-11-wireless ] || continue
      saved=$(sudo nmcli -s -g 802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk connection show "$name") || continue
      ssid=$(printf '%s\n' "$saved" | sed -n '1p')
      keymgmt=$(printf '%s\n' "$saved" | sed -n '2p')
      psk=$(printf '%s\n' "$saved" | sed -n '3p')
      file=$ssid

      case $ssid in ''|*[!A-Za-z0-9\ _-]*) file="=$(printf %s "$ssid" | od -An -tx1 | tr -d ' \n')" ;; esac

      case "$keymgmt" in
        wpa-psk|sae) printf '[Security]\nPassphrase=%s\n' "$psk" | sudo install -D -m 600 /dev/stdin "/var/lib/iwd/$file.psk" ;;
        "")          sudo install -D -m 600 /dev/null "/var/lib/iwd/$file.open" ;;
        *)           log "  $ssid: $keymgmt is not moved, add it with bin/wifi or iwctl" ;;
      esac
    done

    # Switch at next boot to keep this connection alive.
    sudo rm -f /etc/netplan/01-network-manager-all.yaml /etc/netplan/90-NM-*.yaml

    sudo systemctl disable NetworkManager NetworkManager-wait-online wpa_supplicant 2>/dev/null || true

    log "Wi-Fi moves to iwd at the next boot"
  fi

  sudo systemctl enable iwd systemd-networkd

  sudo sed -i -e 's/^XKBLAYOUT=.*/XKBLAYOUT="us,ru"/' -e 's/^XKBVARIANT=.*/XKBVARIANT=","/' \
    -e 's/^XKBOPTIONS=.*/XKBOPTIONS="grp:ctrl_space_toggle,grp_led:scroll"/' /etc/default/keyboard

  put /etc/greetd/config.toml
  # Replace GDM's display-manager alias without restarting the current session.
  if [ "$(readlink -f /etc/systemd/system/display-manager.service)" != /usr/lib/systemd/system/greetd.service ]; then
    sudo systemctl enable --force greetd

    echo /usr/sbin/greetd | sudo tee /etc/X11/default-display-manager > /dev/null
  fi

  # Use a readable console font on the HiDPI panel, including greetd on tty7.
  sudo sed -i -e 's|^ACTIVE_CONSOLES=.*|ACTIVE_CONSOLES="/dev/tty[1-7]"|' -e 's|^FONTFACE=.*|FONTFACE="Terminus"|' \
    -e 's|^FONTSIZE=.*|FONTSIZE="16x32"|' /etc/default/console-setup
}

desktop_session() {
  desktop_configs || return
  user_systemctl mask --now foot-server.service foot-server.socket

  if [ "$(cat "$HOME/.config/dotfiles/theme/name")" = light ]; then
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita
    gsettings set org.gnome.desktop.interface color-scheme prefer-light
  else
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  fi
  gsettings set org.gnome.desktop.interface cursor-theme Adwaita
  gsettings set org.gnome.desktop.interface cursor-size 24

  # Use the Mono Nerd Font build so tmux icons occupy one cell.
  font_version=v3.5.1
  font_sha=054a4a369cdcc5d57e9bc91ea56dfefd66c71c253dcb0c0d7b72c0810373da26
  font_dir=$HOME/.local/share/fonts/IosevkaTermNerdFontMono

  if [ ! -f "$font_dir/IosevkaTermNerdFontMono-Regular.ttf" ]; then
    log "Installing the Iosevka Term Nerd Font $font_version"
    font_archive=$(mktemp)

    if fetch "https://github.com/ryanoasis/nerd-fonts/releases/download/$font_version/IosevkaTerm.tar.xz" "$font_archive" "$font_sha"; then
      mkdir -p "$font_dir"

      if tar -xJf "$font_archive" -C "$font_dir" IosevkaTermNerdFontMono-Regular.ttf IosevkaTermNerdFontMono-Bold.ttf IosevkaTermNerdFontMono-Italic.ttf IosevkaTermNerdFontMono-BoldItalic.ttf; then
        fc-cache -f "$HOME/.local/share/fonts" > /dev/null \
          || log "fc-cache failed; the font is installed but the cache is stale"
      else
        log "Failed to install the Iosevka Term Nerd Font. Continue installation."
      fi
    else
      log "Failed to install the Iosevka Term Nerd Font. Continue installation."
    fi

    rm -f "$font_archive"
  fi

  # Use OpenSSH instead of GCR so AddKeysToAgent confirm prompts for each key.
  log "Setting up ssh-agent with ssh-askpass-gnome"
  user_systemctl daemon-reload
  user_systemctl mask --now gcr-ssh-agent.socket gcr-ssh-agent.service
  user_systemctl enable --now ssh-agent.socket

  user_systemctl enable --now x-battery.timer
  user_systemctl start x-battery.service

  user_systemctl mask --now at-spi-dbus-bus.service
}

vless_client() {
  mihomo=$HOME/.local/bin/mihomo
  mihomo_version=$MIHOMO_VERSION
  mihomo_sha=8451100836c9eda194331c2babfad490b2faf30cebc1a04b0e76fd8ac2d35d10
  mihomo_arch=$(dpkg --print-architecture)
  # Only amd64 is pinned; the version is on the first line of mihomo -v.
  if [ "$mihomo_arch" != amd64 ]; then
    log "mihomo: the pinned $mihomo_version release is amd64 only, skipped on $mihomo_arch"
  elif [ "$("$mihomo" -v 2>/dev/null | awk 'NR==1{print $3}')" != "$mihomo_version" ]; then
    log "Installing mihomo $mihomo_version"
    mihomo_archive=$(mktemp)

    if fetch "https://github.com/MetaCubeX/mihomo/releases/download/$mihomo_version/mihomo-linux-amd64-$mihomo_version.gz" "$mihomo_archive" "$mihomo_sha" \
      && gunzip -c "$mihomo_archive" > "$mihomo.new" && chmod +x "$mihomo.new"; then
      mv -f "$mihomo.new" "$mihomo"
    else
      rm -f "$mihomo.new"

      log "mihomo download or checksum failed; the old binary stays. Continue installation."
    fi

    rm -f "$mihomo_archive"
  fi

  getcap "$mihomo" | grep -q cap_net_admin || {
    sudo setcap cap_net_admin,cap_net_bind_service+ep "$mihomo" \
      || log "setcap mihomo failed: TUN mode will not route until the capability is set by hand"
  }

  # Allow mihomo to update resolved DNS for its TUN interface.
  put /etc/polkit-1/rules.d/50-resolved-links.rules
  user_systemctl daemon-reload
}

firefox() {
  mozilla_key=/etc/apt/keyrings/packages.mozilla.org.asc
  mozilla_refresh=0

  if ! gpg --batch --show-keys --with-colons "$mozilla_key" 2>/dev/null \
    | grep -q 'fpr:::::::::35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3:'; then
    mozilla_tmp=$(mktemp) || return

    if curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg -o "$mozilla_tmp" \
      && gpg --batch --show-keys --with-colons "$mozilla_tmp" 2>/dev/null \
        | grep -q 'fpr:::::::::35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3:'; then
      sudo install -D -m 644 "$mozilla_tmp" "$mozilla_key" || { rm -f "$mozilla_tmp"; return 1; }
      mozilla_refresh=1
    else
      log "Mozilla signing key could not be verified; Firefox not installed"
      rm -f "$mozilla_tmp"
      return 1
    fi

    rm -f "$mozilla_tmp"
  fi

  if put /etc/apt/sources.list.d/mozilla.sources; then mozilla_refresh=1; fi

  if put /etc/apt/preferences.d/mozilla-firefox; then mozilla_refresh=1; fi

  if [ "$mozilla_refresh" = 1 ]; then
    sudo apt-get update -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/mozilla.sources \
      -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 || return
  fi

  sudo apt install -y --no-install-recommends firefox
  jq -e . etc/firefox/policies/policies.json >/dev/null || return
  put /etc/firefox/policies/policies.json || true

  for m in text/html application/pdf x-scheme-handler/http x-scheme-handler/https; do
    xdg-mime default firefox.desktop "$m"
  done
}

system() {
  # Read passwd: $SHELL stays stale until the next login.
  bash_bin=$(command -v bash || true)

  if [ -n "$bash_bin" ] && [ "$(getent passwd "$USER" | cut -d: -f7)" != "$bash_bin" ]; then
    grep -qxF "$bash_bin" /etc/shells || echo "$bash_bin" | sudo tee -a /etc/shells

    log "Setting bash as default shell"
    sudo chsh -s "$bash_bin" "$USER"
  fi

  if put /etc/udev/hwdb.d/62-caps-as-ctrl.hwdb; then
    log "Installed the Caps as Ctrl hwdb rule"
    sudo systemd-hwdb update && sudo udevadm trigger --subsystem-match=input --action=change
  fi

  # Hardware fixes for this laptop; the upstream script also handles kernel updates.
  if [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = "ZQC-P" ]; then
    honor_dir=$HOME/w/honor-magicbook-pro-14-2026-ubuntu
    git_sync "$honor_dir" https://github.com/danilrwx/honor-magicbook-pro-14-2026-ubuntu
    # Run directly: piping apt under sudo can stop it with SIGTTOU.
    log "Applying the HONOR MagicBook fixes"
    # Keep the analog jack defaults and use the virtual built-in mic array.
    sudo SKIP_DSC=1 SKIP_HEADSET=1 SKIP_FINGERPRINT=1 "$honor_dir/apply_patch.sh" || log "HONOR fixes reported problems, see above. Continue installation."
  fi
}

reload_configs() {
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    systemctl --user daemon-reload || return
  fi

  if [ -n "${TMUX:-}${WAYLAND_DISPLAY:-}" ] && command -v tmux >/dev/null && tmux has-session 2>/dev/null; then
    tmux source-file "$HOME/.tmux.conf" || return
  fi

  if [ "$DESKTOP" = 1 ] && [ -n "${LABWC_PID:-}" ]; then
    labwc --reconfigure || return
  fi
}

migrate_backups || exit 1

if [ "$CONFIGS" = 1 ]; then
  base_configs || exit 1
  [ "$DESKTOP" != 1 ] || desktop_configs || exit 1
  reload_configs || exit 1
else
  base

  if [ "$DESKTOP" = 1 ]; then
    desktop_system
    desktop_session
    vless_client
    firefox
  fi

  mkdir -p "$HOME/.local/share/completions"
  fzf --bash > "$HOME/.local/share/completions/fzf.bash" 2>/dev/null || true
  system
fi

[ -z "$BACKUP_DIR" ] || log "Backups: $BACKUP_DIR"
