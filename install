#!/usr/bin/env bash

log() {
  echo -e "\033[0;31m$1\033[0m"
}

# ./install [--desktop]
#   --desktop  also set up X11 + lightdm + i3 desktop (bare netinst); an existing
#              display manager is kept
DESKTOP=0
for arg in "$@"; do
  case "$arg" in
    --desktop) DESKTOP=1 ;;
    *) log "Unknown option: $arg"; exit 1 ;;
  esac
done

# Detect OS / package manager ───────────────────────────────────────────────────────────────────────────────────────────
OS=$(uname -s)
PM=brew
if [ -f /etc/os-release ]; then
  . /etc/os-release
  case "$ID" in
    debian|ubuntu) PM=apt ;;
    fedora)        PM=dnf ;;
    *) log "Unsupported distro: $ID"; exit 1 ;;
  esac
  log "This is a $ID system."
fi

pkg() {
  case "$PM" in
    apt)  sudo apt install -y "$@" ;;
    dnf)  sudo dnf install -y "$@" ;;
    brew) brew install "$@" ;;
  esac
}

# SSH remote and private submodules (need an ssh key) ─────────────────────────────────────────────────────────────────
if compgen -G "$HOME/.ssh/id_*" | grep -qv '\.pub$'; then
  log "Switching origin to ssh and updating submodules"
  git remote set-url origin git@github.com:danilrwx/dotfiles.git

  if ! git submodule update --init --recursive; then
    log "Failed to update submodules. Continue installation."
  fi
else
  log "No ssh key in ~/.ssh. Skip ssh remote and private submodules."
fi

# Create directories and synlinks to config files ───────────────────────────────────────────────────────────────────────
log "Linking configs"
mkdir -p $HOME/.config
mkdir -p $HOME/.local/bin $HOME/.local/share

ln -sf $HOME/dotfiles/.gitconfig $HOME/
ln -sf $HOME/dotfiles/.gitignore_global $HOME/
ln -sf $HOME/dotfiles/.tmux.conf $HOME/.tmux.conf
ln -sf $HOME/dotfiles/.zprofile $HOME/
ln -sf $HOME/dotfiles/.zshrc $HOME/
for c in k9s htop lazygit nvim; do
  ln -snf $HOME/dotfiles/config/$c $HOME/.config/
done
if [[ "$OS" == "Darwin" ]] || [ "$DESKTOP" == 1 ]; then
  for c in kitty alacritty ghostty; do
    ln -snf $HOME/dotfiles/config/$c $HOME/.config/
  done
fi
if [ "$DESKTOP" == 1 ]; then
  ln -snf $HOME/dotfiles/config/i3 $HOME/.config/
  ln -snf $HOME/dotfiles/config/dunst $HOME/.config/
  ln -sf $HOME/dotfiles/.Xresources $HOME/
  ln -sf $HOME/dotfiles/.xprofile $HOME/.xprofile
  ln -sf $HOME/dotfiles/.xprofile $HOME/.profile
  ln -sf $HOME/dotfiles/.xprofile $HOME/.xsessionrc
fi

# Private CLI configs (claude, pi, CLAUDE.md) are symlinked by private/install,
# which also keeps those paths out of this public repo.
if [ -f $HOME/dotfiles/private/install ]; then
  log "Running private install"
  "$HOME/dotfiles/private/install" || log "Failed to run private install. Continue installation."
fi

# Base CLI packages from the distro / brew. Everything Go-based comes from
# `go install` below so the versions match across OSes ─────────────────────────────────────────────────────────────────
log "Installing base packages ($PM)"
case "$PM" in
  apt)
    sudo apt update -y
    pkg build-essential git wget zip unzip curl file procps zsh tmux gnupg2 htop ugrep ripgrep fzf jq nodejs npm clangd
    if [ "$ID" == "debian" ]; then
      # stable ships go 1.24; backports track the current minor like Ubuntu/Fedora
      echo "deb http://deb.debian.org/debian ${VERSION_CODENAME}-backports main" \
        | sudo tee /etc/apt/sources.list.d/backports.list > /dev/null
      sudo apt update -y
      pkg -t "${VERSION_CODENAME}-backports" golang-go
    else
      pkg golang-go neovim
    fi
    ;;
  dnf)
    sudo dnf update -y
    pkg gcc gcc-c++ make git wget zip unzip curl file procps-ng zsh tmux gnupg2 htop ugrep ripgrep fzf jq nodejs npm \
      golang clang-tools-extra neovim
    ;;
  brew)
    if [ ! -x /opt/homebrew/bin/brew ]; then
      log "Installing homebrew"
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    eval "$(/opt/homebrew/bin/brew shellenv)"
    # clangd comes with the Xcode CLT
    pkg tmux gnupg pinentry-mac watch htop ugrep ripgrep fzf jq node go kubectl neovim
    ;;
esac

# Desktop stack, mirroring the Fedora i3 Spin comps group "i3" plus its base-x /
# fonts / hardware-support / multimedia environment groups ─────────────────────────────────────────────────────────────
if [ "$DESKTOP" == 1 ]; then
  # a distro that already ships a DE has a display manager enabled; keep it
  if [ -e /etc/systemd/system/display-manager.service ]; then
    log "Display manager already enabled: $(basename "$(readlink /etc/systemd/system/display-manager.service)")"
    DM=""
  else
    DM=lightdm
  fi

  if [ "$PM" == dnf ]; then
    X="xorg-x11-server-Xorg xorg-x11-xinit xsetroot setxkbmap xset xrdb xclip xsel mesa-dri-drivers mesa-vulkan-drivers vulkan-loader vulkan-tools"
    DM_PKGS="lightdm lightdm-gtk lightdm-gtk-greeter-settings"
    I3="i3 i3lock i3status dmenu dunst xss-lock dex-autostart hsetroot xcompmgr maim brightnessctl acpi libnotify bc alacritty"
    NET="NetworkManager network-manager-applet"
    AUDIO="pipewire pipewire-pulseaudio wireplumber pulseaudio-utils alsa-utils pavucontrol volumeicon"
    APPS="mousepad feh lxpolkit xdg-utils xdg-user-dirs"
    FONTS="dejavu-fonts-all google-noto-sans-fonts google-noto-emoji-color-fonts"
    VIRT="virt-manager tigervnc openssh-askpass pinentry-gnome3"
  else
    X="xorg xinit x11-xserver-utils xclip xsel firmware-linux mesa-vulkan-drivers libgl1-mesa-dri libvulkan1 vulkan-tools"
    DM_PKGS="lightdm lightdm-gtk-greeter lightdm-gtk-greeter-settings"
    I3="i3 i3lock i3status suckless-tools dunst xss-lock dex hsetroot xcompmgr maim brightnessctl acpi libnotify-bin bc alacritty"
    NET="network-manager network-manager-gnome"
    AUDIO="pipewire pipewire-pulse wireplumber pulseaudio-utils alsa-utils pavucontrol volumeicon-alsa"
    APPS="mousepad feh lxpolkit xdg-utils xdg-user-dirs"
    FONTS="fonts-dejavu fonts-noto-core fonts-noto-color-emoji"
    VIRT="virt-manager tigervnc-viewer ssh-askpass pinentry-gnome3"
  fi

  log "Installing X11";            pkg $X
  if [ -n "$DM" ]; then log "Installing lightdm"; pkg $DM_PKGS; fi
  log "Installing i3 stack";       pkg $I3
  log "Installing network";        pkg $NET
  log "Installing audio";          pkg $AUDIO
  log "Installing desktop apps";   pkg $APPS
  log "Installing fonts";          pkg $FONTS
  log "Installing virtualization"; pkg $VIRT

  sudo systemctl enable NetworkManager
  if [ -n "$DM" ]; then sudo systemctl enable lightdm; fi

  # inside a VM: guest agents so the display follows the viewer window size
  if systemd-detect-virt -q; then
    log "Installing VM guest agents"
    pkg spice-vdagent qemu-guest-agent
    sudo systemctl enable --now spice-vdagentd qemu-guest-agent
  fi

  # Telegram: official static build into ~/.local/Telegram
  if [ ! -x "$HOME/.local/Telegram/Telegram" ]; then
    log "Installing Telegram"
    curl -fsSL https://telegram.org/dl/desktop/linux | tar -xJf - -C "$HOME/.local"
    ln -sf "$HOME/.local/Telegram/Telegram" "$HOME/.local/bin/telegram-desktop"
  fi

  # Discord: official tar.gz into ~/.local/Discord. It does not self-update:
  # when the client refuses to start, rm -rf ~/.local/Discord and rerun
  if [ ! -x "$HOME/.local/Discord/discord" ]; then
    log "Installing Discord"
    curl -fsSL "https://discord.com/api/download?platform=linux&format=tar.gz" | tar -xzf - -C "$HOME/.local"
    ln -sf "$HOME/.local/Discord/discord" "$HOME/.local/bin/discord"
  fi
  log "Refreshing desktop entries"
  mkdir -p "$HOME/.local/share/applications"
  sed "s|^Exec=.*|Exec=$HOME/.local/Discord/discord|;s|^Icon=.*|Icon=$HOME/.local/Discord/discord.png|" \
    "$HOME/.local/Discord/discord.desktop" > "$HOME/.local/share/applications/discord.desktop"
  update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
  rm -f "$HOME/.cache/dmenu_run"
fi

# kubectl on Linux (not in every distro repo; dl.k8s.io is a Google CDN) ───────────────────────────────────────────────
if [[ "$OS" == "Linux" ]] && ! command -v kubectl &> /dev/null; then
  log "Installing kubectl"
  arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
  curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${arch}/kubectl" \
    | sudo tee /usr/local/bin/kubectl > /dev/null
  sudo chmod +x /usr/local/bin/kubectl
fi

# neovim: the config needs 0.11+ (vim.lsp.config); Debian stable ships 0.10 ──────────────────────────────────────────
nvim_ok() { command -v nvim &> /dev/null && nvim --version | head -1 | grep -qE 'v0\.(1[1-9]|[2-9][0-9])|v[1-9]'; }
if [[ "$OS" == "Linux" ]] && ! nvim_ok; then
  log "Installing neovim from github"
  nvim_arch=$(uname -m | sed 's/aarch64/arm64/')
  curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" \
    | sudo tar -xzf - -C /usr/local --strip-components=1
fi

# Go-based CLIs and dev tools into ~/go/bin: same modules, same versions on
# every OS; fetched through proxy.golang.org, no GitHub involved ─────────────────────────────────────────────────────
export PATH="$HOME/go/bin:$HOME/.local/bin:$PATH"
log "Installing go tools"
for mod in \
  github.com/cli/cli/v2/cmd/gh@latest \
  gitlab.com/gitlab-org/cli/cmd/glab@latest \
  helm.sh/helm/v3/cmd/helm@latest \
  github.com/derailed/k9s@latest \
  github.com/mikefarah/yq/v4@latest \
  github.com/jesseduffield/lazygit@latest \
  github.com/google/go-containerregistry/cmd/crane@latest \
  github.com/go-task/task/v3/cmd/task@latest \
  github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest \
  golang.org/x/tools/gopls@latest \
  golang.org/x/tools/cmd/goimports@latest \
  mvdan.cc/gofumpt@latest \
  github.com/go-delve/delve/cmd/dlv@latest \
  github.com/matryer/moq@latest \
  github.com/onsi/ginkgo/v2/ginkgo@v2.14.0 \
  github.com/mrjosh/helm-ls@latest \
  github.com/nametake/golangci-lint-langserver@latest
do
  go install "$mod" || log "go install $mod failed. Continue installation."
done

# Node-based LSP servers into ~/.local (npm registry, no sudo) ─────────────────────────────────────────────────────────
log "Installing npm tools"
npm config set prefix "$HOME/.local"
npm install -g bash-language-server typescript-language-server typescript

# Treesitter parsers (.so, per-machine) + queries, without the nvim-treesitter
# plugin. Queries are vendored in the repo; parsers are compiled here.
if command -v cc >/dev/null 2>&1; then
  log "Building treesitter parsers"
  nvim --headless -c 'TSBuild' -c 'qa' || log "TSBuild failed. Continue installation."
fi

# zsh completions (sourced from .zshrc)
log "Generating zsh completions"
mkdir -p $HOME/.local/share/completions
fzf --zsh              > $HOME/.local/share/completions/fzf.zsh     2>/dev/null || true
kubectl completion zsh > $HOME/.local/share/completions/kubectl.zsh 2>/dev/null || true

# d8 / deckhouse-cli (official installer; default INSTALL_DIR is /opt not on PATH)
if ! command -v d8 &> /dev/null; then
  log "Installing d8"
  INSTALL_DIR=/usr/local/bin UNATTENDED=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/deckhouse/deckhouse-cli/main/tools/install.sh)"
fi

# claude-code via the native installer (self-updating, no node needed)
if ! command -v claude &> /dev/null; then
  log "Installing claude-code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Use zsh as the login shell (macOS already defaults to it; install + chsh on
# Linux) ────────────────────────────────────────────────────────────────────────────────────────────────────────────────
if [[ "$OS" == "Linux" ]]; then
  zsh_bin="$(command -v zsh || true)"
  if [ -n "$zsh_bin" ] && [ "$SHELL" != "$zsh_bin" ]; then
    grep -qw "$zsh_bin" /etc/shells || echo "$zsh_bin" | sudo tee -a /etc/shells
    log "Setting zsh as default shell"
    chsh -s "$zsh_bin"
  fi
fi

# Linux: docker; then (--desktop only) libvirt group and fonts ─────────────────────────────────────────────────────────
if [[ "$OS" == "Linux" ]]; then
  if [ ! -f /usr/bin/docker ]; then
    log "Installing docker"
    curl -fsSL get.docker.com | bash
    log "Enabling docker"
    sudo systemctl enable --now docker.socket
  fi

  if ! groups | grep -q '\bdocker\b'; then
    log "Adding user to docker group"
    sudo usermod -aG docker $USER
  fi

  [ "$DESKTOP" == 1 ] || exit 0

  if ! groups | grep -q '\blibvirt\b'; then
    log "Adding user to libvirt group"
    sudo usermod -aG libvirt $USER
  fi

  if [ ! -f $HOME/.local/share/fonts/IosevkaNerdFont-Medium.ttf ]; then
    log "Downloading Iosevka nerd font"
    mkdir -p $HOME/.local/share/fonts
    curl -fsSL -o /tmp/Iosevka.zip https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/Iosevka.zip
    unzip -o -q /tmp/Iosevka.zip -d $HOME/.local/share/fonts && rm /tmp/Iosevka.zip
    fc-cache -f
  fi

  if [ ! -f $HOME/.local/share/fonts/AppleColorEmoji.ttf ]; then
    log "Downloading Apple Emoji font"
    curl -fsSL -o $HOME/.local/share/fonts/AppleColorEmoji.ttf \
      https://github.com/samuelngs/apple-emoji-linux/releases/download/v18.4/AppleColorEmoji.ttf
    fc-cache -f
  fi
fi
