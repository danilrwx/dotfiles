#!/usr/bin/env bash
# ./install [--desktop] [--android] [--ru-mirror] [--skip-go] [--skip-ts]
#   --desktop    the session (config/hypr, on Wayland), kitty, wmenu, dunst, hyprlock, greetd, and the GUI
#                apps: Helium, Steam. Then ./debloat strips GNOME and snapd
#   --android    the Android SDK in ~/Android/Sdk (the command-line tools, platform-tools, the emulator, the
#                newest platform and build-tools), the JDK it builds with, the udev rules for the phones by USB,
#                Android Studio in /opt; --check compares these where they are installed, or with this flag
#   --ru-mirror  pin the Ubuntu archive to mirror.yandex.ru
#   --skip-go    keep the Go tools in ~/go/bin as they are, no `go install` (the Go compiler in /usr/local/go
#                is still updated)
#   --skip-ts    keep the built treesitter parsers, no TSBuild
#   --check      what this script declares and the machine does not have: the links, the files under /etc, the
#                packages, the units it masks or enables. Changes nothing, and skips what has no declared state
#                to compare against: the submodules, private's install, the tools from go, apt and the web
#
# Safe to rerun: every step checks before it changes anything. bin/dotfiles-update is this script on PATH.

log() { echo -e "\033[0;31m$1\033[0m"; }

# --check: a line per difference and a count, so the exit code says whether the machine is what this declares.
# `declared` collects the links the run makes, which is what the orphan scan at the end compares $HOME against.
problems=0
problem() { log "check: $*"; problems=$((problems + 1)); }
declared=()

DESKTOP=0; ANDROID=0; RU_MIRROR=0; SKIP_GO=0; SKIP_TS=0; CHECK=0
for arg in "$@"; do
  case "$arg" in
    --desktop)     DESKTOP=1 ;;
    --android)     ANDROID=1 ;;
    --ru-mirror)   RU_MIRROR=1 ;;
    --skip-go)     SKIP_GO=1 ;;
    --skip-ts)     SKIP_TS=1 ;;
    --check)       CHECK=1 ;;
    -h|--help)     sed -n '/^# \.\/install/,/^[^#]/{s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    *) log "Unknown option: $arg"; exit 1 ;;
  esac
done

# --check reports the whole declared state, so it walks the desktop sections whatever flags it was given, and
# skips the tools it cannot compare (see the dispatch at the end)
if [ "$CHECK" == 1 ]; then DESKTOP=1; SKIP_GO=1; SKIP_TS=1;
  # Android is opt-in, so it is compared where it was installed (or where --android was given with --check):
  # a machine that never asked for it is not told it lacks an SDK
  if [ -d "$HOME/Android/Sdk" ] || [ -d /opt/android-studio ]; then ANDROID=1; fi
  # only the differences on stdout: the section headers this script logs along the way would read as if it were
  # installing ("Installing Steam") and bury the report
  log() { case "$1" in check:*) echo -e "\033[0;31m$1\033[0m" ;; esac; }
fi

# the paths below (link, put, the submodules) are the repo's, whatever directory this is started from
cd "$HOME/dotfiles" || { log "No $HOME/dotfiles"; exit 1; }
# shellcheck source=/dev/null
[ -f /etc/os-release ] && . /etc/os-release
[ "${ID:-}" == ubuntu ] || { log "Unsupported system: ${ID:-$(uname -s)}, Ubuntu only"; exit 1; }
log "This is an Ubuntu $VERSION_ID system."

# Fetching ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# What comes from the web: the hash its project publishes is what decides, unpack refuses an archive that would
# write outside the directory it is given, and swap_tree renames the new tree in. Nothing lands until the last step.
# fetch URL FILE HASH: the URL into FILE, its HASH checked — the sha256's hex, or sha1:<hex> where a release
# publishes only that; a `.sha256` file's contents work as they are. No hash, no download: a caller that cannot
# name the file it expects does not get to install it
fetch() {
  local url=$1 file=$2 want=$3 sum alg=sha256sum
  case "$want" in sha1:*) alg=sha1sum; want=${want#sha1:} ;; esac
  want=$(printf '%s' "$want" | tr -d '[:space:]')
  [ -n "$want" ] || { log "$url: no checksum to verify it against, not downloaded"; return 1; }
  curl -fsSL -o "$file" "$url" || { rm -f "$file"; return 1; }
  sum=$("$alg" "$file" | awk '{print $1}')
  [ "$sum" == "$want" ] && return 0
  log "$url: ${alg%sum} is $sum, want $want"
  rm -f "$file"
  return 1
}

# unpack ARCHIVE DIR: the archive's tree into DIR (mktemp -d gives an empty one). A member with an absolute path
# or a .. in it stops it before anything is written: tar.gz, tar.xz and zip, by the name
unpack() {
  local a=$1 dir=$2 bad
  case "$a" in
  *.tar.gz|*.tgz) bad=$(tar -tzf "$a" | grep -E '^/|(^|/)\.\.(/|$)') && { log "$a: $bad"; return 1; }
                  mkdir -p "$dir" && tar -xzf "$a" -C "$dir" ;;
  *.tar.xz)       bad=$(tar -tJf "$a" | grep -E '^/|(^|/)\.\.(/|$)') && { log "$a: $bad"; return 1; }
                  mkdir -p "$dir" && tar -xJf "$a" -C "$dir" ;;
  *.zip)          bad=$(unzip -Z1 "$a" | grep -E '^/|(^|/)\.\.(/|$)') && { log "$a: $bad"; return 1; }
                  unzip -q "$a" -d "$dir" ;;
  *)              log "$a: not a tar.gz, tar.xz or zip"; return 1 ;;
  esac
}

# asroot DIR CMD...: CMD where DIR's parent is the user's (the SDK in ~/Android), with sudo where it is root's
# (/usr/local, /opt)
asroot() {
  local dir=$1; shift
  if [ -w "$(dirname "$dir")" ]; then "$@"; else sudo "$@"; fi
}

# swap_tree NEW DIR: the tree at NEW takes DIR's place in two renames, the old one aside as DIR.old and removed
# only once the new one is in; a failed second rename puts the old one back
swap_tree() {
  local new=$1 dir=$2
  asroot "$dir" rm -rf "$dir.new" || return 1
  asroot "$dir" mv "$new" "$dir.new" || { asroot "$dir" rm -rf "$dir.new"; return 1; }
  if [ -e "$dir" ]; then asroot "$dir" mv "$dir" "$dir.old" || { asroot "$dir" rm -rf "$dir.new"; return 1; }; fi
  if asroot "$dir" mv "$dir.new" "$dir"; then asroot "$dir" rm -rf "$dir.old"; return 0; fi
  if [ -e "$dir.old" ] && asroot "$dir" mv "$dir.old" "$dir"; then log "$dir: the previous tree is back"; fi
  return 1
}

# Packages ────────────────────────────────────────────────────────────────────────────────────────────────────────────
# the CLI set; Go itself and everything Go-based comes from dev_tools (go.dev, then `go install`)
BASE_PKGS=(build-essential git libcap2-bin openssl wget zip unzip curl file procps zsh tmux gnupg2
  htop ugrep ripgrep fzf bat jq clangd neovim nodejs npm fd-find fastfetch
  openssh-server pass vim-gtk3 age)
# the dev tools (not the libraries of a build): compilers and build systems, the linters, the debugger and the
# image/data helpers nvim's clangd/gopls and the repo's shell scripts reach for
DEV_PKGS=(clang clang-format bison flex meson ninja-build valac valgrind bear tokei shellcheck scdoc pkg-config
  gobject-introspection python3-pil systemd-dev glslang-tools git-filter-repo evtest rust-clippy)
# the desktop base, explicit so it holds on Ubuntu Server as on a debloated desktop (installed by hand, so
# debloat's autoremove keeps it): the Intel GPU's video decode and encode (VA-API, iHD), Wi-Fi by iwd,
# Bluetooth, sound, fingerprint, power profiles, firmware updates, the file dialogs' portal, the keyring
# the browser keeps cookies' keys in, fonts, printing; then the login, virtualization, ssh's askpass, the terminal, the
# file manager
DESKTOP_PKGS=(iwd bluez rfkill
  pipewire-audio pipewire-alsa pipewire-pulse wireplumber alsa-utils alsa-ucm-conf firmware-sof-signed
  fprintd libpam-fprintd power-profiles-daemon thermald switcheroo-control iio-sensor-proxy bolt upower
  udisks2 fwupd systemd-oomd accountsservice polkitd xdg-desktop-portal-gtk xdg-utils xdg-user-dirs
  intel-media-va-driver-non-free
  gnome-keyring libpam-gnome-keyring fonts-iosevka fonts-noto-color-emoji fonts-noto-cjk cups
  gstreamer1.0-libav gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly
  greetd tuigreet libvirt-daemon-system libvirt-clients qemu-system-x86 tigervnc-viewer ssh-askpass-gnome thunar
  openvpn openvpn-systemd-resolved)
# the Wayland session, without recommends: Xwayland (Steam, games), the terminal, the launcher, the clipboard,
# screenshots, the lock and the idle, the night light, notifications, the polkit agent, the media keys' tools,
# bin/x-run's gtk-launch, screen sharing's portal
WL_PKGS=(xwayland hyprland xdg-desktop-portal-hyprland x11-xserver-utils kitty wmenu wl-clipboard grim
  slurp hyprlock hypridle wlsunset dunst libnotify-bin hyprpolkitagent brightnessctl playerctl libgtk-3-bin)
DOCKER_PKGS=(docker.io docker-compose-v2 docker-buildx)
# --android, without recommends: the JDK Gradle builds with (Studio runs on the JBR in its own tarball), the
# udev rules that make a phone on USB readable without root (android-sdk-platform-tools-common brings
# android-udev-rules and no adb, the SDK's platform-tools is the one updated), the X and sound libraries Studio
# and the emulator link against (--desktop has them), scrcpy for the phone's screen
ANDROID_PKGS=(openjdk-21-jdk-headless android-sdk-platform-tools-common libxrender1 libxtst6 libxi6
  libpulse0 libglu1-mesa scrcpy)

# Install the pinned RTK release into ~/.local/bin without configuring agent-specific hooks.
install_rtk() {
  local ver=v1.0.1 target asset tmp
  case "$(uname -m)" in
    x86_64|amd64) target=x86_64-unknown-linux-musl ;;
    aarch64|arm64) target=aarch64-unknown-linux-gnu ;;
    *) problem "RTK unsupported on architecture $(uname -m)"; return 1 ;;
  esac
  # the binary is the one this script pinned, and it runs (gain): a truncated download that kept its name
  rtk_ok() {
    "$1" --version 2>/dev/null | awk -v ver="${ver#v}" '$0 == "rtk " ver { found=1 } END { exit !found }' \
      && "$1" gain >/dev/null 2>&1
  }
  rtk_ok "$HOME/.local/bin/rtk" && return
  if [ "$CHECK" == 1 ]; then
    problem "RTK is not $ver or rtk gain verification fails"
    return 0
  fi

  asset="rtk-$target.tar.gz"
  mkdir -p "$HOME/.local/bin"
  tmp=$(mktemp -d)
  log "Installing RTK $ver"
  if fetch "https://github.com/rtk-ai/rtk/releases/download/$ver/checksums.txt" "$tmp/checksums.txt" \
    && fetch "https://github.com/rtk-ai/rtk/releases/download/$ver/$asset" "$tmp/$asset" \
      "$(awk -v asset="$asset" '$2 == asset {print $1}' "$tmp/checksums.txt")" \
    && unpack "$tmp/$asset" "$tmp/x" && [ -x "$tmp/x/rtk" ] \
    && install -m 755 "$tmp/x/rtk" "$HOME/.local/bin/rtk.new" && rtk_ok "$HOME/.local/bin/rtk.new" \
    && mv -f "$HOME/.local/bin/rtk.new" "$HOME/.local/bin/rtk"; then
    log "Installed RTK $ver"
  else
    rm -f "$HOME/.local/bin/rtk.new"
    log "RTK download, checksum or verification failed; installation left unchanged"
  fi
  rm -rf "$tmp"
  return 0
}

install_rtk

# Helpers ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# pkg [APT FLAG] NAME…: apt install; under --check, the names not installed yet. The apps installed from the web
# (deb_from) are out of that report: a URL says nothing about which package it leaves behind
pkg() {
  local flags=()
  while [[ ${1-} == --* ]]; do flags+=("$1"); shift; done
  if [ "$CHECK" == 1 ]; then
    local p
    for p in "$@"; do installed "$p" || problem "package $p is not installed"; done
    return
  fi
  sudo apt install "${flags[@]}" -y "$@"
}
installed() { dpkg-query -W -f='${db:Status-Status}\n' "$1" 2>/dev/null | grep -qx installed; }

# ln under --check: the two links made outside link() (fd, GTK's theme) are compared, not written
ln() {
  if [ "$CHECK" != 1 ]; then command ln "$@"; return; fi
  while [[ ${1-} == -* ]]; do shift; done
  [ "$(readlink -f "${2-}" 2>/dev/null)" == "$(readlink -f "${1-}")" ] || problem "$2 -> $1 differs or is not there"
}

# xdg-mime under --check: it writes ~/.config/mimeapps.list, the only setting this script makes outside a link,
# a file under /etc or a package
xdg-mime() { [ "$CHECK" == 1 ] || command xdg-mime "$@"; }

# xdg-settings too: it writes ~/.config/mimeapps.list as well (the default browser)
xdg-settings() { [ "$CHECK" == 1 ] || command xdg-settings "$@"; }

# gsettings under --check: inert too; the GTK theme and the portal's color-scheme it sets are compared against
# nothing, nothing here reads them back
gsettings() { [ "$CHECK" == 1 ] || command gsettings "$@"; }

# sudo under --check: inert, so the direct calls outside the helpers (apt, sed on /etc, systemctl, the HONOR
# patch script) change nothing. The state they produce is what put, pkg and user_systemctl compare
sudo() { [ "$CHECK" == 1 ] || command sudo "$@"; }

# link SRC DST: DST a symlink to SRC, a path in this repo or an absolute one; a real file or dir in the way is
# moved to DST.bak, else ln would put the link inside that dir
link() {
  local src=$1 dst=$2
  case "$src" in /*) ;; *) src=$HOME/dotfiles/$1 ;; esac
  declared+=("$dst")
  if [ "$CHECK" == 1 ]; then
    if [ ! -L "$dst" ]; then problem "$dst is not a link (want $src)"
    elif [ "$(readlink -f "$dst")" != "$(readlink -f "$src")" ]; then problem "$dst points at $(readlink "$dst") (want $src)"
    elif [ ! -e "$dst" ]; then problem "$dst points at $src, which the repo no longer has"
    fi
    return
  fi
  mkdir -p "$(dirname "$dst")"
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    log "Backing up $dst to $dst.bak"
    rm -rf "$dst.bak" && mv "$dst" "$dst.bak"
  fi
  ln -snf "$src" "$dst"
}

# put DST [MODE]: the repo's etc/… copy of DST installed as root; false when DST already matches
put() {
  local src=etc/${1#/etc/} dst=$1
  if [ "$CHECK" == 1 ]; then
    # a file only root reads cannot be compared here; the line says what to run rather than guess at it
    if cmp -s "$src" "$dst" 2>/dev/null; then :
    elif [ -r "$dst" ]; then problem "$dst differs from $src"
    else problem "$dst is not readable: sudo cmp -s $src $dst"
    fi
    return
  fi
  sudo cmp -s "$src" "$dst" && return 1
  sudo install -D -m "${2:-644}" "$src" "$dst"
}

# expect_line FILE REGEX: under --check, whether a file another package owns holds the line this script's sed puts
# there. No repo copy to compare, the way put has one for the files under etc/; the sed itself is inert under
# --check, sudo being
expect_line() {
  [ "$CHECK" == 1 ] || return 0
  grep -qE "$2" "$1" 2>/dev/null || problem "$1: no line matching $2"
}

# unit_enabled NAME: under --check, whether the system unit is enabled — the state the sudo systemctl enable
# calls make (user_systemctl has the --user ones)
unit_enabled() {
  [ "$CHECK" == 1 ] || return 0
  local state
  state=$(systemctl is-enabled "$1" 2>/dev/null) || state=${state:-unknown}
  [ "$state" == enabled ] || problem "$1 is ${state:-unknown}, want enabled"
}

join_group() {
  # id -nG USER reads the group db; bare `groups` is this process, stale until relogin
  id -nG "$USER" | grep -qw "$1" && return
  log "Adding user to $1 group"
  sudo usermod -aG "$1" "$USER"
}

# git_sync DIR URL: clone, or pull a clone already there; under --check, whether the clone is there at all
git_sync() {
  if [ "$CHECK" == 1 ]; then [ -d "$1/.git" ] || problem "$1 is not cloned"; return; fi
  if [ -d "$1/.git" ]; then
    git -C "$1" pull -q --ff-only || log "Failed to update $1. Continue installation."
  else
    mkdir -p "$(dirname "$1")" && git clone -q "$2" "$1"
  fi
}

# deb_from URL: download a .deb and install it with its dependencies
# deb_from URL [SHA512]: a .deb installed from the web, checked against the base64 SHA-512 if given
deb_from() {
  local deb
  [ "$CHECK" == 1 ] && return
  deb=$(mktemp --suffix .deb)
  curl -fsSL -o "$deb" "$1" &&
    { [ -z "${2:-}" ] || [ "$(openssl dgst -sha512 -binary "$deb" | base64 -w0)" == "$2" ] || { log "$1: checksum mismatch"; false; }; } &&
    sudo apt install -y "$deb"
  rm -f "$deb"
}

# systemctl --user, only with a user session to talk to (not over a bare ssh or sudo -i). Under --check it
# compares the units this script masks or enables: an Ubuntu update unmasks them quietly (gcr-ssh-agent took
# over ssh-agent's socket once this way)
user_systemctl() {
  [ -n "${XDG_RUNTIME_DIR:-}" ] || return
  if [ "$CHECK" == 1 ]; then
    local want u state
    case "$1" in
      mask)   want=masked ;;
      enable) want=enabled ;;
      *) return ;;
    esac
    shift
    for u in "$@"; do
      [ "${u#--}" != "$u" ] && continue
      state=$(systemctl --user is-enabled "$u" 2>/dev/null)   # prints the state and exits non-zero for masked
      [ -n "$state" ] || state=unknown
      [ "$state" == "$want" ] || problem "$u is $state, want $want"
    done
    return
  fi
  systemctl --user "$@"
}

# Base: the repo, the CLI configs and packages ────────────────────────────────────────────────────────────────────────
base() {
  # the ssh remote and the private submodule, with a key to reach them (skipped under --check: pulling and
  # rewriting the remote is not a state to compare against)
  if [ "$CHECK" == 1 ]; then :
  elif compgen -G "$HOME/.ssh/id_*" | grep -qv '\.pub$'; then
    log "Switching origin to ssh and updating submodules"
    git remote set-url origin git@github.com:danilrwx/dotfiles.git
    # --merge, and private back on its master: a plain update checks the submodule out at the commit this
    # repo records, detached, which undoes private's own newer commits (as it once hid an OpenVPN profile)
    git submodule update --init --recursive --merge || log "Failed to update submodules. Continue installation."
    if ! git -C private symbolic-ref -q HEAD > /dev/null; then
      git -C private checkout -q master 2>/dev/null || log "private is detached and has no master. Continue installation."
    fi
  else
    log "No ssh key in ~/.ssh. Skip ssh remote and private submodules."
  fi

  log "Linking configs"
  mkdir -p "$HOME/.local/bin" "$HOME/.local/share"
  for f in .gitconfig .gitignore_global .profile .tmux.conf .zprofile .zshrc; do link "$f" "$HOME/$f"; done
  for c in k9s htop lazygit nvim bat maki MangoHud; do link "config/$c" "$HOME/.config/$c"; done
  # bat's own theme (config/bat/themes) into its cache
  batcat cache --build > /dev/null 2>&1 || true
  # the private CLI configs (claude, pi, CLAUDE.md), kept out of this public repo
  if [ "$CHECK" != 1 ] && [ -f private/install ]; then
    log "Running private install"
    private/install || log "Failed to run private install. Continue installation."
  fi

  log "Installing base packages"
  if [ "$RU_MIRROR" == 1 ]; then
    log "Pinning apt repos to mirror.yandex.ru"
    sudo sed -i -E 's|https?://([a-z]{2}\.)?archive\.ubuntu\.com/|https://mirror.yandex.ru/|' \
      /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list 2>/dev/null
  fi
  sudo apt update -y
  pkg "${BASE_PKGS[@]}"
  pkg "${DEV_PKGS[@]}"
  # Ubuntu ships fd as fdfind; nvim's :find and file picker look for fd
  ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
}

# Desktop, system side: network, input, login ────────────────────────────────────────────────────────────────────
desktop_system() {
  log "Installing the desktop base"
  pkg "${DESKTOP_PKGS[@]}"
  pkg --no-install-recommends "${WL_PKGS[@]}"

  # Network: iwd for Wi-Fi with its own DHCP (bin/wifi drives its iwctl), systemd-networkd for the wire through
  # netplan, DNS by systemd-resolved. No NetworkManager: the one VPN wanted is VLESS, which NM cannot do
  put /etc/iwd/main.conf
  put /etc/netplan/01-wired.yaml 600
  if systemctl is-active -q NetworkManager; then
    # NM's saved Wi-Fi networks to iwd profiles while NM still runs; iwd names a file after the SSID
    # when it is plain [A-Za-z0-9 _-], else "=" and its hex
    log "Moving the saved Wi-Fi networks from NetworkManager to iwd"
    nmcli -t -f NAME,TYPE connection show | while IFS=: read -r name type; do
      [ "$type" == 802-11-wireless ] || continue
      IFS=$'\n' read -r -d '' ssid keymgmt psk < <(sudo nmcli -s -g 802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk connection show "$name"; printf '\0') || true
      file=$ssid
      [[ $ssid =~ ^[A-Za-z0-9\ _-]+$ ]] || file="=$(printf %s "$ssid" | od -An -tx1 | tr -d ' \n')"
      case "$keymgmt" in
        wpa-psk|sae) printf '[Security]\nPassphrase=%s\n' "$psk" | sudo install -D -m 600 /dev/stdin "/var/lib/iwd/$file.psk" ;;
        "")          sudo install -D -m 600 /dev/null "/var/lib/iwd/$file.open" ;;
        *)           log "  $ssid: $keymgmt is not moved, add it with bin/wifi or iwctl" ;;
      esac
    done
    # the switch itself at the next boot: done now, it would cut the network under this very script
    sudo rm -f /etc/netplan/01-network-manager-all.yaml /etc/netplan/90-NM-*.yaml
    sudo systemctl disable NetworkManager NetworkManager-wait-online wpa_supplicant 2>/dev/null || true
    log "Wi-Fi moves to iwd at the next boot"
  fi
  sudo systemctl enable iwd systemd-networkd
  unit_enabled iwd
  unit_enabled systemd-networkd

  # No fingerprint login: pam_fprintd first in common-auth waits up to 10 s for a finger on every sudo,
  # login and unlock. Its PAM profile off, which pam-auth-update keeps off across package updates; fprintd
  # and the sensor's driver (the HONOR fixes install them) stay
  sudo DEBIAN_FRONTEND=noninteractive pam-auth-update --disable fprintd

  # us and ru, Ctrl+Space between them, for the console (tuigreet) and X, as localectl set-x11-keymap writes
  # them; the layout on Scroll Lock's LED (bin/x-status reads it as RU), Caps as Ctrl the hwdb's
  expect_line /etc/default/keyboard '^XKBLAYOUT="us,ru"$'
  sudo sed -i -e 's/^XKBLAYOUT=.*/XKBLAYOUT="us,ru"/' -e 's/^XKBVARIANT=.*/XKBVARIANT=","/' \
    -e 's/^XKBOPTIONS=.*/XKBOPTIONS="grp:ctrl_space_toggle,grp_led:scroll"/' /etc/default/keyboard

  # Bluetooth LE Audio (LC3, music and the mic at once, on headsets that have it): the kernel's ISO sockets, still
  # behind an experimental UUID, and BlueZ's experimental profiles, BAP (PACS, ASCS) among them
  expect_line /etc/bluetooth/main.conf '^KernelExperimental = 6fbaf188'
  sudo sed -i -e 's/^#\?KernelExperimental = .*/KernelExperimental = 6fbaf188-05e0-496a-9885-d6ddfdb4e03e/' \
    -e 's/^#\?Experimental = .*/Experimental = true/' /etc/bluetooth/main.conf

  # Login: greetd with tuigreet, starting Hyprland (etc/greetd/config.toml, its package's entry); the sessions it
  # lists are /usr/share/wayland-sessions (Hyprland's); GDM goes with GNOME in ./debloat. It takes over the
  # display-manager alias at the next boot, the running session is left alone
  put /etc/greetd/config.toml
  unit_enabled greetd
  # the X sessions of the desktops before this one out of tuigreet's list
  sudo rm -f /usr/share/xsessions/i3.desktop /usr/share/xsessions/i3-with-shmlog.desktop \
    /usr/share/xsessions/x-i3.desktop /usr/share/xsessions/bspwm.desktop /usr/share/xsessions/x-bspwm.desktop
  # display-manager.service points at gdm3.service, itself an alias of gdm.service, so disabling gdm3 keeps
  # the link and a plain enable (greetd's postinst too) fails on it quietly; --force replaces it
  if [ "$(readlink -f /etc/systemd/system/display-manager.service)" != /usr/lib/systemd/system/greetd.service ]; then
    sudo systemctl enable --force greetd
    # the display manager Debian's scripts look up, still under /etc/X11 with no X
    echo /usr/sbin/greetd | sudo tee /etc/X11/default-display-manager > /dev/null
  fi
  # tuigreet draws on the console, so its scale is the console font: Terminus 16x32, twice the 8x16
  # default, on vt 7 as well, which the default ACTIVE_CONSOLES leaves out
  expect_line /etc/default/console-setup '^FONTSIZE="16x32"$'
  sudo sed -i -e 's|^ACTIVE_CONSOLES=.*|ACTIVE_CONSOLES="/dev/tty[1-7]"|' -e 's|^FONTFACE=.*|FONTFACE="Terminus"|' \
    -e 's|^FONTSIZE=.*|FONTSIZE="16x32"|' /etc/default/console-setup
}

# Desktop, user side: the session's configs, ssh-agent───────────────────────────────────────────────────────────────────
desktop_session() {
  # Hyprland, the session, and the X resources its Xwayland client merges (Xft.dpi 192, the cursor)
  link config/hypr "$HOME/.config/hypr"
  link config/Xresources "$HOME/.Xresources"
  link config/dunst "$HOME/.config/dunst"
  # Bluetooth headsets kept in A2DP when an app opens a mic, the mic being the built-in array
  link config/wireplumber "$HOME/.config/wireplumber"
  # GTK3's theme is the system's own (Adwaita-dark, a dark theme), so nothing is downloaded here
  # what systemd --user starts gets these (SSH_ASKPASS, NO_AT_BRIDGE), and .profile the session
  for e in config/environment.d/*.conf; do link "$e" "$HOME/.config/environment.d/${e##*/}"; done
  # the theme's named colours, one file for GTK3 and libadwaita (GTK4); and GTK3's settings.ini, what it reads
  # where gsettings does not reach (under Xwayland, with no XSETTINGS daemon serving it)
  for g in gtk-3.0 gtk-4.0; do link config/gtk/gtk.css "$HOME/.config/$g/gtk.css"; done
  link config/gtk/settings.ini "$HOME/.config/gtk-3.0/settings.ini"
  # the GTK theme and the portal's color-scheme: what libadwaita's apps, Helium and the file dialogs take
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  # the system's app entries that are tools, hidden from bin/x-run's list
  for a in config/applications/*.desktop; do link "$a" "$HOME/.local/share/applications/${a##*/}"; done

  # what Iosevka lacks, the emoji above all, from Noto Color Emoji rather than a monochrome fallback
  # (config/fontconfig)
  # the terminal's font: Iosevka Term, Nerd Font patched (config/kitty/theme.conf names it), whose private-use
  # area holds the icons k9s, lazygit, fastfetch and tmux's status draw, which Ubuntu's fonts-iosevka has not.
  # The release carries 72 files and 87 MB; four are installed, the Mono build, so an icon is one cell wide
  local nfver=v3.5.1 nfsum=054a4a369cdcc5d57e9bc91ea56dfefd66c71c253dcb0c0d7b72c0810373da26
  local nfdir=$HOME/.local/share/fonts/IosevkaTermNerdFontMono
  if [ ! -f "$nfdir/IosevkaTermNerdFontMono-Regular.ttf" ]; then
    if [ "$CHECK" == 1 ]; then
      problem "the Iosevka Term Nerd Font is not installed (config/kitty/theme.conf names it)"
    else
      log "Installing the Iosevka Term Nerd Font $nfver"
      local nf
      nf=$(mktemp)
      if fetch "https://github.com/ryanoasis/nerd-fonts/releases/download/$nfver/IosevkaTerm.tar.xz" "$nf" "$nfsum"; then
        mkdir -p "$nfdir"
        if tar -xJf "$nf" -C "$nfdir" IosevkaTermNerdFontMono-{Regular,Bold,Italic,BoldItalic}.ttf; then
          fc-cache -f "$HOME/.local/share/fonts" > /dev/null \
            || log "fc-cache failed; the font is installed but the cache is stale"
        else
          log "Failed to install the Iosevka Term Nerd Font. Continue installation."
        fi
      else
        log "Failed to install the Iosevka Term Nerd Font. Continue installation."
      fi
      rm -f "$nf"
    fi
  fi
  link config/fontconfig/fonts.conf "$HOME/.config/fontconfig/fonts.conf"
  # kitty: the config that no theme changes, and theme.conf, the pastel palette its include names (a new window
  # reads both; a running one rereads them on SIGUSR1)
  link config/kitty/kitty.conf "$HOME/.config/kitty/kitty.conf"
  link config/kitty/theme.conf "$HOME/.config/kitty/theme.conf"
  sudo update-alternatives --set x-terminal-emulator /usr/bin/kitty
  # thunar for folders: Helium's "show in folder", the portal's and the rest's
  xdg-mime default thunar.desktop inode/directory

  # ssh: the plain ssh-agent with OpenSSH's GTK3 askpass, so AddKeysToAgent confirm shows a dialog per key
  # use. gcr4's gcr-ssh-agent sits in front of the agent and pre-lists ~/.ssh keys, so ssh never loads the
  # key file itself and the confirm constraint never applies; mask it, ssh-agent.socket owns SSH_AUTH_SOCK
  log "Setting up ssh-agent with ssh-askpass-gnome"
  link config/systemd/ssh-agent-askpass.conf "$HOME/.config/systemd/user/ssh-agent.service.d/askpass.conf"
  user_systemctl daemon-reload
  user_systemctl mask --now gcr-ssh-agent.socket gcr-ssh-agent.service
  user_systemctl enable --now ssh-agent.socket
  # user daemons the session has no use for: filter-chain runs with no filter configured, the at-spi bus
  # serves screen readers (not the portals: xdg-desktop-portal exits without them)
  user_systemctl mask --now filter-chain.service at-spi-dbus-bus.service

}

# Desktop apps ────────────────────────────────────────────────────────────────────────────────────────────────────────
# The vendors the session runs, each leaving the machine as it was when it fails: the VLESS client and the OpenVPN
# profiles behind bin/vpn-*, the browser, the games.
desktop_apps() {
  vless_client
  openvpn_profiles
  join_group libvirt   # virsh and the VMs (DESKTOP_PKGS has libvirt/qemu, not the virt-manager GUI)
  firefox
  helium
  helium_profile
  brave
  steam
}

# Firefox from Mozilla's own repo, not the archive's: Ubuntu's `firefox` is a snap installer, and ./debloat pins
# snapd out (etc/apt/preferences.d/no-snapd.pref), so the archive would leave a stub that debloat then purges. The
# signing key is taken only with the fingerprint pinned here, and the pin file puts Mozilla's 1000 over Ubuntu's
# 500, so apt upgrade follows Mozilla. Its policies (etc/firefox/policies) carry what the Chromium ones do, and
# the autoExportHTML that bin/firefox-bookmarks reads
firefox() {
  if ! installed firefox; then
    if [ "$CHECK" == 1 ]; then
      problem "firefox is not installed"
    else
      log "Installing Firefox"
      local key
      key=$(curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg)
      if gpg --show-keys --with-colons <<< "$key" 2>/dev/null \
        | grep -qx 'fpr:::::::::35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3:'; then
        printf '%s\n' "$key" | sudo install -D -m 644 /dev/stdin /etc/apt/keyrings/packages.mozilla.org.asc
        put /etc/apt/sources.list.d/mozilla.sources
        put /etc/apt/preferences.d/mozilla-firefox
        sudo apt update && pkg firefox
      else
        log "Mozilla's signing key does not match its pinned fingerprint, Firefox not installed"
      fi
    fi
  fi
  # everything about the browser is in this one file: the prefs, the three extensions, Google. A file that does not
  # parse is ignored whole and without a word (about:policies is where it shows), so a broken one is not installed
  if jq -e . etc/firefox/policies/policies.json > /dev/null; then
    put /etc/firefox/policies/policies.json
  else
    problem "etc/firefox/policies/policies.json is not valid JSON, not installed"
  fi
  command -v firefox &> /dev/null && xdg-settings set default-web-browser firefox.desktop

  # Firefox's own profile list: without it the browser starts a fresh profile and the one already here — cookies,
  # history, bookmarks — is left behind. Written once, Firefox maintains it from then on
  if [ "$CHECK" == 1 ]; then
    [ -f "$HOME/.mozilla/firefox/profiles.ini" ] \
      || problem "no $HOME/.mozilla/firefox/profiles.ini: Firefox would start a fresh profile"
  elif [ ! -f "$HOME/.mozilla/firefox/profiles.ini" ]; then
    mkdir -p "$HOME/.mozilla/firefox"
    printf '%s\n' '[Profile0]' 'Name=dotfiles' 'IsRelative=1' 'Path=dotfiles' 'Default=1' \
      '' '[General]' 'StartWithLastProfile=1' 'Version=2' > "$HOME/.mozilla/firefox/profiles.ini"
  fi
  # the chrome: config/firefox/chrome, the stylesheet the profile reads when
  # toolkit.legacyUserProfileCustomizations.stylesheets (the policy) says it may
  link config/firefox/chrome "$HOME/.mozilla/firefox/dotfiles/chrome"
}

# mihomo, the VLESS client behind bin/vpn-vless: the static build, not in the archive, with the capability its
# TUN mode needs to route the system's traffic, so it runs as a --user service (config/systemd/mihomo.service)
vless_client() {
  local mihomo=$HOME/.local/bin/mihomo ver=v1.19.32 arch
  local sum=8451100836c9eda194331c2babfad490b2faf30cebc1a04b0e76fd8ac2d35d10   # v1.19.32, amd64
  arch=$(dpkg --print-architecture)
  # the release pinned here is the amd64 build: another architecture gets nothing rather than a binary that
  # cannot run (its -v check would fail, and every run would install it again).
  # -v prints a line of its own now ("Use tags: with_gvisor"), so only the first one holds the version
  if [ "$arch" != amd64 ]; then
    log "mihomo: the pinned $ver release is amd64 only, skipped on $arch"
    [ "$CHECK" == 1 ] && problem "mihomo: no $arch build pinned"
  elif [ "$("$mihomo" -v 2>/dev/null | awk 'NR==1{print $3}')" != "$ver" ]; then
    if [ "$CHECK" == 1 ]; then
      problem "mihomo is not $ver"
    else
      log "Installing mihomo $ver"
      local gz
      gz=$(mktemp)
      if fetch "https://github.com/MetaCubeX/mihomo/releases/download/$ver/mihomo-linux-amd64-$ver.gz" "$gz" "$sum" \
        && gunzip -c "$gz" > "$mihomo.new" && chmod +x "$mihomo.new"; then
        mv -f "$mihomo.new" "$mihomo"
      else
        rm -f "$mihomo.new"
        log "mihomo download or checksum failed; the old binary stays. Continue installation."
      fi
      rm -f "$gz"
    fi
  fi
  if [ "$CHECK" == 1 ]; then
    getcap "$mihomo" 2>/dev/null | grep -q cap_net_admin || problem "mihomo lacks cap_net_admin: sudo setcap cap_net_admin,cap_net_bind_service+ep $mihomo"
  else
    getcap "$mihomo" | grep -q cap_net_admin || {
      sudo setcap cap_net_admin,cap_net_bind_service+ep "$mihomo" \
        || log "setcap mihomo failed: TUN mode will not route until the capability is set by hand"
    }
  fi
  # its TUN sets and reverts the Meta link's DNS in systemd-resolved, without a password prompt each time
  put /etc/polkit-1/rules.d/50-resolved-links.rules
  link config/systemd/mihomo.service "$HOME/.config/systemd/user/mihomo.service"
  user_systemctl daemon-reload
}

# OpenVPN (bin/vpn-openvpn): each private/config/openvpn/NAME.ovpn as /etc/openvpn/client/NAME.conf for
# openvpn-client@NAME.service, root's alone (the keys are in it). NAME.auth, the login and the password
# line by line, goes next to it as what auth-user-pass reads, NAME.pass as the key's passphrase for
# askpass; the server's DNS goes to systemd-resolved
# through openvpn-systemd-resolved, for the names behind it. The polkit rule starts and stops the units
# without sudo
openvpn_profiles() {
  put /etc/polkit-1/rules.d/50-openvpn-client.rules
  local ovpn name conf
  for ovpn in private/config/openvpn/*.ovpn; do
    [ -f "$ovpn" ] || continue
    name=$(basename "$ovpn" .ovpn)
    conf=$(mktemp)
    grep -vE '^[[:space:]]*(auth-user-pass|askpass)([[:space:]]|$)' "$ovpn" > "$conf"
    if [ -f "private/config/openvpn/$name.auth" ]; then
      sudo install -D -m 600 "private/config/openvpn/$name.auth" "/etc/openvpn/client/$name.auth"
      echo "auth-user-pass /etc/openvpn/client/$name.auth" >> "$conf"
    fi
    # NAME.pass: the passphrase of an encrypted private key, what askpass reads
    if [ -f "private/config/openvpn/$name.pass" ]; then
      sudo install -D -m 600 "private/config/openvpn/$name.pass" "/etc/openvpn/client/$name.pass"
      echo "askpass /etc/openvpn/client/$name.pass" >> "$conf"
    fi
    cat >> "$conf" <<'EOT'

# install: the server's DNS to systemd-resolved, for the names behind the tunnel
script-security 2
up /etc/openvpn/update-systemd-resolved
up-restart
down /etc/openvpn/update-systemd-resolved
down-pre
EOT
    sudo cmp -s "$conf" "/etc/openvpn/client/$name.conf" \
      || { log "Installing the OpenVPN profile $name"; sudo install -D -m 600 "$conf" "/etc/openvpn/client/$name.conf"; }
    rm -f "$conf"
  done
}

# Helium, ungoogled Chromium with uBlock Origin, from its apt repo, so updates come with apt upgrade: its
# signing key from GitHub, taken only with the fingerprint pinned here; amd64 only. Lolka, an Electron app with
# no apt repo, is the same shape: a .deb from the web, against the hash its manifest names
helium() {
  if [ "$(dpkg --print-architecture)" == amd64 ] && ! installed helium-bin; then
    if [ "$CHECK" == 1 ]; then
      problem "helium-bin is not installed"
    else
      log "Installing Helium"
      local key
      key=$(curl -fsSL https://raw.githubusercontent.com/imputnet/helium-linux/main/pubkey.asc)
      if gpg --show-keys --with-colons <<< "$key" 2>/dev/null \
        | grep -qx 'fpr:::::::::BE677C1989D35EAB2C5F26C9351601AD01D6378E:'; then
        gpg --dearmor <<< "$key" | sudo install -D -m 644 /dev/stdin /usr/share/keyrings/helium.gpg
        echo 'deb [signed-by=/usr/share/keyrings/helium.gpg] https://pkg.helium.computer/deb stable main' \
          | sudo install -m 644 /dev/stdin /etc/apt/sources.list.d/helium.list
        sudo apt update && pkg helium-bin
      else
        log "Helium's signing key does not match its pinned fingerprint, not installed"
      fi
    fi
  fi
  # Helium's policies, Chromium's directory, which it reads (JSON can hold no comment, so these): Memory Saver
  # on, balanced, the tabs out of sight letting go of their memory; and privacy: no saved passwords, autofill,
  # search suggestions or history, WebRTC kept behind the proxy, no prefetching, HTTPS only, no geolocation,
  # no Privacy Sandbox ads, no payment method queries
  put /etc/chromium/policies/managed/dotfiles.json || true
  put /etc/chromium/policies/managed/privacy.json || true

  if [ "$(dpkg --print-architecture)" == amd64 ] && ! installed lolka; then
    log "Installing Lolka"
    local lolka=https://storage.yandexcloud.net/lolka-electron/releases manifest
    manifest=$(curl -fsSL "$lolka/latest-linux.yml") &&
      deb_from "$lolka/$(awk '/^path:/ { print $2 }' <<< "$manifest")" "$(awk '/^sha512:/ { print $2 }' <<< "$manifest")"
  fi

  # the browser's launcher entry, made from the system's on every run, its Exec bin/helium: --force-dark-mode
  # (the theme is dark) and the VA-API encode (iHD) for calls and screen sharing, which Chromium leaves off on
  # Linux and chrome://flags has no switch for. It hides the system entry in ~/.local/share/applications
  local desk=/usr/share/applications/helium.desktop
  [ -f "$desk" ] && sed "s|^Exec=helium|Exec=\"$HOME/dotfiles/bin/helium\"|" "$desk" \
    > "$HOME/.local/share/applications/helium.desktop"

  # Helium's own bookmarks (Ctrl+D) mirrored into private: the path unit exports them when Chromium rewrites the
  # file, so bin/helium-bookmarks and git have the current list; Helium stays the source of truth
  link config/systemd/helium-bookmarks.service "$HOME/.config/systemd/user/helium-bookmarks.service"
  link config/systemd/helium-bookmarks.path "$HOME/.config/systemd/user/helium-bookmarks.path"
  user_systemctl daemon-reload
  user_systemctl enable helium-bookmarks.path
  # the watched file appears at Helium's first run: a missing one would fail the start, so start it then
  [ -f "$HOME/.config/net.imput.helium/Default/Bookmarks" ] && user_systemctl start helium-bookmarks.path
  user_systemctl start helium-bookmarks.service
}

# The files Helium keeps its own state in, edited only while it is not running (it rewrites them on exit): the GPU
# flag, the UI mode its own Appearance beats, and the search engine it keeps twice
helium_profile() {
  # GPU compositing: Chromium's blocklist takes this GPU (Arc B370) for software compositing, and
  # scrolling at 3120x2080 120Hz drops frames on it; the chrome://flags switch that overrides the list,
  # put in Helium's Local State while it is not running (it rewrites the file on exit)
  local state=$HOME/.config/net.imput.helium/"Local State"
  if command -v helium &> /dev/null && ! pgrep -x helium > /dev/null; then
    mkdir -p "$(dirname "$state")"
    [ -s "$state" ] || echo '{}' > "$state"
    jq '.browser.enabled_labs_experiments = ((.browser.enabled_labs_experiments // []) - ["ignore-gpu-blocklist"] + ["ignore-gpu-blocklist"])' \
      "$state" > "$state.new" && mv "$state.new" "$state"
  fi

  # Its own UI takes the GTK theme install names (Adwaita-dark) and follows it; the profile's Appearance > Mode
  # has to be "Device" for that, and for bin/helium's flag to count at all (a stored Light beats both)
  local prefs=$HOME/.config/net.imput.helium/Default/Preferences
  if [ -s "$prefs" ] && ! pgrep -x helium > /dev/null \
    && [ "$(jq -r '.browser.theme.color_scheme2 // 0' "$prefs")" != 0 ]; then
    jq '.browser.theme.color_scheme2 = 0' "$prefs" > "$prefs.new" && mv "$prefs.new" "$prefs"
  fi

  # the search engine is Google, its builtin entry, which the profile keeps twice: a GUID in
  # default_search_provider (the choice) and a copy of the engine itself in default_search_provider_data
  # (what answers a search before the engine list is read). Helium's bangs, the !keywords of Kagi's list
  # (Fiverr, Amazon among them), come back from its services with GUIDs of their own, and a choice left
  # pointing at one of them put that bang back as the engine on every start, over anything picked in the
  # settings; the copy stayed on it too, so a search went to Amazon with Google chosen. Both go to Google,
  # and to the same value, since the two disagreeing reads as a tampered choice and is reset. While it is
  # not running (it rewrites Preferences on exit)
  local google=485bf7d3-0215-45af-87dc-538868000001 guid copy engine='{"short_name":"Google","keyword":"google.com",
    "url":"https://www.google.com/search?q={searchTerms}",
    "suggestions_url":"https://www.google.com/complete/search?client=chrome&q={searchTerms}",
    "favicon_url":"https://www.gstatic.com/images/branding/searchlogo/ico/favicon.ico",
    "synced_guid":"485bf7d3-0215-45af-87dc-538868000001","prepopulate_id":1,
    "safe_for_autoreplace":true,"input_encodings":["UTF-8"],"is_active":1}'
  if [ -s "$prefs" ] && ! pgrep -x helium > /dev/null; then
    read -r guid copy <<< "$(jq -r '[.default_search_provider.guid,
      (.default_search_provider_data.template_url_data.synced_guid // "")] | join(" ")' "$prefs")"
    if [ "$guid" != "$google" ] || [ "$copy" != "$google" ]; then
      jq --arg guid "$google" --argjson engine "$engine" \
        '.default_search_provider_data = {template_url_data: $engine, mirrored_template_url_data: $engine}
         | .default_search_provider.guid = $guid' "$prefs" > "$prefs.new" && mv "$prefs.new" "$prefs"
    fi
  fi
}

# Brave, Chromium with its own Shields: the official apt repo, its signing key taken only with the fingerprints
# pinned here (the archive is signed by two keys, the newer one too), and the policies in etc/brave/policies/managed
# that turn every Brave service off — Rewards, Wallet, VPN, Talk, News, Leo, Playlist, Speedreader, P3A — and set the
# Shields defaults. Not the default browser: Firefox is; this is the plain Chromium to compare against
brave() {
  if ! installed brave-browser; then
    if [ "$CHECK" == 1 ]; then
      problem "brave-browser is not installed"
    else
      log "Installing Brave"
      local key
      key=$(mktemp)
      if curl -fsSL -o "$key" https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg \
        && gpg --show-keys --with-colons "$key" 2>/dev/null | grep -qE \
          'fpr:::::::::(DBF1A116C220B8C7164F98230686B78420038257|47D32A74E9A9E013A4B4926C68D513D36A73CD96):'; then
        sudo install -D -m 644 "$key" /usr/share/keyrings/brave-browser-archive-keyring.gpg
        put /etc/apt/sources.list.d/brave-browser.sources
        sudo apt update && pkg brave-browser
      else
        log "Brave's signing key does not match its pinned fingerprints, not installed"
      fi
      rm -f "$key"
    fi
  fi
  put /etc/brave/policies/managed/dotfiles.json
}

# Steam: multiverse's steam-installer, which fetches and updates Valve's client; needs i386. Skipped when the
# client is already there (the package, or the /usr/games/steam it leaves), since it updates itself
steam() {
  if installed steam-installer || installed steam-launcher || [ -x /usr/games/steam ] || [ -d "$HOME/.steam" ]; then
    [ "$CHECK" == 1 ] || log "Steam is already installed; skipping"
  else
    log "Installing Steam"
    if ! dpkg --print-foreign-architectures | grep -qx i386; then
      sudo dpkg --add-architecture i386
      sudo apt update -y
    fi
    pkg steam-installer
  fi
  # games under gamescope (their own Xwayland at full resolution, where the session's is 2x blurry), MangoHud's overlay in
  # them, gamemode for the scheduler: `gamescope -W 3120 -H 2080 -w 3120 -h 2080 -f --immediate-flips -- mangohud %command%`
  pkg gamescope mangohud gamemode
}

# Android ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# The SDK from Google, not the archive: Ubuntu's gradle (4.4) and kotlin (1.3) are from 2018, and the SDK's own
# packages move faster than any distro. ~/Android/Sdk is where Studio looks for one, so a project needs no
# local.properties. sdkmanager brings the rest (platform-tools, the emulator, the newest platform and build-tools),
# the JDK and the udev rules for the phones by USB come from apt, Studio from the tarball Google's own download
# page links with its sha256. Idempotent: a component already there is left alone, and Studio is replaced only
# when the page's build differs from the one in /opt.
android() {
  # without recommends: scrcpy's is the archive's adb, and the SDK's platform-tools is the one that is updated
  pkg --no-install-recommends "${ANDROID_PKGS[@]}"
  # /dev/kvm for the emulator; the group is there wherever the module is loaded, and the user is added once
  getent group kvm > /dev/null && join_group kvm
  android_sdk
  android_studio
}

# The command-line tools are the one piece taken from Google's repository: repository2-3.xml names the current
# build and its sha1, so no version is pinned in this script, and sdkmanager fetches the rest from the same place.
# They go to cmdline-tools/latest, the layout sdkmanager and Studio expect, not the cmdline-tools/ of the zip.
android_sdk() {
  local sdk=$HOME/Android/Sdk sm=$HOME/Android/Sdk/cmdline-tools/latest/bin/sdkmanager
  if [ "$CHECK" == 1 ]; then
    [ -x "$sdk/platform-tools/adb" ] || problem "$sdk/platform-tools/adb is not there"
    [ -x "$sdk/emulator/emulator" ] || problem "$sdk/emulator/emulator is not there"
    compgen -G "$sdk/platforms/android-*" > /dev/null || problem "$sdk has no platform (platforms/android-N)"
    compgen -G "$sdk/build-tools/*" > /dev/null || problem "$sdk has no build-tools"
    return
  fi

  if [ ! -x "$sm" ]; then
    log "Installing the Android command-line tools"
    local tmp block url sha
    tmp=$(mktemp -d)
    if curl -fsSL -o "$tmp/repository.xml" https://dl.google.com/android/repository/repository2-3.xml; then
      # the entry's first archive is linux: its sha1 and url are the two fields that move with the build
      block=$(sed -n '/<remotePackage path="cmdline-tools;latest">/,/<\/remotePackage>/p' "$tmp/repository.xml")
      sha=$(printf '%s\n' "$block" | sed -n 's|.*<checksum type="sha1">\([0-9a-f]*\)<.*|\1|p' | head -1)
      url=$(printf '%s\n' "$block" | sed -n 's|.*<url>\(commandlinetools-linux-[^<]*\)<.*|\1|p' | head -1)
      if [ -n "$url" ] && [ -n "$sha" ] \
        && fetch "https://dl.google.com/android/repository/$url" "$tmp/$url" "sha1:$sha" \
        && unpack "$tmp/$url" "$tmp/x" && [ -x "$tmp/x/cmdline-tools/bin/sdkmanager" ] \
        && mkdir -p "$sdk/cmdline-tools" && swap_tree "$tmp/x/cmdline-tools" "$sdk/cmdline-tools/latest"; then
        log "Installed the command-line tools from $url"
      else
        log "The command-line tools download/checksum failed; no Android SDK this run. Continue installation."
        rm -rf "$tmp"
        return 1
      fi
    else
      log "dl.google.com is unreachable; no Android SDK this run. Continue installation."
      rm -rf "$tmp"
      return 1
    fi
    rm -rf "$tmp"
  fi

  # the licences first: sdkmanager installs nothing without them, and the one `yes` answers every prompt
  log "Accepting the SDK licences"
  yes | "$sm" --licenses > /dev/null 2>&1 || log "sdkmanager --licenses reported an error. Continue installation."

  # the newest stable platform and build-tools off sdkmanager's own list: the ids are numeric (`37.2`), a preview
  # is not (`37.2-beta2`, `CANARY`), and the space after the number is what tells them apart. The list spells an
  # id with a slash and the old `;` still installs, so both are read. Without a list the two fixed pieces go
  local list api bt want=(platform-tools emulator)
  list=$("$sm" --list 2>/dev/null)
  api=$(printf '%s\n' "$list" \
    | sed -n 's|^ *platforms[/;]android-\([0-9][0-9.]*\)[[:space:]].*|\1|p' | sort -V | tail -1)
  bt=$(printf '%s\n' "$list" \
    | sed -n 's|^ *build-tools[/;]\([0-9][0-9.]*\)[[:space:]].*|\1|p' | sort -V | tail -1)
  [ -n "$api" ] && want+=("platforms/android-$api")
  [ -n "$bt" ] && want+=("build-tools/$bt")
  log "Installing the SDK packages: ${want[*]}"
  "$sm" --install "${want[@]}" || log "sdkmanager failed on ${want[*]}. Continue installation."
}

# Studio, from the linux tarball the download page links and the sha256 in its row. The version is the page's, so
# keeping it current is a rerun of this script rather than a constant edited by hand; a page that cannot be read,
# a checksum that does not match or an archive that does not unpack leaves /opt/android-studio as it was.
# .install-version is this script's stamp; product-info.json is what is read when the stamp is gone
android_studio() {
  local dir=/opt/android-studio url ver sha have tmp
  # the menu entry: a tarball has no installer to make one, and the icon is the one inside the tree
  put /usr/share/applications/android-studio.desktop
  if [ "$CHECK" == 1 ]; then
    [ -x "$dir/bin/studio.sh" ] || problem "Android Studio is not in $dir"
    return
  fi

  tmp=$(mktemp -d)
  if ! curl -fsSL -o "$tmp/page" https://developer.android.com/studio; then
    log "developer.android.com is unreachable; Android Studio left as it is. Continue installation."
    rm -rf "$tmp"
    return 1
  fi
  url=$(tr '\n' ' ' < "$tmp/page" \
    | grep -oE 'https://[^" ]*ide-zips/[^" ]*/android-studio-[a-z0-9]+-linux\.tar\.gz' | head -1)
  ver=$(printf '%s' "$url" | sed -n 's|.*/ide-zips/\([^/]*\)/.*|\1|p')
  # the download table's linux row: the file in a button, its size, its sha256. The `>` before the name keeps the
  # link in the dialog out of it (its window would end before the checksum), and the first 64 hex digits after
  # the button are the sha256
  sha=$(tr '\n' ' ' < "$tmp/page" | grep -oE '>android-studio-[a-z0-9]+-linux\.tar\.gz</button>.{0,200}' \
    | grep -oE '\b[0-9a-f]{64}\b' | head -1)
  have=$(cat "$dir/.install-version" 2>/dev/null)
  [ -n "$have" ] || have=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$dir/product-info.json" 2>/dev/null | head -1)
  if [ -z "$url" ] || [ -z "$ver" ] || [ -z "$sha" ]; then
    log "The download list could not be read off the Studio page; Android Studio left as it is."
    rm -rf "$tmp"
    return 1
  fi
  if [ "$have" == "$ver" ]; then
    rm -rf "$tmp"
    return 0
  fi

  # 1.6 GB: downloaded, unpacked beside the old tree and verified there, then swap_tree renames it in
  log "Installing Android Studio $ver"
  if fetch "$url" "$tmp/studio.tar.gz" "$sha" && unpack "$tmp/studio.tar.gz" "$tmp/x" \
    && [ -x "$tmp/x/android-studio/bin/studio.sh" ] && swap_tree "$tmp/x/android-studio" "$dir"; then
    printf '%s\n' "$ver" | sudo tee "$dir/.install-version" > /dev/null
    log "Installed Android Studio $ver"
  else
    log "Android Studio $ver not installed; $dir left as it was. Continue installation."
  fi
  rm -rf "$tmp"
}

# Go ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# The compiler from go.dev, not the archive: Ubuntu's golang-go trails the releases (1.26 against 1.27), and
# GOTOOLCHAIN=auto only papers over it — it fetches a toolchain into ~/go/pkg/mod on the first module that asks
# for a newer one, while `go version` and GOROOT stay the archive's. The tarball is checked against the sha256
# go.dev publishes in dl/?mode=json, the tree is staged as /usr/local/go.new and swapped in, so a failed run
# leaves the old /usr/local/go as it was. Idempotent: the version in /usr/local/go is compared with the latest
# stable first.
install_go() {
  local arch ver file sha tmp
  case "$(uname -m)" in
    x86_64|amd64)  arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) log "Go: unsupported architecture $(uname -m)"; return 1 ;;
  esac

  tmp=$(mktemp -d)
  if ! curl -fsSL -o "$tmp/json" 'https://go.dev/dl/?mode=json'; then
    log "go.dev is unreachable; /usr/local/go left as it is. Continue installation."
    rm -rf "$tmp"
    return 1
  fi
  ver=$(jq -r '.[0].version' "$tmp/json")
  file=$(jq -r --arg a "$arch" \
    '.[0].files[] | select(.os == "linux" and .arch == $a and .kind == "archive") | .filename' "$tmp/json")
  sha=$(jq -r --arg f "$file" '.[0].files[] | select(.filename == $f) | .sha256' "$tmp/json")
  if [ -z "$ver" ] || [ -z "$file" ] || [ -z "$sha" ]; then
    log "go.dev's release list has no $arch archive; /usr/local/go left as it is. Continue installation."
    rm -rf "$tmp"
    return 1
  fi
  if [ "$(head -1 /usr/local/go/VERSION 2>/dev/null)" == "$ver" ]; then
    rm -rf "$tmp"
    return 0
  fi

  log "Installing Go $ver"
  if ! fetch "https://go.dev/dl/$file" "$tmp/$file" "$sha" \
    || ! unpack "$tmp/$file" "$tmp/x" \
    || [ "$("$tmp/x/go/bin/go" version 2>/dev/null | awk '{print $3}')" != "$ver" ] \
    || ! swap_tree "$tmp/x/go" /usr/local/go; then
    log "Go $ver download, checksum or verification failed; /usr/local/go left as it was. Continue installation."
    rm -rf "$tmp"
    return 1
  fi
  log "Installed Go $ver"
  rm -rf "$tmp"
}

# Dev tools ───────────────────────────────────────────────────────────────────────────────────────────────────────────
dev_tools() {
  # kubectl, one static binary from dl.k8s.io, checked against its sha256: a failed download must not
  # leave an empty /usr/local/bin/kubectl that `command -v` takes as installed on every later run
  if ! command -v kubectl &> /dev/null; then
    log "Installing kubectl"
    local arch url tmp sha
    arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
    url="https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${arch}/kubectl"
    tmp=$(mktemp)
    if ! sha=$(curl -fsSL "$url.sha256"); then
      log "kubectl's .sha256 is unreachable; nothing installed. Continue installation."
    elif fetch "$url" "$tmp" "$sha" && sudo install -m 755 "$tmp" /usr/local/bin/kubectl; then :
    else
      log "kubectl download or checksum failed; nothing installed. Continue installation."
    fi
    rm -f "$tmp"
  fi

  # Go first: the tools below are built with it, and the archive's golang-go goes — two toolchains on the box
  # only invite a stale /usr/bin/go from a PATH this script does not cover
  export PATH="$HOME/go/bin:$HOME/.local/bin:/usr/local/go/bin:$PATH"
  if install_go; then
    local stale=() p
    while read -r p; do stale+=("$p"); done < <(dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'golang*' 2>/dev/null \
      | awk '$1 == "installed" && $2 ~ /^golang(-[0-9][0-9.]*)?-(go|src)$/ {print $2}')
    if [ ${#stale[@]} -gt 0 ]; then
      log "Removing the archive's Go: ${stale[*]}"
      sudo apt purge -y "${stale[@]}"
    fi
  fi

  # Go-based CLIs and dev tools into ~/go/bin, newer than the archive's, through proxy.golang.org
  if [ "$SKIP_GO" == 1 ]; then
    log "Skipping go tools"
  elif ! command -v go > /dev/null; then
    log "No Go compiler; skipping the go tools"
  else
    log "Installing go tools"
    local mod
    for mod in \
      github.com/cli/cli/v2/cmd/gh@latest \
      gitlab.com/gitlab-org/cli/cmd/glab@latest \
      helm.sh/helm/v3/cmd/helm@latest \
      github.com/derailed/k9s@latest \
      github.com/mikefarah/yq/v4@latest \
      github.com/jesseduffield/lazygit@latest \
      github.com/google/go-containerregistry/cmd/crane@latest \
      github.com/go-task/task/v3/cmd/task@latest \
      github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest \
      golang.org/x/tools/gopls@latest \
      golang.org/x/tools/cmd/goimports@latest \
      mvdan.cc/gofumpt@latest \
      github.com/go-delve/delve/cmd/dlv@latest \
      github.com/matryer/moq@latest \
      github.com/onsi/ginkgo/v2/ginkgo@v2.14.0 \
      github.com/mrjosh/helm-ls@latest \
      github.com/nametake/golangci-lint-langserver@latest \
      github.com/getsops/sops/v3/cmd/sops@latest
    do
      go install "$mod" || log "go install $mod failed. Continue installation."
    done
  fi

  # treesitter parsers (.so, per machine) for the queries vendored in config/nvim, without the plugin
  if [ "$SKIP_TS" == 1 ]; then
    log "Skipping treesitter parsers"
  else
    log "Building treesitter parsers"
    nvim --headless -c 'TSBuild' -c 'qa' || log "TSBuild failed. Continue installation."
  fi

  log "Generating zsh completions"   # sourced by .zshrc
  mkdir -p "$HOME/.local/share/completions"
  fzf --zsh              > "$HOME/.local/share/completions/fzf.zsh"     2>/dev/null || true
  kubectl completion zsh > "$HOME/.local/share/completions/kubectl.zsh" 2>/dev/null || true
  # vpnctl is built locally, so its completion is regenerated only where the binary is
  command -v vpnctl &> /dev/null &&
    vpnctl completion zsh > "$HOME/.local/share/completions/vpnctl.zsh" 2>/dev/null || true

  # d8 (deckhouse-cli) by its own installer; d8's default INSTALL_DIR, /opt, is off PATH
  if ! command -v d8 &> /dev/null; then
    log "Installing d8"
    INSTALL_DIR=/usr/local/bin UNATTENDED=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/deckhouse/deckhouse-cli/main/tools/install.sh)"
  fi
}
# System: login shell, Docker, Caps as Ctrl, the HONOR fixes ──────────────────────────────────────────────────────────
system() {
  # zsh as the login shell; passwd, not $SHELL, which stays stale until the next login
  local zsh_bin
  zsh_bin=$(command -v zsh || true)
  if [ -n "$zsh_bin" ] && [ "$(getent passwd "$USER" | cut -d: -f7)" != "$zsh_bin" ]; then
    grep -qxF "$zsh_bin" /etc/shells || echo "$zsh_bin" | sudo tee -a /etc/shells
    log "Setting zsh as default shell"
    chsh -s "$zsh_bin"
  fi

  # Docker from the Ubuntu archive, updated with the rest by apt; a host with Docker Inc's docker-ce from
  # an older install moves over in ./debloat
  if installed docker-ce; then
    log "Docker Inc's docker-ce is installed: ./debloat moves it to the archive's docker.io"
  elif ! installed docker.io; then
    log "Installing docker"
    pkg "${DOCKER_PKGS[@]}"
    sudo systemctl enable --now docker.socket
  fi
  join_group docker

  # Caps Lock as Left Ctrl at the evdev level, so xkb and games reading raw scancodes all agree
  if put /etc/udev/hwdb.d/62-caps-as-ctrl.hwdb; then
    log "Installed the Caps as Ctrl hwdb rule"
    sudo systemd-hwdb update && sudo udevadm trigger --subsystem-match=input --action=change
  fi

  # HONOR MagicBook Pro 14 2026 (ZQC-P): firmware and driver fixes from my fork. apply_patch.sh skips a
  # revision it has applied, so this is cheap on every run; kernel updates are handled by its own hook
  if [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" == "ZQC-P" ]; then
    local honor=$HOME/w/honor-magicbook-pro-14-2026-ubuntu
    git_sync "$honor" https://github.com/danilrwx/honor-magicbook-pro-14-2026-ubuntu
    # no pipe around it: under sudo's pty a piped apt stops on SIGTTOU. The DSC colour-depth preference
    # is not worth an xe.ko rebuild on every kernel
    log "Applying the HONOR MagicBook fixes"
    sudo SKIP_DSC=1 "$honor/apply_patch.sh" || log "HONOR fixes reported problems, see above. Continue installation."
  fi
}

base
if [ "$DESKTOP" == 1 ]; then
  desktop_system
  desktop_session
  desktop_apps
fi
# Android is a flag of its own: the SDK and Studio have nothing to do with the desktop
[ "$ANDROID" == 1 ] && android
if [ "$CHECK" == 1 ]; then
  # links in $HOME into the repo that this run does not declare: a leftover of a config the repo dropped (a
  # stale ~/.config/sway, which the repo dropped) or one made by hand. private's install links its own,
  # out of this script's declarations
  while read -r l; do
    case "$(readlink "$l")" in
      "$HOME/dotfiles/private/"*) continue ;;
    esac
    case " ${declared[*]} " in *" $l "*) continue ;; esac
    if [ ! -e "$l" ]; then problem "orphan link $l -> $(readlink "$l"), the repo has no such path"
    else problem "undeclared link $l -> $(readlink "$l"), nothing here makes it"
    fi
  done < <(find "$HOME" -maxdepth 4 -type l -lname "$HOME/dotfiles/*" 2>/dev/null | grep -v "^$HOME/dotfiles/")
  log "check: $problems differ"
  exit $(( problems > 0 ))
fi
dev_tools
system
