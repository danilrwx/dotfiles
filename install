#!/usr/bin/env bash

log() {
  echo -e "\033[0;31m$1\033[0m"
}

# ./install [--desktop] [--ru-mirror]
#   --desktop    GUI apps: Chrome, virt-manager, Telegram, Discord, Steam
#   --ru-mirror  pin the Ubuntu archive to mirror.yandex.ru
DESKTOP=0; RU_MIRROR=0
for arg in "$@"; do
  case "$arg" in
    --desktop)   DESKTOP=1 ;;
    --ru-mirror) RU_MIRROR=1 ;;
    -h|--help)   sed -n '/^# \.\/install/,/^[^#]/{s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    *) log "Unknown option: $arg"; exit 1 ;;
  esac
done

# Everything below (git remote/submodules, `link`, config/hwdb) is relative to the repo, and
# bin/dotfiles-update is this script on PATH, so it may be started from any directory
cd "$HOME/dotfiles" || { log "No $HOME/dotfiles"; exit 1; }

# Ubuntu only ─────────────────────────────────────────────────────────────────────────────────────────────────────────
[ -f /etc/os-release ] && . /etc/os-release
[ "${ID:-}" == ubuntu ] || { log "Unsupported system: ${ID:-$(uname -s)}, Ubuntu only"; exit 1; }
log "This is an Ubuntu $VERSION_ID system."

pkg() { sudo apt install -y "$@"; }

# SSH remote and private submodules (need an ssh key) ─────────────────────────────────────────────────────────────────
if compgen -G "$HOME/.ssh/id_*" | grep -qv '\.pub$'; then
  log "Switching origin to ssh and updating submodules"
  git remote set-url origin git@github.com:danilrwx/dotfiles.git

  if ! git submodule update --init --recursive; then
    log "Failed to update submodules. Continue installation."
  fi
else
  log "No ssh key in ~/.ssh. Skip ssh remote and private submodules."
fi

# Symlink configs. A real file/dir already at the target is moved aside,
# otherwise ln would put the link inside that dir ──────────────────────────────────────────────────────────────────────
link() {
  local src=$HOME/dotfiles/$1 dst=$2
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    log "Backing up $dst to $dst.bak"
    rm -rf "$dst.bak" && mv "$dst" "$dst.bak"
  fi
  ln -snf "$src" "$dst"
}

log "Linking configs"
mkdir -p $HOME/.config
mkdir -p $HOME/.local/bin $HOME/.local/share

for f in .gitconfig .gitignore_global .tmux.conf .zprofile .zshrc; do
  link $f $HOME/$f
done
for c in k9s htop lazygit nvim; do
  link config/$c $HOME/.config/$c
done
link config/ghostty $HOME/.config/ghostty
link config/xkb $HOME/.config/xkb
# Private CLI configs (claude, pi, CLAUDE.md) are symlinked by private/install,
# which also keeps those paths out of this public repo.
if [ -f $HOME/dotfiles/private/install ]; then
  log "Running private install"
  "$HOME/dotfiles/private/install" || log "Failed to run private install. Continue installation."
fi

# Base CLI packages from apt. Everything Go-based comes from `go install` below ───────────────────────────────────────
log "Installing base packages"
if [ "$RU_MIRROR" == 1 ]; then
  log "Pinning apt repos to mirror.yandex.ru"
  sudo sed -i -E 's|https?://([a-z]{2}\.)?archive\.ubuntu\.com/|https://mirror.yandex.ru/|' \
    /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list 2>/dev/null
fi
sudo apt update -y
pkg build-essential git wget zip unzip curl file procps zsh tmux gnupg2 htop ugrep ripgrep fzf jq clangd \
  golang-go neovim nodejs npm fd-find fastfetch
# Ubuntu ships fd as fdfind; nvim's :find and file picker look for fd
ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"

# GUI apps for any desktop (--desktop) ─────────────────────────────────────────────────────────────────────────────────
if [ "$DESKTOP" == 1 ]; then
  log "Installing virtualization"; pkg virt-manager tigervnc-viewer
  # id -nG USER reads the group db, as for docker below
  if ! id -nG "$USER" | grep -qw libvirt; then
    log "Adding user to libvirt group"
    sudo usermod -aG libvirt $USER
  fi

  # Terminal: Ghostty from universe instead of Ubuntu's Ptyxis, for a config file (config/ghostty) instead of
  # dconf profiles. Ptyxis stays installed: purging it drags ubuntu-desktop-minimal along. xdg-terminal-exec
  # (Ctrl+Alt+T, nautilus "Open in Terminal") picks the first entry of xdg-terminals.list
  log "Installing ghostty"; pkg ghostty
  echo com.mitchellh.ghostty.desktop > $HOME/.config/xdg-terminals.list
  # the ghostty package does not register itself as x-terminal-emulator, so add it first
  sudo update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/bin/ghostty 50
  sudo update-alternatives --set x-terminal-emulator /usr/bin/ghostty

  # Fonts for ghostty
  if [ ! -f $HOME/.local/share/fonts/IosevkaNerdFont-Medium.ttf ]; then
    log "Downloading Iosevka nerd font"
    mkdir -p $HOME/.local/share/fonts
    # only IosevkaNerdFont-* ("Iosevka NF" in ghostty); the zip also carries the Mono and Propo
    # families, 700 MB nothing uses
    font_tmp=$(mktemp -d)
    curl -fsSL -o "$font_tmp/Iosevka.zip" https://github.com/ryanoasis/nerd-fonts/releases/download/v3.3.0/Iosevka.zip \
      && unzip -o -q "$font_tmp/Iosevka.zip" 'IosevkaNerdFont-*' -d $HOME/.local/share/fonts
    rm -rf "$font_tmp"
    fc-cache -f
  fi

  if [ ! -f $HOME/.local/share/fonts/AppleColorEmoji.ttf ]; then
    log "Downloading Apple Emoji font"
    curl -fsSL -o $HOME/.local/share/fonts/AppleColorEmoji.ttf \
      https://github.com/samuelngs/apple-emoji-linux/releases/download/v18.4/AppleColorEmoji.ttf
    fc-cache -f
  fi

  # tmux (copy-command) and nvim copy through wl-copy
  log "Installing wl-clipboard"; pkg wl-clipboard

  # Look: stock upstream GNOME instead of Ubuntu's. The `ubuntu` session mode hardwires the Yaru
  # theme and its extensions (dock, desktop icons, tiling assistant), so the way out is the vanilla
  # "GNOME" session from gnome-session (pick it once in the GDM gear, GDM remembers it). It runs the
  # shell in the `user` mode: stock Adwaita, extensions from gsettings. Icons, the legacy GTK theme
  # and the Adwaita fonts follow in the gsettings block. The alternative is GDM's own theme.
  log "Installing the GNOME session"; pkg gnome-session
  sudo update-alternatives --set gdm-theme.gresource /usr/share/gnome-shell/gnome-shell-theme.gresource

  # ssh: the plain ssh-agent with an askpass on the GNOME Shell system prompt (bin/askpass on gcr 4), so
  # AddKeysToAgent confirm shows a modal dialog per key use. GNOME's gcr-ssh-agent sits in front of the agent
  # and pre-lists ~/.ssh keys, so ssh never loads the key file itself and the confirm constraint never applies
  # (its gcr4-ssh-askpass has no confirm mode either); mask it and let ssh-agent.socket own SSH_AUTH_SOCK
  log "Setting up ssh-agent with the GNOME Shell askpass"; pkg python3-gi gir1.2-gcr-4
  mkdir -p "$HOME/.config/systemd/user/ssh-agent.service.d"
  link config/systemd/ssh-agent-askpass.conf "$HOME/.config/systemd/user/ssh-agent.service.d/askpass.conf"
  # the same askpass for ssh clients started without a terminal, for the key passphrase
  mkdir -p "$HOME/.config/environment.d"
  link config/environment.d/ssh-askpass.conf "$HOME/.config/environment.d/ssh-askpass.conf"
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    systemctl --user daemon-reload
    systemctl --user mask --now gcr-ssh-agent.socket gcr-ssh-agent.service
    systemctl --user enable --now ssh-agent.socket
  fi

  # Google Chrome from Google's own .deb, which adds their apt repo and key, so later updates come with
  # apt upgrade. Chrome rather than the Chromium snap: snap confinement keeps native messaging hosts (the
  # Claude in Chrome extension) out. Only amd64, Google ships no Linux arm64 build
  if [ "$(dpkg --print-architecture)" == amd64 ] && ! dpkg -s google-chrome-stable &> /dev/null; then
    log "Installing Google Chrome"
    chrome_deb=$(mktemp --suffix .deb)
    curl -fsSL -o "$chrome_deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
      && sudo apt install -y "$chrome_deb"
    rm -f "$chrome_deb"
  fi
  command -v google-chrome &> /dev/null && xdg-settings set default-web-browser google-chrome.desktop

  # Telegram and Discord from snap. Their official tarballs update themselves
  # too, but Discord's Chromium sandbox needs an AppArmor profile on Ubuntu;
  # snapd covers the sandbox and the updates for both
  log "Installing Telegram and Discord"
  sudo snap install telegram-desktop discord

  # Steam: multiverse's steam-installer, which fetches and updates Valve's client; needs i386 enabled
  log "Installing Steam"
  if ! dpkg --print-foreign-architectures | grep -qx i386; then
    sudo dpkg --add-architecture i386
    sudo apt update -y
  fi
  pkg steam-installer
fi

# GNOME session settings: only from a running desktop session, gsettings needs dconf on the bus ────────────────────
if command -v gsettings &> /dev/null && [ -n "${WAYLAND_DISPLAY:-$DISPLAY}" ]; then
  log "Applying GNOME settings"
  gsettings set org.gnome.desktop.peripherals.touchpad click-method fingers
  # screenshots without PrtSc, as in the old i3 config: Super+Shift+S opens the screenshot UI (area by
  # default, into the clipboard and ~/Pictures/Screenshots); Print stays GNOME's own
  gsettings set org.gnome.shell.keybindings show-screenshot-ui "['Print', '<Super><Shift>s']"
  # mic mute on Super+Shift+M, as in i3 (GNOME leaves it unbound)
  gsettings set org.gnome.settings-daemon.plugins.media-keys mic-mute "['<Super><Shift>m']"
  # us + ru, with the Latin letter under Ctrl on ru (config/xkb, read by mutter from ~/.config/xkb), so
  # Ctrl+C and friends work in GTK4, the shell and ghostty on the Russian layout. The option lays over
  # group 2, hence the fixed order. X11 apps under Xwayland do not see it, xkbcomp reads no user dir
  gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'ru')]"
  gsettings set org.gnome.desktop.input-sources xkb-options "['grp_led:scroll', 'ructrl:latin']"
  if [ "$DESKTOP" == 1 ]; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
    gsettings set org.gnome.desktop.interface icon-theme Adwaita
    gsettings set org.gnome.desktop.interface font-name 'Adwaita Sans 11'
    gsettings set org.gnome.desktop.interface document-font-name 'Adwaita Sans 11'
    # the tray for Telegram and Discord; appended, so extensions enabled by hand survive a rerun
    exts=$(gsettings get org.gnome.shell enabled-extensions)
    case "$exts" in
      *ubuntu-appindicators@ubuntu.com*) ;;
      "@as []"|"[]") gsettings set org.gnome.shell enabled-extensions "['ubuntu-appindicators@ubuntu.com']" ;;
      *) gsettings set org.gnome.shell enabled-extensions "${exts%]}, 'ubuntu-appindicators@ubuntu.com']" ;;
    esac
  fi
fi

# kubectl: one static binary from dl.k8s.io ───────────────────────────────────────────────────────────────────────────
if ! command -v kubectl &> /dev/null; then
  log "Installing kubectl"
  arch=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
  # into a temp file and checked against the published sha256: a failed download must not leave an
  # empty /usr/local/bin/kubectl that `command -v` then takes as installed on every later run
  url="https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${arch}/kubectl"
  tmp=$(mktemp)
  if curl -fsSL -o "$tmp" "$url" && echo "$(curl -fsSL "$url.sha256")  $tmp" | sha256sum -c --quiet; then
    sudo install -m 755 "$tmp" /usr/local/bin/kubectl
  else
    log "kubectl download failed. Continue installation."
  fi
  rm -f "$tmp"
fi

# Go-based CLIs and dev tools into ~/go/bin, newer than the archive's; fetched through
# proxy.golang.org, no GitHub involved ─────────────────────────────────────────────────────
export PATH="$HOME/go/bin:$HOME/.local/bin:$PATH"
log "Installing go tools"
for mod in \
  github.com/cli/cli/v2/cmd/gh@latest \
  gitlab.com/gitlab-org/cli/cmd/glab@latest \
  helm.sh/helm/v3/cmd/helm@latest \
  github.com/derailed/k9s@latest \
  github.com/mikefarah/yq/v4@latest \
  github.com/jesseduffield/lazygit@latest \
  github.com/google/go-containerregistry/cmd/crane@latest \
  github.com/go-task/task/v3/cmd/task@latest \
  github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest \
  golang.org/x/tools/gopls@latest \
  golang.org/x/tools/cmd/goimports@latest \
  mvdan.cc/gofumpt@latest \
  github.com/go-delve/delve/cmd/dlv@latest \
  github.com/matryer/moq@latest \
  github.com/onsi/ginkgo/v2/ginkgo@v2.14.0 \
  github.com/mrjosh/helm-ls@latest \
  github.com/nametake/golangci-lint-langserver@latest
do
  go install "$mod" || log "go install $mod failed. Continue installation."
done

# Treesitter parsers (.so, per-machine) + queries, without the nvim-treesitter
# plugin. Queries are vendored in the repo; parsers are compiled here.
log "Building treesitter parsers"
nvim --headless -c 'TSBuild' -c 'qa' || log "TSBuild failed. Continue installation."

# zsh completions (sourced from .zshrc)
log "Generating zsh completions"
mkdir -p $HOME/.local/share/completions
fzf --zsh              > $HOME/.local/share/completions/fzf.zsh     2>/dev/null || true
kubectl completion zsh > $HOME/.local/share/completions/kubectl.zsh 2>/dev/null || true

# d8 / deckhouse-cli (official installer; default INSTALL_DIR is /opt not on PATH)
if ! command -v d8 &> /dev/null; then
  log "Installing d8"
  INSTALL_DIR=/usr/local/bin UNATTENDED=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/deckhouse/deckhouse-cli/main/tools/install.sh)"
fi

# claude-code via the native installer (self-updating, no node needed)
if ! command -v claude &> /dev/null; then
  log "Installing claude-code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Use zsh as the login shell ──────────────────────────────────────────────────────────────────────────────────────────
zsh_bin="$(command -v zsh || true)"
# passwd, not $SHELL: $SHELL stays stale until the next login, so chsh would ask on every run
if [ -n "$zsh_bin" ] && [ "$(getent passwd "$USER" | cut -d: -f7)" != "$zsh_bin" ]; then
  grep -qxF "$zsh_bin" /etc/shells || echo "$zsh_bin" | sudo tee -a /etc/shells
  log "Setting zsh as default shell"
  chsh -s "$zsh_bin"
fi

# Docker and the HONOR MagicBook fixes ────────────────────────────────────────
if [ ! -f /usr/bin/docker ]; then
  log "Installing docker"
  curl -fsSL https://get.docker.com | bash
  log "Enabling docker"
  sudo systemctl enable --now docker.socket
fi

# id -nG USER reads the group db; bare `groups` is this process, stale until relogin
if ! id -nG "$USER" | grep -qw docker; then
  log "Adding user to docker group"
  sudo usermod -aG docker $USER
fi

# Caps Lock as Left Ctrl at the evdev level (config/hwdb), so xkb, GNOME and games reading raw
# scancodes all agree; replaces the old caps:ctrl_modifier xkb option. Rebuilt only on change
hwdb=/etc/udev/hwdb.d/62-caps-as-ctrl.hwdb
if ! cmp -s config/hwdb/62-caps-as-ctrl.hwdb "$hwdb"; then
  log "Installing the Caps as Ctrl hwdb rule"
  sudo install -D -m 644 config/hwdb/62-caps-as-ctrl.hwdb "$hwdb"
  sudo systemd-hwdb update && sudo udevadm trigger --subsystem-match=input --action=change
fi

# HONOR MagicBook Pro 14 2026 (ZQC-P): firmware and driver fixes from the
# fork. apply_patch.sh skips a revision it has already applied, so this is
# cheap on every run; kernel updates are handled by its own hook
HONOR=$HOME/w/honor-magicbook-pro-14-2026-ubuntu
if [ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" == "ZQC-P" ]; then
  if [ -d "$HONOR/.git" ]; then
    git -C "$HONOR" pull -q --ff-only || log "Failed to update $HONOR. Continue installation."
  else
    log "Cloning the HONOR MagicBook fixes"
    mkdir -p "$HOME/w"
    git clone -q https://github.com/danilrwx/honor-magicbook-pro-14-2026-ubuntu "$HONOR"
  fi
  # No pipe around it: under sudo's pty a piped apt stops on SIGTTOU.
  # The DSC colour-depth preference is not worth an xe.ko rebuild on every kernel.
  log "Applying the HONOR MagicBook fixes"
  sudo SKIP_DSC=1 "$HONOR/apply_patch.sh" \
    || log "HONOR fixes reported problems, see above. Continue installation."

  # Touchpad scroll speed: GNOME has no setting for it. wayland-scroll-factor scales libinput's
  # continuous scroll inside gnome-shell (an LD_PRELOAD in environment.d that loads only there and
  # drops itself from child processes); the mouse wheel stays as is. Pinned release, checked
  # against its SHA256SUMS. Takes effect at the next login; tune with `wsf set` or wsf-gui
  WSF_VERSION=1.0.0
  if ! dpkg -s wayland-scroll-factor &> /dev/null; then
    log "Installing wayland-scroll-factor $WSF_VERSION"
    wsf_url=https://github.com/daniel-g-carrasco/wayland-scroll-factor/releases/download/v$WSF_VERSION
    wsf_deb=wayland-scroll-factor_${WSF_VERSION}-1_amd64.deb
    wsf_tmp=$(mktemp -d)
    if curl -fsSL -o "$wsf_tmp/$wsf_deb" "$wsf_url/$wsf_deb" \
      && curl -fsSL -o "$wsf_tmp/SHA256SUMS" "$wsf_url/SHA256SUMS" \
      && (cd "$wsf_tmp" && grep "  $wsf_deb\$" SHA256SUMS | sha256sum -c --quiet); then
      sudo apt install -y "$wsf_tmp/$wsf_deb"
    else
      log "wayland-scroll-factor download failed. Continue installation."
    fi
    rm -rf "$wsf_tmp"
  fi
  if command -v wsf &> /dev/null; then
    # upstream's suggested factor on first install only, a later `wsf set` is kept
    [ -f "$HOME/.config/wayland-scroll-factor/config" ] || wsf set 0.35
    wsf enable
  fi
fi
